diff --git a/src/SpraysNavigator.cpp b/src/SpraysNavigator.cpp
new file mode 100644
index 0000000..ce7b5f3
--- /dev/null
+++ b/src/SpraysNavigator.cpp
@@ -0,0 +1,220 @@
+#include "../include/SpraysNavigator.h"
+#include "../include/SpraySpots.h"
+#include "../include/UIComponents.h"
+#include "../include/imgui-1.92.7/imgui.h"
+
+#include <algorithm>
+#include <cmath>
+#include <cstdio>
+#include <utility>
+
+namespace keybinder {
+
+void SpraysNavigator::Initialize(GpsManager* gps, Notice notice, PositionProvider position, SessionProvider session) {
+    Shutdown();
+    gps_ = gps;
+    notice_ = std::move(notice);
+    positionProvider_ = std::move(position);
+    sessionProvider_ = std::move(session);
+}
+
+void SpraysNavigator::Shutdown() {
+    StopOwnedRoute();
+    open_ = false;
+    resetScroll_ = false;
+    page_ = 0;
+    rows_.clear();
+    session_.clear();
+    gps_ = nullptr;
+    notice_ = {};
+    positionProvider_ = {};
+    sessionProvider_ = {};
+}
+
+void SpraysNavigator::Say(const std::string& text) const {
+    if (notice_) notice_("{33CCFF}[NL-BINDER]{FFFFFF} " + text);
+}
+
+bool SpraysNavigator::OwnsActiveRoute() const {
+    const auto* destination = gps_ ? gps_->ActiveDestination() : nullptr;
+    return ownedDestinationId_ != 0 && destination && destination->id == ownedDestinationId_;
+}
+
+void SpraysNavigator::StopOwnedRoute() {
+    if (OwnsActiveRoute()) gps_->StopNavigation();
+    ownedDestinationId_ = 0;
+}
+
+bool SpraysNavigator::EnsureAccess(bool notify) {
+    const std::string current = sessionProvider_ ? sessionProvider_() : std::string{};
+    if (current.empty() || (!session_.empty() && current != session_)) {
+        Close();
+        StopOwnedRoute();
+        rows_.clear();
+        page_ = 0;
+    }
+    session_ = current;
+    if (current.empty()) {
+        if (notify) Say("Du bist kein Polizist.");
+        return false;
+    }
+    return true;
+}
+
+bool SpraysNavigator::ReadPosition(GpsPosition& position) const {
+    return positionProvider_ && positionProvider_(position) && GpsManager::IsValidPosition(position);
+}
+
+std::vector<SprayDistance> SpraysNavigator::BuildRows(const GpsPosition& position) {
+    if (!GpsManager::IsValidPosition(position) || position.interior != 0) return {};
+    std::vector<SprayDistance> rows;
+    rows.reserve(kSpraySpots.size());
+    for (const auto& point : kSpraySpots) {
+        const double dx = static_cast<double>(position.x) - point.position.x;
+        const double dy = static_cast<double>(position.y) - point.position.y;
+        const double dz = static_cast<double>(position.z) - point.position.z;
+        rows.push_back({point.id, point.place, static_cast<float>(std::sqrt(dx * dx + dy * dy + dz * dz))});
+    }
+    std::sort(rows.begin(), rows.end(), [](const auto& left, const auto& right) {
+        return left.distance == right.distance ? left.id < right.id : left.distance < right.distance;
+    });
+    return rows;
+}
+
+bool SpraysNavigator::Open() {
+    if (!EnsureAccess(true)) return false;
+    GpsPosition position;
+    if (!gps_ || !ReadPosition(position)) {
+        Close();
+        rows_.clear();
+        Say("Deine aktuelle Spielposition ist noch nicht verf\xC3\xBC" "gbar.");
+        return false;
+    }
+    if (position.interior != 0) {
+        Close();
+        rows_.clear();
+        Say("Spray-Navigation ist nur au\xC3\x9F" "erhalb von Innenr\xC3\xA4" "umen verf\xC3\xBC" "gbar.");
+        return false;
+    }
+    rows_ = BuildRows(position);
+    page_ = 0;
+    resetScroll_ = true;
+    open_ = true;
+    return true;
+}
+
+bool SpraysNavigator::Toggle() {
+    if (open_) { Close(); return true; }
+    return Open();
+}
+
+std::size_t SpraysNavigator::PageCount() const {
+    return (rows_.size() + kRowsPerPage - 1) / kRowsPerPage;
+}
+
+void SpraysNavigator::SetPage(std::size_t page) {
+    const auto count = PageCount();
+    const auto next = count ? (std::min)(page, count - 1) : 0;
+    if (next != page_) resetScroll_ = true;
+    page_ = next;
+}
+
+void SpraysNavigator::Update() {
+    if (!EnsureAccess(false)) return;
+    if (ownedDestinationId_ && !OwnsActiveRoute()) ownedDestinationId_ = 0;
+    if (!open_) return;
+    GpsPosition position;
+    const bool available = ReadPosition(position);
+    if (available && position.interior != 0) Close();
+    rows_ = available ? BuildRows(position) : std::vector<SprayDistance>{};
+    SetPage(page_);
+}
+
+bool SpraysNavigator::Select(unsigned int id) {
+    if (!EnsureAccess(true) || !open_ || !gps_) return false;
+    const auto found = std::find_if(kSpraySpots.begin(), kSpraySpots.end(), [id](const auto& point) {
+        return point.id == id;
+    });
+    if (found == kSpraySpots.end()) return false;
+    GpsPosition current;
+    if (!ReadPosition(current)) {
+        Say("Deine aktuelle Spielposition ist noch nicht verf\xC3\xBC" "gbar.");
+        return false;
+    }
+    if (current.interior != 0) {
+        Close();
+        Say("Spray-Navigation ist nur au\xC3\x9F" "erhalb von Innenr\xC3\xA4" "umen verf\xC3\xBC" "gbar.");
+        return false;
+    }
+    char name[96];
+    std::snprintf(name, sizeof(name), "Graffiti %03u - %s", found->id, found->place);
+    const unsigned int destinationId = GpsManager::kTemporaryIdMask | found->id;
+    if (!gps_->NavigateTemporary({destinationId, name, found->position})) return false;
+    ownedDestinationId_ = destinationId;
+    Close();
+    return true;
+}
+
+void SpraysNavigator::Render() {
+    Update();
+    if (!open_) return;
+    const auto display = ImGui::GetIO().DisplaySize;
+    const float width = (std::max)(260.0f, (std::min)(680.0f, display.x - 40.0f));
+    const float height = (std::max)(280.0f, (std::min)(790.0f, display.y - 60.0f));
+    ImGui::SetNextWindowSize(ImVec2(width, height), ImGuiCond_FirstUseEver);
+    ImGui::SetNextWindowSizeConstraints(ImVec2((std::min)(400.0f, width), (std::min)(340.0f, height)), ImVec2(width, height));
+    if (ImGui::Begin("Graffiti-Navigation##NLBinderSprays", &open_, ImGuiWindowFlags_NoCollapse)) {
+        UIComponents::CardHeader("SAPD / LSPD - Graffitipunkte", "Punkt anklicken, um die Navigation zu starten");
+        ImGui::TextColored(ImVec4(0.35f, 0.9f, 0.45f, 1.0f), "Gr\xC3\xBC" "n: n\xC3\xA4" "chster Punkt");
+        ImGui::SameLine();
+        ImGui::TextDisabled("| Entfernung in Metern (Luftlinie)");
+        if (rows_.empty()) ImGui::TextWrapped("Deine aktuelle Position im Freien ist noch nicht verf\xC3\xBC" "gbar.");
+        const auto begin = page_ * kRowsPerPage;
+        const auto end = (std::min)(begin + kRowsPerPage, rows_.size());
+        if (ImGui::BeginTable("##spray-points", 3, ImGuiTableFlags_RowBg | ImGuiTableFlags_BordersInnerH
+            | ImGuiTableFlags_ScrollY, ImVec2(0.0f, (std::max)(100.0f, ImGui::GetContentRegionAvail().y - 72.0f)))) {
+            ImGui::TableSetupColumn("Nr.", ImGuiTableColumnFlags_WidthFixed, 45.0f);
+            ImGui::TableSetupColumn("Stadtteil / Ort", ImGuiTableColumnFlags_WidthStretch);
+            ImGui::TableSetupColumn("Entfernung", ImGuiTableColumnFlags_WidthFixed, 95.0f);
+            ImGui::TableSetupScrollFreeze(0, 1);
+            ImGui::TableHeadersRow();
+            if (resetScroll_) {
+                ImGui::SetScrollY(0.0f);
+                resetScroll_ = false;
+            }
+            for (std::size_t index = begin; index < end; ++index) {
+                const auto& row = rows_[index];
+                const bool nearest = index == 0;
+                ImGui::PushID(static_cast<int>(row.id));
+                if (nearest) ImGui::PushStyleColor(ImGuiCol_Text, ImVec4(0.35f, 0.9f, 0.45f, 1.0f));
+                ImGui::TableNextRow();
+                ImGui::TableSetColumnIndex(0);
+                char id[8];
+                std::snprintf(id, sizeof(id), "%03u", row.id);
+                const bool chosen = ImGui::Selectable(id, false, ImGuiSelectableFlags_SpanAllColumns);
+                ImGui::TableSetColumnIndex(1);
+                ImGui::TextUnformatted(row.place);
+                ImGui::TableSetColumnIndex(2);
+                ImGui::Text("%.0f m", row.distance);
+                if (nearest) ImGui::PopStyleColor();
+                ImGui::PopID();
+                if (chosen) { Select(row.id); break; }
+            }
+            ImGui::EndTable();
+        }
+        if (UIComponents::SecondaryButton("Zur\xC3\xBC" "ck", ImVec2(110.0f, 0.0f), page_ == 0)) SetPage(page_ - 1);
+        ImGui::SameLine();
+        ImGui::Text("Seite %u / %u | %u Punkte", static_cast<unsigned int>(PageCount() ? page_ + 1 : 0),
+            static_cast<unsigned int>(PageCount()), static_cast<unsigned int>(rows_.size()));
+        ImGui::SameLine();
+        if (UIComponents::SecondaryButton("Weiter", ImVec2(110.0f, 0.0f), page_ + 1 >= PageCount())) SetPage(page_ + 1);
+        if (UIComponents::SecondaryButton("Schlie\xC3\x9F" "en")) Close();
+        if (OwnsActiveRoute()) {
+            ImGui::SameLine();
+            if (UIComponents::SecondaryButton("Navigation beenden")) StopOwnedRoute();
+        }
+    }
+    ImGui::End();
+}
+
+} // namespace keybinder
diff --git a/tests/GpsTemporaryTests.cpp b/tests/GpsTemporaryTests.cpp
new file mode 100644
index 0000000..25415b9
--- /dev/null
+++ b/tests/GpsTemporaryTests.cpp
@@ -0,0 +1,207 @@
+#include "../include/GpsManager.h"
+
+#include <algorithm>
+#include <cstdio>
+#include <filesystem>
+#include <fstream>
+#include <iterator>
+#include <limits>
+#include <optional>
+#include <string>
+#include <vector>
+#include <windows.h>
+
+namespace {
+int checks = 0, failures = 0;
+#define CHECK(value) do { ++checks; if (!(value)) { ++failures; std::printf("[FAIL] GpsTemporary: %s (line %d)\n", #value, __LINE__); } } while (0)
+
+unsigned int nextFixture = 0;
+struct Fixture {
+    std::filesystem::path directory, file;
+    keybinder::GpsPosition position{100, 200, 30, 0};
+    bool available = true;
+    std::vector<std::string> messages;
+    std::optional<keybinder::GpsEntry> rendered;
+    keybinder::GpsManager gps;
+
+    Fixture() {
+        directory = std::filesystem::path("build/gps-temporary-tests") /
+            (std::to_string(GetCurrentProcessId()) + "-" + std::to_string(GetTickCount64()) + "-" + std::to_string(++nextFixture));
+        std::filesystem::create_directories(directory);
+        file = directory / "gps.xml";
+        gps.Initialize(file.string(), [&](const auto& message) { messages.push_back(message); },
+            [&](auto& out) { out = position; return available; },
+            [&](const keybinder::GpsEntry* destination) {
+                if (destination) rendered = *destination;
+                else rendered.reset();
+            });
+    }
+    ~Fixture() { gps.Shutdown(); }
+    std::string Xml() const {
+        std::ifstream input(file, std::ios::binary);
+        return {std::istreambuf_iterator<char>(input), std::istreambuf_iterator<char>()};
+    }
+    std::size_t Arrivals() const {
+        return std::count_if(messages.begin(), messages.end(), [](const auto& message) {
+            return message.find("Du hast dein Ziel erreicht:") != std::string::npos;
+        });
+    }
+};
+
+keybinder::GpsEntry Temporary(unsigned int id = 1) {
+    return {keybinder::GpsManager::kTemporaryIdMask | id,
+        "Spray 001 - Vinewood", {944.3f, -985.8f, 39.3f, 0}};
+}
+
+void TemporaryRouteWorksWithTwentyBookmarksWithoutWritingXml() {
+    Fixture fixture;
+    for (int index = 0; index < 20; ++index) {
+        fixture.position.x = static_cast<float>(index * 10);
+        CHECK(fixture.gps.Set("Saved " + std::to_string(index + 1)));
+    }
+    CHECK(fixture.gps.Entries().size() == 20);
+    const auto before = fixture.Xml();
+    CHECK(!before.empty());
+    const auto target = Temporary();
+    CHECK(fixture.gps.NavigateTemporary(target));
+    CHECK(fixture.gps.ActiveDestination() && fixture.gps.ActiveDestination()->id == target.id);
+    CHECK(fixture.rendered && fixture.rendered->position.x == target.position.x);
+    CHECK(fixture.gps.Entries().size() == 20);
+    CHECK(fixture.Xml() == before);
+    CHECK(!fixture.gps.Set("Twenty-first bookmark"));
+    CHECK(fixture.Xml() == before);
+    CHECK(fixture.gps.ActiveDestination() && fixture.gps.ActiveDestination()->id == target.id);
+    fixture.gps.StopNavigation();
+    CHECK(!fixture.gps.ActiveDestination() && !fixture.rendered);
+    CHECK(fixture.Xml() == before);
+
+    keybinder::GpsManager loaded;
+    loaded.Initialize(fixture.file.string(), {}, {});
+    CHECK(loaded.Entries().size() == 20);
+    CHECK(!loaded.ActiveDestination());
+    for (const auto& entry : loaded.Entries()) CHECK((entry.id & keybinder::GpsManager::kTemporaryIdMask) == 0);
+    loaded.Shutdown();
+}
+
+void SavedAndTemporaryRoutesSwitchAndDeletionDoesNotAffectTheOtherOwner() {
+    Fixture fixture;
+    CHECK(fixture.gps.Set("Saved A"));
+    const auto savedA = fixture.gps.Entries().back().id;
+    fixture.position.x += 20;
+    CHECK(fixture.gps.Set("Saved B"));
+    const auto savedB = fixture.gps.Entries().back().id;
+    CHECK(fixture.gps.Navigate(savedA));
+    CHECK(fixture.rendered && fixture.rendered->id == savedA);
+    CHECK(fixture.gps.NavigateTemporary(Temporary(1)));
+    CHECK(fixture.rendered && fixture.rendered->id == Temporary(1).id);
+    CHECK(fixture.gps.Remove(savedA));
+    CHECK(fixture.gps.ActiveDestination() && fixture.gps.ActiveDestination()->id == Temporary(1).id);
+    CHECK(!fixture.gps.Remove(Temporary(1).id));
+    CHECK(fixture.gps.RemoveAll());
+    CHECK(fixture.gps.Entries().empty());
+    CHECK(fixture.gps.ActiveDestination() && fixture.gps.ActiveDestination()->id == Temporary(1).id);
+    CHECK(!fixture.gps.Navigate(savedB));
+    CHECK(fixture.gps.ActiveDestination() && fixture.gps.ActiveDestination()->id == Temporary(1).id);
+    CHECK(fixture.gps.Set("Saved C"));
+    const auto savedC = fixture.gps.Entries().back().id;
+    CHECK(fixture.gps.Navigate(savedC));
+    CHECK(fixture.rendered && fixture.rendered->id == savedC);
+    CHECK(fixture.gps.ActiveDestination() && fixture.gps.ActiveDestination()->id == savedC);
+    CHECK(fixture.gps.Remove(savedC));
+    CHECK(!fixture.gps.ActiveDestination() && !fixture.rendered);
+
+    auto second = Temporary(2);
+    second.name = "Spray 002 - Temple";
+    second.position = {1072.9f, -1012.8f, 35.5f, 0};
+    CHECK(fixture.gps.NavigateTemporary(Temporary(1)));
+    CHECK(fixture.gps.NavigateTemporary(second));
+    CHECK(fixture.rendered && fixture.rendered->id == second.id);
+    CHECK(fixture.rendered && fixture.rendered->position.x == second.position.x);
+    second.name = "Caller mutated its entry";
+    second.position.x = 0;
+    CHECK(fixture.gps.ActiveDestination() && fixture.gps.ActiveDestination()->name == "Spray 002 - Temple");
+    CHECK(fixture.gps.ActiveDestination() && fixture.gps.ActiveDestination()->position.x == 1072.9f);
+}
+
+void InvalidTemporaryTargetsPreserveTheCurrentRoute() {
+    Fixture fixture;
+    const auto original = Temporary();
+    CHECK(fixture.gps.NavigateTemporary(original));
+    const auto baseline = fixture.messages.size();
+    auto noNamespace = Temporary(2); noNamespace.id = 2;
+    auto empty = Temporary(2); empty.name = " \t ";
+    auto control = Temporary(2); control.name = "Target\n/r injected";
+    auto tooLong = Temporary(2); tooLong.name = std::string(65, 'a');
+    auto nan = Temporary(2); nan.position.x = std::numeric_limits<float>::quiet_NaN();
+    auto infinity = Temporary(2); infinity.position.y = std::numeric_limits<float>::infinity();
+    auto excessive = Temporary(2); excessive.position.z = 1000001.0f;
+    auto negativeInterior = Temporary(2); negativeInterior.position.interior = -1;
+    auto excessiveInterior = Temporary(2); excessiveInterior.position.interior = 256;
+    for (const auto& invalid : {noNamespace, empty, control, tooLong, nan, infinity, excessive, negativeInterior, excessiveInterior}) {
+        CHECK(!fixture.gps.NavigateTemporary(invalid));
+        CHECK(fixture.gps.ActiveDestination() && fixture.gps.ActiveDestination()->id == original.id);
+        CHECK(fixture.rendered && fixture.rendered->id == original.id);
+    }
+    CHECK(fixture.messages.size() == baseline);
+}
+
+void TemporaryArrivalUsesTheExistingCheckpointLifecycleExactlyOnce() {
+    Fixture fixture;
+    const auto target = Temporary();
+    CHECK(fixture.gps.NavigateTemporary(target));
+    fixture.gps.Update();
+    CHECK(fixture.Arrivals() == 0);
+    fixture.available = false;
+    fixture.gps.Update();
+    CHECK(!fixture.rendered && fixture.gps.ActiveDestination());
+    fixture.available = true;
+    fixture.position = target.position;
+    fixture.position.interior = 1;
+    fixture.gps.Update();
+    CHECK(!fixture.rendered && fixture.gps.ActiveDestination());
+    CHECK(fixture.Arrivals() == 0);
+    fixture.position.interior = 0;
+    fixture.gps.Update();
+    CHECK(!fixture.rendered && !fixture.gps.ActiveDestination());
+    CHECK(fixture.Arrivals() == 1);
+    for (int index = 0; index < 10; ++index) fixture.gps.Update();
+    CHECK(fixture.Arrivals() == 1);
+
+    // Selecting a spray while already standing at it follows the GPS rule:
+    // display its marker until the player leaves and comes back.
+    CHECK(fixture.gps.NavigateTemporary(target));
+    for (int index = 0; index < 5; ++index) fixture.gps.Update();
+    CHECK(fixture.gps.ActiveDestination() && fixture.rendered);
+    CHECK(fixture.Arrivals() == 1);
+    fixture.position.x += 5;
+    fixture.gps.Update();
+    fixture.position = target.position;
+    fixture.gps.Update();
+    CHECK(!fixture.gps.ActiveDestination() && !fixture.rendered);
+    CHECK(fixture.Arrivals() == 2);
+    fixture.gps.Update();
+    CHECK(fixture.Arrivals() == 2);
+}
+
+void ShutdownAndReinitializationDiscardTemporaryTargets() {
+    Fixture fixture;
+    CHECK(fixture.gps.NavigateTemporary(Temporary()));
+    fixture.gps.Shutdown();
+    CHECK(!fixture.gps.ActiveDestination() && !fixture.rendered);
+    CHECK(fixture.gps.NavigateTemporary(Temporary()));
+    fixture.gps.Initialize(fixture.file.string(), {}, {});
+    CHECK(!fixture.gps.ActiveDestination() && !fixture.rendered);
+    CHECK(fixture.gps.Entries().empty());
+}
+} // namespace
+
+int RunGpsTemporaryTests() {
+    checks = failures = 0;
+    TemporaryRouteWorksWithTwentyBookmarksWithoutWritingXml();
+    SavedAndTemporaryRoutesSwitchAndDeletionDoesNotAffectTheOtherOwner();
+    InvalidTemporaryTargetsPreserveTheCurrentRoute();
+    TemporaryArrivalUsesTheExistingCheckpointLifecycleExactlyOnce();
+    ShutdownAndReinitializationDiscardTemporaryTargets();
+    std::printf("GpsTemporaryTests: %d checks, %d failures\n", checks, failures);
+    return failures;
+}
