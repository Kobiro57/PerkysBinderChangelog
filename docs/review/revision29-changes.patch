+    write('docs/review/SOURCE-COMPARISON.json',json.dumps(record,indent=2,ensure_ascii=False)+'\n')
+    relevant=[x for x in changes if not x['dependency'] and not x['line_endings_only']]
+    lines=['# Dateivergleich zum Original','',
