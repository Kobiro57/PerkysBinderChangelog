+    Say("Navigation gestartet: " + ActiveDestination()->name + ". Das Ziel ist rot markiert.");
+}
+void GpsManager::StopNavigation() {
+    activeId_ = 0; arrivalArmed_ = false; temporaryDestination_.reset();
+    if (renderer_) renderer_(nullptr);
 }
