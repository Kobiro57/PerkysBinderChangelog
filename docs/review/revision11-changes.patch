+    ASSERT_EQ(explosion.healthDamage, 4900.0f);
+    ASSERT_EQ(explosion.armourDamage, 450.0f);
+    ASSERT_TRUE(!log.Observe(8000050.0f, 8000050.0f).HasDamage());
+    ASSERT_TRUE(!log.Observe(50.0f, 10.0f).HasDamage());
