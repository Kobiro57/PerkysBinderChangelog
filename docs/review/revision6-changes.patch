+$ErrorActionPreference = 'Stop'
+$projectRoot = Split-Path -Parent $PSScriptRoot
+$binary = Join-Path $projectRoot 'build\Release\Keybinder.asi'
+$reportPath = Join-Path $projectRoot 'build\revision6-artifact.json'
+$report = Get-Content -LiteralPath $reportPath -Raw | ConvertFrom-Json
+$binaryHash = (Get-FileHash -LiteralPath $binary -Algorithm SHA256).Hash.ToLowerInvariant()
+if ($report.revision -ne 'v0.1.1-r6' -or $binaryHash -ne $report.sha256 -or -not $report.embedded_helper_matches) {
+    throw 'Die ASI stimmt nicht mit dem finalen r6-Prüfbericht überein.'
+}
+$helperPath = Join-Path $projectRoot 'build\ReconnectHelper.exe'
+$helperHash = (Get-FileHash -LiteralPath $helperPath -Algorithm SHA256).Hash.ToLowerInvariant()
+if ($helperHash -ne $report.helper_sha256) { throw 'Der Reconnect-Helfer hat sich seit der Artefaktprüfung geändert.' }
+$workerPath = Join-Path $projectRoot 'build\reconnect-worker-tests\result.json'
+$workerResult = Get-Content -LiteralPath $workerPath -Raw | ConvertFrom-Json
+if ($workerResult.failures -ne 0 -or $workerResult.checks -lt 18) { throw 'Reconnect-Helfertest fehlgeschlagen oder unvollständig.' }
+if ((Get-Item -LiteralPath $workerPath).LastWriteTimeUtc -lt (Get-Item -LiteralPath $helperPath).LastWriteTimeUtc) {
+    throw 'Den nativen Helfertest nach dem letzten Helfer-Build erneut ausführen.'
+}
+$testLog = Get-Content -LiteralPath (Join-Path $projectRoot 'build\revision6-tests.log') -Raw
+if ($testLog -notmatch '(?m)^Test exit code: 0\s*$' -or $testLog -match '\[FAIL\]') { throw 'Gesamttests nicht erfolgreich.' }
+$buildLog = Get-Content -LiteralPath (Join-Path $projectRoot 'build\revision6-build.log') -Raw
+if ($buildLog -notmatch '(?m)^RELEASE_BUILD_EXIT_CODE=0\s*$' -or $buildLog -notmatch 'Keybinder\.vcxproj -> .*Keybinder\.asi' -or $buildLog -match ': (fatal )?error [A-Z]+\d+:') {
+    throw 'Erfolgreicher finaler Release-Build nicht bestätigt.'
+}
+
+$packageDirectory = Join-Path $projectRoot 'dist\NLBinder-0.1.1-r6'
+$archive = Join-Path $projectRoot 'dist\NLBinder-v0.1.1-KOBiRO-r6.zip'
+if ((Test-Path -LiteralPath $packageDirectory) -or (Test-Path -LiteralPath $archive)) {
+    throw 'r6-Paket existiert bereits; nicht automatisch überschreiben.'
+}
+New-Item -ItemType Directory -Path $packageDirectory | Out-Null
+Copy-Item -LiteralPath $binary -Destination (Join-Path $packageDirectory 'Keybinder.asi')
+Copy-Item -LiteralPath (Join-Path $projectRoot 'docs\NLBinder-0.1.1-r6-DE.md') -Destination (Join-Path $packageDirectory 'LIESMICH.md')
+Copy-Item -LiteralPath (Join-Path $projectRoot 'docs\jobs-support.md') -Destination (Join-Path $packageDirectory 'JOB-HINWEISE.md')
+Copy-Item -LiteralPath $reportPath -Destination (Join-Path $packageDirectory 'PRUEFBERICHT.json')
+Copy-Item -LiteralPath $workerPath -Destination (Join-Path $packageDirectory 'RECONNECT-TEST.json')
+
+$buildInfo = @"
+NLBinder v.0.1.1 by KOBiRO – Überarbeitung 6
+Erstellt: $([System.TimeZoneInfo]::ConvertTimeBySystemTimeZoneId([DateTime]::UtcNow, 'W. Europe Standard Time').ToString('dd.MM.yyyy HH:mm:ss')) (Europe/Berlin)
+Datei: Keybinder.asi
+Format: Win32 Release, PE32/x86 DLL
+Größe: $($report.bytes) Bytes
+SHA256: $binaryHash
+Eingebetteter Reconnect-Helfer: Ressource 300, $($report.embedded_helper_bytes) Bytes
+Helfer-SHA256: $($report.helper_sha256)
+
+Verifikation:
+- Vollständige automatisierte Tests: Exitcode 0
+- Release-Build: Exitcode 0
+- ASI-Format, Windows-Imports und eingebetteter Helfer geprüft
+- Eingebetteter Reconnect-Helfer stimmt mit dem geprüften Helfer überein
+- Nativer Reconnect-Helfer: $($workerResult.checks) Prüfungen, 0 Fehler
+- Dafür ausschließlich harmlose Testprozesse verwendet
+- Kein echtes Spiel und kein installierter Launcher gestartet oder beendet
+- Kein Ingame-Test durchgeführt
+
+Neue Änderungen:
+- Statistik-Titel mit dem Unicode-Trennzeichen » werden korrekt zugeordnet
+- Eigene Statistik wird nicht mehr wegen dieses Titeltrennzeichens abgewiesen
+- Vollständiger komprimierter RPC-61-Pfad mit anonymisiertem Dialogformat geprüft
+- Import, eigener Dialogabschluss und Testkill verwenden denselben Gesamtstand
+- Der einmalige Motorstart aus r5 bleibt unverändert enthalten
+
+Die früheren Job-, Skilltree-, Fraktions-, Radar-, Tacho- und Reconnect-
+Anpassungen sind enthalten. Die ursprüngliche Oberfläche bleibt Grundlage.
+Der Reconnect-Helfer ist in der ASI enthalten.
+
+Grenzen: Die Synchronisation wartet auf eine echte Serverantwort. Mehrere
+Schadensereignisse zwischen Messungen erscheinen als gemessener Gesamtverlust.
+Ein Live-Test mit dem konkreten Server und Launcher steht weiterhin aus.
+Installation und weitere Hinweise stehen in LIESMICH.md.
+"@
+$buildInfo | Set-Content -LiteralPath (Join-Path $packageDirectory 'BUILD-INFO.txt') -Encoding utf8
+"$binaryHash  Keybinder.asi" | Set-Content -LiteralPath (Join-Path $packageDirectory 'SHA256SUMS.txt') -Encoding ascii
+Compress-Archive -LiteralPath $packageDirectory -DestinationPath $archive -CompressionLevel Optimal
+
+Add-Type -AssemblyName System.IO.Compression.FileSystem
+$zip = [System.IO.Compression.ZipFile]::OpenRead($archive)
+try {
+    $entry = $zip.Entries | Where-Object { $_.FullName -match '/Keybinder\.asi$' }
+    if (@($entry).Count -ne 1) { throw 'ASI fehlt im Archiv oder ist mehrfach enthalten.' }
+    $stream = $entry.Open()
+    $digest = [System.Security.Cryptography.SHA256]::Create()
+    try {
+        $zippedHash = [BitConverter]::ToString($digest.ComputeHash($stream)).Replace('-', '').ToLowerInvariant()
+        if ($zippedHash -ne $binaryHash) { throw 'ASI-Prüfsumme im Archiv stimmt nicht.' }
+    } finally { $stream.Dispose(); $digest.Dispose() }
+} finally { $zip.Dispose() }
+$stagedHash = (Get-FileHash -LiteralPath (Join-Path $packageDirectory 'Keybinder.asi') -Algorithm SHA256).Hash.ToLowerInvariant()
+if ($stagedHash -ne $binaryHash) { throw 'Kopierte ASI stimmt nicht überein.' }
+Get-Item -LiteralPath (Join-Path $packageDirectory 'Keybinder.asi'), $archive | Select-Object FullName,Length
+Write-Output "SHA256: $binaryHash"
diff --git a/tools/verify_revision6_artifact.py b/tools/verify_revision6_artifact.py
new file mode 100644
index 0000000..fc3d7c5
--- /dev/null
+++ b/tools/verify_revision6_artifact.py
@@ -0,0 +1,115 @@
+"""Read-only r6 PE/artifact verification; never loads or executes binaries."""
+import hashlib
+import json
+from pathlib import Path
+import struct
+import sys
+
+
+def require(condition, message):
+    if not condition:
+        raise ValueError(message)
+
+
+class PE:
+    def __init__(self, path):
+        self.path = Path(path)
+        self.data = self.path.read_bytes()
+        require(self.data[:2] == b"MZ", "Missing DOS header")
+        start = self.u32(0x3C)
+        require(self.data[start:start + 4] == b"PE\0\0", "Missing PE signature")
+        self.machine = self.u16(start + 4)
+        count = self.u16(start + 6)
+        self.characteristics = self.u16(start + 22)
+        self.optional = start + 24
+        require(self.u16(self.optional) == 0x10B, "Expected PE32")
+        self.sections = []
+        table = self.optional + self.u16(start + 20)
+        for index in range(count):
+            row = table + index * 40
+            virtual_size, rva, size, raw = struct.unpack_from("<IIII", self.data, row + 8)
+            self.sections.append((rva, max(virtual_size, size), raw, size))
+
+    def u16(self, offset):
+        return struct.unpack_from("<H", self.data, offset)[0]
+
+    def u32(self, offset):
+        return struct.unpack_from("<I", self.data, offset)[0]
+
+    def offset(self, rva):
+        for start, span, raw, size in self.sections:
+            if start <= rva < start + span:
+                require(rva - start < size, "RVA has no raw file data")
+                return raw + rva - start
+        raise ValueError(f"Unmapped RVA: {rva:#x}")
+
+    def imports(self):
+        directory = self.u32(self.optional + 96 + 8)
+        if not directory:
+            return []
+        row = self.offset(directory)
+        result = []
+        while any(struct.unpack_from("<IIIII", self.data, row)):
+            name = self.offset(self.u32(row + 12))
+            end = self.data.index(0, name)
+            result.append(self.data[name:end].decode("ascii"))
+            row += 20
+        return sorted(result, key=str.lower)
+
+    def resource(self, type_id, resource_id):
+        base = self.offset(self.u32(self.optional + 96 + 16))
+
+        def entries(relative):
+            head = base + relative
+            total = self.u16(head + 12) + self.u16(head + 14)
+            return [struct.unpack_from("<II", self.data, head + 16 + i * 8) for i in range(total)]
+
+        directory = 0
+        for expected in (type_id, resource_id):
+            candidates = [value for name, value in entries(directory) if name == expected]
+            require(len(candidates) == 1, f"Resource ID {expected} missing or ambiguous")
+            require(candidates[0] & 0x80000000, "Expected resource directory")
+            directory = candidates[0] & 0x7FFFFFFF
+        languages = entries(directory)
+        require(len(languages) == 1, "Expected one embedded worker language")
+        leaf = languages[0][1]
+        require(not leaf & 0x80000000, "Expected resource data entry")
+        rva, size = struct.unpack_from("<II", self.data, base + leaf)
+        start = self.offset(rva)
+        return self.data[start:start + size]
+
+
+def main():
+    root = Path(__file__).resolve().parents[1]
+    asi = PE(sys.argv[1] if len(sys.argv) > 1 else root / "build/Release/Keybinder.asi")
+    helper = PE(root / "build/ReconnectHelper.exe")
+    require(asi.machine == helper.machine == 0x14C, "Expected both binaries to be x86")
+    require(asi.characteristics & 0x2000, "ASI must be a DLL")
+    require(not helper.characteristics & 0x2000, "Worker must be an executable")
+    require(asi.resource(10, 300) == helper.data, "Embedded helper differs from built helper")
+    imports = asi.imports()
+    require(not any(name.lower().startswith(("vcruntime", "msvcp", "ucrtbased")) for name in imports),
+            "Unexpected external C++ runtime dependency")
