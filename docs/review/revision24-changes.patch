+TAG='v0.1.2-r24'
+
+def check(ok,why):
+    if not ok:raise ValueError(why)
+
+def sha(path):
+    with path.open('rb') as stream:return hashlib.file_digest(stream,'sha256').hexdigest()
+
+def main():
+    package=R/'dist/NLBinder-0.1.2-r24'
+    archive=R/'dist/NLBinder-v0.1.2-KOBiRO-r24.zip'
