+    throw 'Erfolgreicher finaler Release-Build nicht bestätigt.'
+}
+
+$packageDirectory = Join-Path $projectRoot 'dist\NLBinder-0.1.1-r4'
+$archive = Join-Path $projectRoot 'dist\NLBinder-v0.1.1-KOBiRO-r4.zip'
