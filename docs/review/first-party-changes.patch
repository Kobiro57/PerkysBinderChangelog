+    NativeHudHooks::Observe(editor,HudElement::Health,180,210);
+    HUD_CHECK(editor.GetElementBounds(HudElement::Health,bx,by,bw,bh));
+    HUD_CHECK(Near(bx,100)&&Near(by,200)&&Near(bw,80)&&Near(bh,10));
+    editor.SetLayout(layout);
+    HUD_CHECK(editor.GetElementBounds(HudElement::Health,bx,by,bw,bh));
+    health.offset_x=0.3f;
+    editor.SetLayout(layout);
+    HUD_CHECK(!editor.GetElementBounds(HudElement::Health,bx,by,bw,bh));
+    HUD_CHECK(editor.Initialize());
+    HUD_CHECK(editor.Initialize());
+    editor.Shutdown();editor.Shutdown();
+    HUD_CHECK(!editor.GetElementBounds(HudElement::Health,bx,by,bw,bh));
+    editor.SetLayout(HudLayout{});
+    HUD_CHECK(editor.TransformColor(HudElement::Health,0xffffffff)==0xffffffff);
+    std::printf("\n=== NativeHudEditor Results: %d passed, %d failed ===\n\n",passed,failed);
+    return failed;
+}
