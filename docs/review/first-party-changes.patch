diff --git a/tests/KillMessageTestTests.cpp b/tests/KillMessageTestTests.cpp
new file mode 100644
index 0000000..9f4cdd3
--- /dev/null
+++ b/tests/KillMessageTestTests.cpp
@@ -0,0 +1,59 @@
+#include "../include/KillMessageTest.h"
+
+#include <cstdio>
+#include <string>
+
+namespace {
+int failures = 0;
+int checks = 0;
+#define CHECK(value) do { ++checks; if (!(value)) { ++failures; std::printf("[FAIL] Testkill: %s (line %d)\n", #value, __LINE__); } } while (0)
+
+void CheckMessage(const std::string& input, const std::string& expected) {
+    std::string message, error;
+    CHECK(keybinder::BuildSimulatedKillMessage(input, message, error));
+    CHECK(message == expected);
+    CHECK(error.empty());
+}
+
+void TestChatAndArbitraryCommandChannels() {
+    CheckMessage("Kill in Los Santos, Market. Meine Kills: 64", "[Testkill] Kill in Los Santos, Market. Meine Kills: 64");
+    CheckMessage("/f Kill in Market", "/f [Testkill] Kill in Market");
+    CheckMessage("/d Kill in Market", "/d [Testkill] Kill in Market");
+    CheckMessage("/r Kill in Market", "/r [Testkill] Kill in Market");
+    CheckMessage("/me meldet einen Test", "/me [Testkill] meldet einen Test");
+    CheckMessage("  /custom_channel\t  Nachricht  ", "/custom_channel [Testkill] Nachricht");
+    CheckMessage("/f", "/f [Testkill]");
+    CheckMessage("Eine Zahl 1/2", "[Testkill] Eine Zahl 1/2");
+}
+
+void TestInvalidAndLongMessages() {
+    for (const std::string input : {std::string(), std::string(" \t\n"), std::string("/"), std::string("/  "),
+                                  std::string("eins\nzwei"), std::string("/f eins\rzwei"), std::string("eins\0zwei", 9)}) {
+        std::string message = "old", error;
+        CHECK(!keybinder::BuildSimulatedKillMessage(input, message, error));
+        CHECK(message.empty());
+        CHECK(!error.empty());
+    }
+    std::string message, error;
+    CHECK(keybinder::BuildSimulatedKillMessage("/f " + std::string(200, 'x'), message, error));
+    CHECK(message.size() == 144);
+    CHECK(message.starts_with("/f [Testkill] "));
+    CHECK(keybinder::BuildSimulatedKillMessage(std::string(132, 'a') + "\xC3\xA4", message, error));
+    CHECK(message == "[Testkill] " + std::string(132, 'a'));
+    CHECK(message.size() == 143);
+    CHECK(!keybinder::BuildSimulatedKillMessage("/" + std::string(140, 'x'), message, error));
+    CHECK(message.empty());
+}
+} // namespace
+
+int RunKillMessageTestTests() {
+    failures = checks = 0;
+    TestChatAndArbitraryCommandChannels();
+    TestInvalidAndLongMessages();
+    std::printf("KillMessageTestTests: %d checks, %d failures\n", checks, failures);
+    return failures;
+}
+
+#ifdef KILL_MESSAGE_TEST_MAIN
+int main() { return RunKillMessageTestTests(); }
+#endif
diff --git a/tests/LocationVariableTests.cpp b/tests/LocationVariableTests.cpp
new file mode 100644
index 0000000..b740477
--- /dev/null
+++ b/tests/LocationVariableTests.cpp
@@ -0,0 +1,112 @@
+#include "../include/ActionExecutor.h"
+#include "../include/LocationNames.h"
+#include "../include/MessageVariables.h"
+
+#include <algorithm>
+#include <cctype>
+#include <cstdio>
+#include <set>
+#include <string>
+#include <vector>
+
+#ifdef LOCATION_VARIABLE_TEST_MAIN
+#include <atomic>
+std::atomic<int> g_shutdown_phase{0};
+#endif
+
+namespace {
+int checks = 0;
+int failures = 0;
+#define LOCATION_CHECK(condition) do { ++checks; if (!(condition)) { ++failures; std::printf("[FAIL] LocationVariables line %d: %s\n", __LINE__, #condition); } } while (0)
+
+struct Bridge : keybinder::SAMPBridgeInterface {
+    mutable std::vector<std::string> chat;
+    mutable std::vector<std::string> commands;
+    bool SendChat(const std::string& text) const override { chat.push_back(text); return true; }
+    bool SendCommand(const std::string& text) const override { commands.push_back(text); return true; }
+};
+
+struct Data : keybinder::GameDataProvider {
+    int cityLevel = 1;
+    std::string district = "Market";
+    float GetPlayerHP() const override { return 67.0f; }
+    float GetPlayerArmour() const override { return 12.0f; }
+    float GetVehicleHP() const override { return 1000.0f; }
+    int GetTotalKills() const override { return 12; }
+    int GetTotalDeaths() const override { return 3; }
+    std::string GetVehicleName() const override { return "Bobcat"; }
+    std::string GetCityName() const override { return keybinder::CityNameFromGtaLevel(cityLevel); }
+    std::string GetDistrictName() const override { return district; }
+};
+
+void TestCityAndDistrictAreDifferentValues() {
+    Bridge bridge;
+    Data data;
+    keybinder::ActionExecutor executor;
+    executor.SetSAMPBridge(&bridge);
+    executor.SetGameDataProvider(&data);
+    executor.Execute({keybinder::Action(keybinder::ActionType::Chat, "{city}|{bezirk}|{zone}|{hp}|{weste}|{total_kills}|{kd}")});
+    executor.Update();
+    LOCATION_CHECK(bridge.chat.size() == 1);
+    LOCATION_CHECK(bridge.chat.back() == "Los Santos|Market|Market|67|12|12|4.00");
+    LOCATION_CHECK(bridge.commands.empty());
+    data.cityLevel = 2;
+    data.district = "Garcia";
+    executor.Execute({keybinder::Action(keybinder::ActionType::Command, "/r {city}: {bezirk}")});
+    executor.Update();
+    LOCATION_CHECK(bridge.commands.size() == 1);
+    LOCATION_CHECK(bridge.commands.back() == "/r San Fierro: Garcia");
+    data.cityLevel = 0; // GTA handles the actual boundary, not a copied approximation.
+    data.district = "Blueberry";
+    executor.Execute({keybinder::Action(keybinder::ActionType::Chat, "{city}|{bezirk}")});
+    executor.Update();
+    LOCATION_CHECK(bridge.chat.back() == "San Andreas|Blueberry");
+    LOCATION_CHECK(std::string(keybinder::CityNameFromGtaLevel(3)) == "Las Venturas");
+    LOCATION_CHECK(std::string(keybinder::CityNameFromGtaLevel(-1)) == "Unknown");
+    LOCATION_CHECK(std::string(keybinder::CityNameFromGtaLevel(4)) == "Unknown");
+}
+
+void TestMissingLocationDoesNotQueryServer() {
+    Bridge bridge;
+    keybinder::ActionExecutor executor;
+    executor.SetSAMPBridge(&bridge);
+    executor.Execute({keybinder::Action(keybinder::ActionType::Chat, "{city}|{bezirk}")});
+    executor.Update();
+    LOCATION_CHECK(bridge.chat.size() == 1);
+    LOCATION_CHECK(bridge.chat.back() == "Unknown|Unknown");
+    LOCATION_CHECK(bridge.commands.empty());
+}
+
+template <std::size_t Count>
+void CheckCatalog(const keybinder::MessageVariableInfo (&catalog)[Count]) {
+    std::set<std::string> names;
+    bool hasCity = false, hasDistrict = false;
+    for (const auto& variable : catalog) {
+        std::string lower = variable.tag;
+        std::transform(lower.begin(), lower.end(), lower.begin(), [](unsigned char value) { return static_cast<char>(std::tolower(value)); });
+        LOCATION_CHECK(lower == variable.tag);
+        LOCATION_CHECK(names.insert(lower).second);
+        LOCATION_CHECK(lower != "victim" && lower != "killer" && lower != "weapon");
+        LOCATION_CHECK(lower != "zone" && lower != "district");
+        hasCity = hasCity || lower == "city";
+        hasDistrict = hasDistrict || lower == "bezirk";
+    }
+    LOCATION_CHECK(hasCity);
+    LOCATION_CHECK(hasDistrict);
+}
+} // namespace
+
+int RunLocationVariableTests() {
+    checks = 0;
+    failures = 0;
+    TestCityAndDistrictAreDifferentValues();
+    TestMissingLocationDoesNotQueryServer();
+    CheckCatalog(keybinder::kCombatMessageVariables);
+    CheckCatalog(keybinder::kTextBindingVariables);
+    std::printf("LocationVariableTests: %d checks, %d failures\n", checks, failures);
+    return failures;
+}
+
+#ifdef LOCATION_VARIABLE_TEST_MAIN
+int main() { return RunLocationVariableTests(); }
+#endif
diff --git a/tests/NativeHudEditorTests.cpp b/tests/NativeHudEditorTests.cpp
new file mode 100644
index 0000000..deae319
--- /dev/null
+++ b/tests/NativeHudEditorTests.cpp
@@ -0,0 +1,103 @@
+#include "../include/NativeHudEditor.h"
+#include <cmath>
+#include <cstdio>
+#include <limits>
+
+namespace keybinder {
+// Feed observations through the same private accumulator used by the native
+// callbacks, without reading game memory or loading the game.
+struct NativeHudHooks {
+    static void Observe(NativeHudEditor& editor, HudElement element, float x, float y) {
+        editor.RecordPoint(element, x, y);
+    }
+};
+}
+
+namespace {
+int passed = 0, failed = 0;
+#define HUD_CHECK(test) do { if (test) ++passed; else { ++failed; std::printf("[FAIL] NativeHud: %s (line %d)\n",#test,__LINE__); } } while(0)
+bool Near(float a,float b) { return std::fabs(a-b)<0.001f; }
+}
+
+int RunNativeHudEditorTests() {
+    std::printf("\n=== NativeHudEditor Tests ===\n\n");
+    passed = failed = 0;
+    using namespace keybinder;
+    NativeHudEditor editor;
+    for (const auto& definition : kHudElements) {
+        float x=123.5f,y=45.25f;
+        editor.TransformPoint(definition.element,x,y,2560,1440);
+        HUD_CHECK(Near(x,123.5f) && Near(y,45.25f));
+        HUD_CHECK(editor.TransformColor(definition.element,0x7f123456)==0x7f123456);
+    }
+    HudLayout layout{};
+    auto& money=layout[static_cast<std::size_t>(HudElement::Money)];
+    money.offset_x=-0.1f; money.offset_y=0.25f;
+    money.custom_color=true; money.color={{0.0f,1.0f,0.5f,0.5f}};
+    editor.SetLayout(layout);
+    float x=300,y=100;
+    editor.TransformPoint(HudElement::Money,x,y,1920,1080);
+    HUD_CHECK(Near(x,108) && Near(y,370));
+    x=300;y=100;
+    editor.TransformPoint(HudElement::Money,x,y,1280,720);
+    HUD_CHECK(Near(x,172) && Near(y,280));
+    x=300;y=100;
+    editor.TransformPoint(HudElement::Ammo,x,y,1920,1080);
+    HUD_CHECK(Near(x,300) && Near(y,100));
+    HUD_CHECK(editor.TransformColor(HudElement::Money,0xc8b4191d)==0x6400ff80);
+    HUD_CHECK(editor.TransformColor(HudElement::Money,0xc8000000)==0x64000000);
+    HUD_CHECK(editor.TransformColor(HudElement::Ammo,0xc8b4191d)==0xc8b4191d);
+    HUD_CHECK(editor.TransformColor(HudElement::Count,0x12345678)==0x12345678);
+    auto& radar=layout[static_cast<std::size_t>(HudElement::Radar)];
+    radar.custom_color=true; radar.color={{0.5f,1,0,1}};
+    editor.SetLayout(layout);
+    HUD_CHECK(editor.TransformColor(HudElement::Radar,0xc8a0b0c0)==0xc850b000);
+    HUD_CHECK(editor.TransformColor(HudElement::Radar,0xff000000)==0xff000000);
+    HUD_CHECK(NativeHudEditor::ClassifyPlayerInfoText("14:38")==HudElement::Count);
+    HUD_CHECK(NativeHudEditor::ClassifyPlayerInfoText("00:00")==HudElement::Count);
+    HUD_CHECK(NativeHudEditor::ClassifyPlayerInfoText("$00110520")==HudElement::Money);
+    HUD_CHECK(NativeHudEditor::ClassifyPlayerInfoText("-$0000050")==HudElement::Money);
+    for (auto text : {"", "1:38", "14:380", "INFO: 14:38", "$", "$12x", "12$", "15-200", "Market", "Welcome"})
+        HUD_CHECK(NativeHudEditor::ClassifyPlayerInfoText(text)==HudElement::Count);
+    HUD_CHECK(NativeHudEditor::ClassifyPlayerInfoText(nullptr)==HudElement::Count);
+    // Corrupt persisted floats cannot propagate NaN/Inf into GPU coordinates.
+    money.offset_x=std::numeric_limits<float>::quiet_NaN(); money.offset_y=2;
+    money.color={{std::numeric_limits<float>::infinity(),-1,2,std::numeric_limits<float>::quiet_NaN()}};
+    editor.SetLayout(layout);
+    x=5;y=6;editor.TransformPoint(HudElement::Money,x,y,640,448);
+    HUD_CHECK(Near(x,5) && Near(y,454));
+    HUD_CHECK(editor.TransformColor(HudElement::Money,0xffffffff)==0xffff00ff);
+    x=5;y=6;editor.TransformPoint(HudElement::Money,x,y,0,448);
+    HUD_CHECK(Near(x,5) && Near(y,6));
+    x=5;y=6;editor.TransformPoint(HudElement::Count,x,y,640,448);
+    HUD_CHECK(Near(x,5) && Near(y,6));
+    float bx=11,by=12,bw=13,bh=14;
+    HUD_CHECK(!editor.GetElementBounds(HudElement::Money,bx,by,bw,bh));
+    HUD_CHECK(Near(bx,11)&&Near(by,12)&&Near(bw,13)&&Near(bh,14));
+    NativeHudHooks::Observe(editor,HudElement::Money,100,200);
+    NativeHudHooks::Observe(editor,HudElement::Money,180,210);
+    HUD_CHECK(editor.GetElementBounds(HudElement::Money,bx,by,bw,bh));
+    HUD_CHECK(Near(bx,100)&&Near(by,200)&&Near(bw,80)&&Near(bh,10));
+    editor.SetLayout(layout);
+    HUD_CHECK(editor.GetElementBounds(HudElement::Money,bx,by,bw,bh));
+    money.offset_x=0.3f;
+    editor.SetLayout(layout);
+    HUD_CHECK(!editor.GetElementBounds(HudElement::Money,bx,by,bw,bh));
+    HUD_CHECK(editor.Initialize());
+    HUD_CHECK(editor.Initialize());
+    editor.Shutdown();editor.Shutdown();
+    HUD_CHECK(!editor.GetElementBounds(HudElement::Money,bx,by,bw,bh));
+    editor.SetLayout(HudLayout{});
+    HUD_CHECK(editor.TransformColor(HudElement::Money,0xffffffff)==0xffffffff);
+    HUD_CHECK(kHudElementCount == 4);
+    HUD_CHECK(NativeHudEditor::ResolvePrimitiveElement(HudElement::Count,true,false,false)==HudElement::Weapon);
+    // Vital-bar exclusions must beat weapon fallback and any enclosing scope.
+    HUD_CHECK(NativeHudEditor::ResolvePrimitiveElement(HudElement::Count,true,true,false)==HudElement::Count);
+    HUD_CHECK(NativeHudEditor::ResolvePrimitiveElement(HudElement::Radar,true,true,false)==HudElement::Count);
+    HUD_CHECK(NativeHudEditor::ResolvePrimitiveElement(HudElement::Ammo,true,false,false)==HudElement::Ammo);
+    HUD_CHECK(NativeHudEditor::ResolvePrimitiveElement(HudElement::Radar,false,false,false)==HudElement::Radar);
+    HUD_CHECK(NativeHudEditor::ResolvePrimitiveElement(HudElement::Count,false,false,false)==HudElement::Count);
+    HUD_CHECK(NativeHudEditor::ResolvePrimitiveElement(HudElement::Ammo,true,false,true)==HudElement::Count);
+    std::printf("\n=== NativeHudEditor Results: %d passed, %d failed ===\n\n",passed,failed);
+    return failed;
+}
