+    keybinder::SettingsManager restored;
+    CHECK(restored.LoadFromJson(source.GetSettingsJson()));
+    CHECK(restored.Get().interface_editor_saved_presets.size() == presets.size());
+    for (std::size_t slot = 0; slot < presets.size(); ++slot) {
