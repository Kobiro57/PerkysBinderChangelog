+    root = Path(__file__).resolve().parents[1]
+    source = root / "docs/review/CHANGELOG-DE.md"
+    target = root / "docs/CHANGELOG-GESAMT.txt"
+    text = source.read_text(encoding="utf-8")
+    required = {f"## {number}. " for number in range(1, 26)}
+    if not all(marker in text for marker in required):
+        raise ValueError("Complete change history sections 1-25 required")
+    result = render(text)
+    target.write_text(result, encoding="utf-8-sig", newline="\n")
+    print(f"Full changelog: {len(result.splitlines())} lines, sections 1-25, {target.name}")
