+    lastServerKillTotal_ = kills;
+    lastServerDeathTotal_ = deaths;
+    serverCombatBaselineEstablished_ = true;
+    Log("[SAMPBridge] Received server statistics: kills=" + std::to_string(kills) + " deaths=" + std::to_string(deaths));
