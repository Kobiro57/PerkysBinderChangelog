new file mode 100644
index 0000000..e8a1f16
--- /dev/null
+++ b/tools/package_revision8.ps1
@@ -0,0 +1,126 @@
+$ErrorActionPreference = 'Stop'
+$projectRoot = Split-Path -Parent $PSScriptRoot
+$binary = Join-Path $projectRoot 'build\Release\Keybinder.asi'
+$reportPath = Join-Path $projectRoot 'build\revision8-artifact.json'
+$report = Get-Content -LiteralPath $reportPath -Raw | ConvertFrom-Json
+$binaryHash = (Get-FileHash -LiteralPath $binary -Algorithm SHA256).Hash.ToLowerInvariant()
+if ($report.revision -ne 'v0.1.1-r8' -or $binaryHash -ne $report.sha256 -or -not $report.embedded_helper_matches) {
+    throw 'Die ASI stimmt nicht mit dem finalen r8-Prüfbericht überein.'
+}
+$helperPath = Join-Path $projectRoot 'build\ReconnectHelper.exe'
+$helperHash = (Get-FileHash -LiteralPath $helperPath -Algorithm SHA256).Hash.ToLowerInvariant()
+if ($helperHash -ne $report.helper_sha256) { throw 'Der Reconnect-Helfer hat sich seit der Artefaktprüfung geändert.' }
+$workerPath = Join-Path $projectRoot 'build\reconnect-worker-tests\result.json'
+$workerResult = Get-Content -LiteralPath $workerPath -Raw | ConvertFrom-Json
+if ($workerResult.failures -ne 0 -or $workerResult.checks -lt 18) { throw 'Reconnect-Helfertest fehlgeschlagen oder unvollständig.' }
+if ((Get-Item -LiteralPath $workerPath).LastWriteTimeUtc -lt (Get-Item -LiteralPath $helperPath).LastWriteTimeUtc) {
+    throw 'Den nativen Helfertest nach dem letzten Helfer-Build erneut ausführen.'
+}
+$testLog = Get-Content -LiteralPath (Join-Path $projectRoot 'build\revision8-tests.log') -Raw
+if ($testLog -notmatch '(?m)^Test exit code: 0\s*$' -or $testLog -match '\[FAIL\]') { throw 'Gesamttests nicht erfolgreich.' }
+$buildLog = Get-Content -LiteralPath (Join-Path $projectRoot 'build\revision8-build.log') -Raw
+if ($buildLog -notmatch '(?m)^RELEASE_BUILD_EXIT_CODE=0\s*$' -or $buildLog -notmatch 'Keybinder\.vcxproj -> .*Keybinder\.asi' -or $buildLog -match ': (fatal )?error [A-Z]+\d+:') {
+    throw 'Erfolgreicher finaler Release-Build nicht bestätigt.'
+}
+
+$packageDirectory = Join-Path $projectRoot 'dist\NLBinder-0.1.1-r8'
+$archive = Join-Path $projectRoot 'dist\NLBinder-v0.1.1-KOBiRO-r8.zip'
+if ((Test-Path -LiteralPath $packageDirectory) -or (Test-Path -LiteralPath $archive)) {
+    throw 'r8-Paket existiert bereits; nicht automatisch überschreiben.'
+}
+New-Item -ItemType Directory -Path $packageDirectory | Out-Null
+Copy-Item -LiteralPath $binary -Destination (Join-Path $packageDirectory 'Keybinder.asi')
+Copy-Item -LiteralPath (Join-Path $projectRoot 'docs\NLBinder-0.1.1-r8-DE.md') -Destination (Join-Path $packageDirectory 'LIESMICH.md')
+Copy-Item -LiteralPath (Join-Path $projectRoot 'docs\jobs-support.md') -Destination (Join-Path $packageDirectory 'JOB-HINWEISE.md')
+Copy-Item -LiteralPath $reportPath -Destination (Join-Path $packageDirectory 'PRUEFBERICHT.json')
+Copy-Item -LiteralPath $workerPath -Destination (Join-Path $packageDirectory 'RECONNECT-TEST.json')
+
+# Ship only empty weapon folders and instructions, never personal PNG files.
+$catalogSource = Get-Content -LiteralPath (Join-Path $projectRoot 'include\WeaponIconCatalog.h') -Raw
+$weaponFolderNames = @([regex]::Matches($catalogSource, '\{\s*\d+,\s*"[^"]+",\s*"([^"]+)"\s*\}') | ForEach-Object { $_.Groups[1].Value })
+if ($weaponFolderNames.Count -ne 43 -or @($weaponFolderNames | Sort-Object -Unique).Count -ne 43) { throw 'Der Waffenordner-Katalog ist unvollständig oder doppelt.' }
+$templateRoot = Join-Path $packageDirectory 'NLBinder\Waffenicons'
+New-Item -ItemType Directory -Path $templateRoot | Out-Null
+foreach ($folderName in $weaponFolderNames) {
+    if ($folderName -notmatch '^[A-Za-z0-9 -]+$') { throw 'Ungültiger Waffenordner im Katalog.' }
+    New-Item -ItemType Directory -Path (Join-Path $templateRoot $folderName) | Out-Null
+}
+@'
+# Eigene Waffenicons
+
+Den Vorlagenordner NLBinder nach Dokumente/GTA San Andreas User Files kopieren
+und dort mit dem bestehenden NLBinder-Ordner zusammenführen. Vorhandene eigene
+Bilder beibehalten. Die Waffenbilder liegen unter:
+Dokumente/GTA San Andreas User Files/NLBinder/Waffenicons/<Waffe>/
+PNG-Dateien in den passenden Unterordner legen, z.B. Desert Eagle/mein-icon.png.
+Am einfachsten im Binder unter Mods / Waffenicons auf 'Waffenicons-Ordner öffnen'
+klicken: So wird auch ein verschobener Dokumente-Ordner, etwa unter OneDrive,
+korrekt geöffnet. Danach Waffenicons aktivieren und bei Bedarf neu einlesen.
+Mehrere PNGs pro Waffe sind möglich; ohne PNG bleibt das originale Waffenicon.
+Die Fist wird weiterhin unter Mods / Hud eingerichtet.
+'@ | Set-Content -LiteralPath (Join-Path $templateRoot 'LIESMICH.md') -Encoding utf8
+
+$buildInfo = @"
+NLBinder v.0.1.1 by KOBiRO – Überarbeitung 8
+Erstellt: $([System.TimeZoneInfo]::ConvertTimeBySystemTimeZoneId([DateTime]::UtcNow, 'W. Europe Standard Time').ToString('dd.MM.yyyy HH:mm:ss')) (Europe/Berlin)
+Datei: Keybinder.asi
+Format: Win32 Release, PE32/x86 DLL
+Größe: $($report.bytes) Bytes
+SHA256: $binaryHash
+Eingebetteter Reconnect-Helfer: Ressource 300, $($report.embedded_helper_bytes) Bytes
+Helfer-SHA256: $($report.helper_sha256)
+
+Verifikation:
+- Vollständige automatisierte Tests: Exitcode 0
+- Release-Build: Exitcode 0
+- ASI-Format, Windows-Imports und eingebetteter Helfer geprüft
+- Eingebetteter Reconnect-Helfer stimmt mit dem geprüften Helfer überein
+- Nativer Reconnect-Helfer: $($workerResult.checks) Prüfungen, 0 Fehler
+- Dafür ausschließlich harmlose Testprozesse verwendet
+- Kein echtes Spiel und kein installierter Launcher gestartet oder beendet
+- Kein Ingame-Test durchgeführt
+
+Neue Änderungen:
+- Eigene Kategorie Mods / Interface neben Waffenicons
+- Einzelne Positions- und Farboptionen für native HUD-Elemente
+- Leben, Rüstung, Atemluft, Geld, Uhrzeit, Waffenicon, Munition und Wanted-Sterne
+- Fahrzeugname, Gebietsname und Minimap
+- Verschieben per Maus mit Speichern über Esc im bisherigen Overlay-Stil
+- Gespeicherte Presets und getrennte Wiederherstellung von Position und Farbe
+
+Die früheren Job-, Skilltree-, Fraktions-, Radar-, Tacho- und Reconnect-
+Anpassungen sind enthalten. Die ursprüngliche Oberfläche bleibt Grundlage.
+Der Reconnect-Helfer ist in der ASI enthalten.
+
+Grenzen: Die Synchronisation wartet auf eine echte Serverantwort. Mehrere
+Schadensereignisse zwischen Messungen erscheinen als gemessener Gesamtverlust.
+Ein Live-Test mit dem konkreten Server und Launcher steht weiterhin aus.
+Installation und weitere Hinweise stehen in LIESMICH.md.
+"@
+$buildInfo | Set-Content -LiteralPath (Join-Path $packageDirectory 'BUILD-INFO.txt') -Encoding utf8
+"$binaryHash  Keybinder.asi" | Set-Content -LiteralPath (Join-Path $packageDirectory 'SHA256SUMS.txt') -Encoding ascii
+Compress-Archive -LiteralPath $packageDirectory -DestinationPath $archive -CompressionLevel Optimal
+
+Add-Type -AssemblyName System.IO.Compression.FileSystem
+$templateZip = [System.IO.Compression.ZipFile]::Open($archive, [System.IO.Compression.ZipArchiveMode]::Update)
+try {
+    foreach ($folderName in $weaponFolderNames) {
+        $entryName = 'NLBinder-0.1.1-r8/NLBinder/Waffenicons/' + $folderName + '/'
+        if (-not $templateZip.GetEntry($entryName)) { $null = $templateZip.CreateEntry($entryName) }
+    }
+} finally { $templateZip.Dispose() }
+$zip = [System.IO.Compression.ZipFile]::OpenRead($archive)
+try {
+    $entry = $zip.Entries | Where-Object { $_.FullName -match '/Keybinder\.asi$' }
+    if (@($entry).Count -ne 1) { throw 'ASI fehlt im Archiv oder ist mehrfach enthalten.' }
+    $stream = $entry.Open()
+    $digest = [System.Security.Cryptography.SHA256]::Create()
+    try {
+        $zippedHash = [BitConverter]::ToString($digest.ComputeHash($stream)).Replace('-', '').ToLowerInvariant()
+        if ($zippedHash -ne $binaryHash) { throw 'ASI-Prüfsumme im Archiv stimmt nicht.' }
+    } finally { $stream.Dispose(); $digest.Dispose() }
+} finally { $zip.Dispose() }
+$stagedHash = (Get-FileHash -LiteralPath (Join-Path $packageDirectory 'Keybinder.asi') -Algorithm SHA256).Hash.ToLowerInvariant()
+if ($stagedHash -ne $binaryHash) { throw 'Kopierte ASI stimmt nicht überein.' }
+Get-Item -LiteralPath (Join-Path $packageDirectory 'Keybinder.asi'), $archive | Select-Object FullName,Length
+Write-Output "SHA256: $binaryHash"
diff --git a/tools/prepare_github_review.py b/tools/prepare_github_review.py
new file mode 100644
index 0000000..141fb7f
--- /dev/null
+++ b/tools/prepare_github_review.py
@@ -0,0 +1,135 @@
+"""Prepare auditable source snapshots; never reads credentials or pushes Git.
+
+The original ZIP is read only. Personal runtime files, nested Git metadata and
+compiler output are excluded. The current ASI is copied without modification.
+"""
+from pathlib import Path, PurePosixPath
+import hashlib
+import json
+import os
+import shutil
+import zipfile
+
+ROOT = Path(__file__).resolve().parents[1]
+ORIGINAL = Path.home() / "Downloads/NLBinder-master.zip"
+OUTPUT = ROOT / "build/github-publication"
+BASELINE = OUTPUT / "original"
+CURRENT = OUTPUT / "current"
+EXPECTED_ORIGINAL = "a328e78eea63420e9bfe9c084883100177fe0fd9c2d62c4fcaef38c0a44801e9"
+EXPECTED_ASI = "fc27a8a39fc2f78c40f1b686d5a71dcc0c2956854d1250278a84bd79200c7cef"
+SOURCE_DIRS = {"src", "include", "res", "tests", "tools", "third_party", "docs"}
+ROOT_FILES = {".gitignore", "README.md", "Keybinder.rc", "Keybinder.sln", "Keybinder.vcxproj"}
+EXCLUDED_DIRS = {".git", ".vs", "__pycache__", "output", "debug", "release", "obj", "cmakefiles"}
+EXCLUDED_SUFFIXES = {".obj", ".pdb", ".ilk", ".exp", ".suo", ".user", ".log", ".pyc", ".o"}
+EXCLUDED_NAMES = {"keybinder.json", "jobs_data.json", "imgui.ini", "nul", "keybinder_crash.log"}
+VENDOR_BINARY_SUFFIXES = {".lib", ".exe", ".dll"}
+RELEASE_DIR = Path("dist/NLBinder-0.1.1-r3")
+
+
+def sha(data):
+    return hashlib.sha256(data).hexdigest()
+
+
+def allowed(path):
+    path = PurePosixPath(path)
+    if path.is_absolute() or ".." in path.parts or not path.parts:
+        return False
+    if path.parts[0] not in SOURCE_DIRS and str(path) not in ROOT_FILES:
+        return False
+    if any(part.lower() in EXCLUDED_DIRS for part in path.parts[:-1]):
+        return False
+    if path.name.lower() in EXCLUDED_NAMES or path.suffix.lower() in EXCLUDED_SUFFIXES:
+        return False
+    if path.suffix.lower() in {".asi", ".exe", ".lib", ".dll"}:
+        # Only pre-existing source dependency binaries belong in the tree.
+        return path.parts[0] in {"include", "third_party"}
+    return True
+
+
+def write(path, data):
+    path.parent.mkdir(parents=True, exist_ok=True)
+    path.write_bytes(data)
+
+
+def snapshot_files(directory):
+    return {str(path.relative_to(directory)).replace("\\", "/"): path
+            for path in directory.rglob("*") if path.is_file()}
+
+
+def main():
+    assert sha(ORIGINAL.read_bytes()) == EXPECTED_ORIGINAL, "Original ZIP differs"
+    assert sha((ROOT / RELEASE_DIR / "Keybinder.asi").read_bytes()) == EXPECTED_ASI, "ASI differs"
+    BASELINE.mkdir(parents=True, exist_ok=False)
+    CURRENT.mkdir(parents=True, exist_ok=False)
+    with zipfile.ZipFile(ORIGINAL) as archive:
+        comment = archive.comment.decode("ascii", errors="strict").strip()
+        for entry in archive.infolist():
+            if entry.is_dir():
+                continue
+            path = PurePosixPath(entry.filename)
+            if path.parts[0] != "NLBinder-master":
+                raise ValueError("Unexpected archive root")
+            relative = PurePosixPath(*path.parts[1:])
+            if allowed(relative):
+                write(BASELINE / str(relative), archive.read(entry))
+    for start in SOURCE_DIRS:
+        for current, directories, files in os.walk(ROOT / start):
+            directories[:] = [name for name in directories if name.lower() not in EXCLUDED_DIRS]
+            for name in files:
+                path = Path(current) / name
+                relative = path.relative_to(ROOT).as_posix()
+                if path.is_symlink():
+                    raise ValueError(f"Unexpected symlink: {relative}")
+                if allowed(relative):
+                    write(CURRENT / relative, path.read_bytes())
+    for name in ROOT_FILES:
+        write(CURRENT / name, (ROOT / name).read_bytes())
+    for path in (ROOT / RELEASE_DIR).iterdir():
+        if path.suffix.lower() in {".asi", ".md", ".json", ".txt"}:
+            data = path.read_bytes()
+            if path.name == "PRUEFBERICHT.json":
+                report = json.loads(data)
+                report["asi"] = "Keybinder.asi"  # Avoid publishing machine-specific profile paths.
+                data = (json.dumps(report, indent=2) + "\n").encode()
+            write(CURRENT / RELEASE_DIR / path.name, data)
+    # Preserve the complete original project README when adding the review entry page.
+    write(CURRENT / "docs/ORIGINAL-README.md", (BASELINE / "README.md").read_bytes())
+    write(CURRENT / "docs/BUILD-README.md", (ROOT / "README.md").read_bytes())
+    write(CURRENT / "README.md", (ROOT / "docs/review/README-GITHUB.md").read_bytes())
+    write(CURRENT / ".gitattributes", b"* text=auto\n*.cpp text eol=lf\n*.h text eol=lf\n*.md text eol=lf\n*.json text eol=lf\n*.bat text eol=crlf\n*.asi binary\n*.png binary\n*.ttf binary\n*.lib binary\n*.exe binary\n*.dll binary\n")
+    original_files = snapshot_files(BASELINE)
+    current_files = snapshot_files(CURRENT)
+    changes = []
+    for relative in sorted(original_files.keys() | current_files.keys()):
+        before = original_files[relative].read_bytes() if relative in original_files else None
+        after = current_files[relative].read_bytes() if relative in current_files else None
+        if before == after:
+            continue
+        # Distinguish formatting-only CRLF/LF differences from content changes.
+        formatting_only = before is not None and after is not None and before.replace(b"\r\n", b"\n") == after.replace(b"\r\n", b"\n")
+        changes.append({"path": relative, "status": "added" if before is None else "deleted" if after is None else "modified",
+                        "dependency": relative.startswith(("include/plugin-sdk/", "include/RakHook/")),
+                        "line_endings_only": formatting_only,
+                        "before_sha256": sha(before) if before is not None else None,
+                        "after_sha256": sha(after) if after is not None else None})
+    record = {"original_archive": "NLBinder-master.zip", "original_sha256": EXPECTED_ORIGINAL,
+              "original_archive_commit_comment": comment, "release_asi_sha256": EXPECTED_ASI,
+              "baseline_files": len(original_files), "current_files": len(current_files), "changes": changes}
+    write(CURRENT / "docs/review/SOURCE-COMPARISON.json", (json.dumps(record, indent=2, ensure_ascii=False) + "\n").encode())
+    relevant = [item for item in changes if not item["dependency"] and not item["line_endings_only"]]
+    text = ["# Dateivergleich mit dem Originalarchiv", "",
+            f"Originalarchiv: `{EXPECTED_ORIGINAL}`; Commitkennung im ZIP: `{comment}`.", "",
+            "Alle Dateien einschließlich wiederhergestellter Abhängigkeiten stehen in [SOURCE-COMPARISON.json](SOURCE-COMPARISON.json).",
+            "Reine CRLF/LF-Unterschiede sind dort separat markiert. Diese Liste enthält Inhaltsänderungen außerhalb der beiden wiederhergestellten SDK-Verzeichnisse.", "",
+            "| Status | Datei |", "| --- | --- |"]
+    for item in relevant:
+        path = item["path"]
+        text.append(f"| {item['status']} | [{path}](../../{path}) |")
+    write(CURRENT / "docs/review/DATEIVERGLEICH.md", ("\n".join(text) + "\n").encode())
+    print(json.dumps({"original": str(BASELINE), "current": str(CURRENT), "original_files": len(original_files),
+                      "current_files": len(current_files), "changed_or_added": len(changes),
+                      "non_dependency_content_changes": len(relevant), "archive_comment": comment}, indent=2))
+
+
+if __name__ == "__main__":
+    main()
