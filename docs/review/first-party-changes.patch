diff --git a/include/BrowserSetupProtocol.h b/include/BrowserSetupProtocol.h
new file mode 100644
index 0000000..2bc88df
--- /dev/null
+++ b/include/BrowserSetupProtocol.h
@@ -0,0 +1,18 @@
+#pragma once
+#include <cstdint>
+
+namespace keybinder::browser_setup {
+inline constexpr std::uint32_t kSetupMagic = 0x4E4C4253;
+enum class Phase : std::int32_t { Checking=1, Copying, Downloading, Extracting, Ready, Failed, Cancelled, Committing };
+struct SetupProgress {
+    std::uint32_t magic = kSetupMagic;
+    std::uint32_t bytes = sizeof(SetupProgress);
+    volatile std::int32_t phase = static_cast<std::int32_t>(Phase::Checking);
+    volatile std::int32_t percent = 0;
+    volatile std::int32_t cancel = 0;
+    volatile std::int32_t heartbeat = 0;
+    volatile std::int32_t downloadedKiB = 0;
+    char error[256]{};
+};
+static_assert(sizeof(SetupProgress)==284);
+}
diff --git a/include/CombatChatParser.h b/include/CombatChatParser.h
new file mode 100644
index 0000000..73a4ebe
--- /dev/null
+++ b/include/CombatChatParser.h
@@ -0,0 +1,29 @@
+#pragma once
+
+#include <cstdint>
+#include <string>
+
+namespace killtracker {
+
+enum class CombatChatKind { None, Kill, Death, KillCorroboration };
+enum class CombatChatFamily : std::uint32_t {
+    Murder = 1, PlayerKilled = 2, Gangwar = 4, Criminal = 8,
+    PrisonDestroyed = 16, Territory = 32, TerritoryTeamkill = 64,
+    Streetwar = 128, Deathzone = 256, TerritoryTeamkillAnonymous = 1024
+};
+
+struct CombatChatNotice {
+    CombatChatKind kind = CombatChatKind::None;
+    CombatChatFamily family = CombatChatFamily::PlayerKilled;
+    std::string killer;
+    std::string victim;
+    bool victimKnown = false;
+};
+
+// Only trusted server lines qualify. Local names are compared as whole names;
+// no nickname or regular expression is hard-coded into the patterns.
+CombatChatNotice ParseCombatChat(const std::string& line, const std::string& localName,
+                                bool hasPlayerPrefix = false);
+bool SameCombatPlayerName(const std::string& left, const std::string& right);
+
+} // namespace killtracker
diff --git a/include/DamageRPCAdapter.h b/include/DamageRPCAdapter.h
index d9c0ccb..3a24f29 100644
--- a/include/DamageRPCAdapter.h
+++ b/include/DamageRPCAdapter.h
@@ -44,14 +44,18 @@ public:
     // Check if adapter is initialized
     bool IsInitialized() const { return initialized_.load(); }
 
+#ifdef KEYBINDER_TESTING
+    void ProcessRpcForTesting(RakNet::BitStream* payload);
+#endif
+
 private:
     std::atomic<bool> initialized_;
     std::shared_ptr<DamageAdapterState> state_;
 
     // SA-MP RPC 115 (RPC_GIVETAKEDAMAGE) carries both give and take damage; a
     // leading bool flag (0 = give/outgoing, 1 = take/incoming) selects which.
-    // We hook only outgoing sends; incoming damage is detected from local
-    // health changes (see SAMPBridge::PollLocalIncomingDamage).
+    // Both events are client-sent RPCs. Local health monitoring confirms the
+    // incoming amounts and provides a fallback when the server emits no RPC.
     static const unsigned char RPC_SEND_GIVE_DAMAGE = 115;
 };
 
