index 0000000..b212050
--- /dev/null
+++ b/tools/setup_msvc.bat
@@ -0,0 +1,16 @@
+@echo off
+rem Locate the installed C++ toolchain, including custom installation paths.
+if /i "%VSCMD_ARG_TGT_ARCH%"=="x86" exit /b 0
+set "NLBINDER_VSWHERE=%ProgramFiles(x86)%\Microsoft Visual Studio\Installer\vswhere.exe"
+if not exist "%NLBINDER_VSWHERE%" (
+    echo Visual Studio Installer was not found. Install the Visual Studio C++ Build Tools.
+    exit /b 1
+)
+set "NLBINDER_VS_PATH="
+for /f "usebackq delims=" %%I in (`"%NLBINDER_VSWHERE%" -latest -products * -requires Microsoft.VisualStudio.Component.VC.Tools.x86.x64 -property installationPath`) do set "NLBINDER_VS_PATH=%%I"
+if not defined NLBINDER_VS_PATH (
+    echo No Visual Studio installation with the x86 C++ toolchain was found.
+    exit /b 1
+)
+call "%NLBINDER_VS_PATH%\VC\Auxiliary\Build\vcvarsall.bat" x86 >nul
+exit /b %ERRORLEVEL%
diff --git a/tools/test_reconnect_worker.py b/tools/test_reconnect_worker.py
new file mode 100644
index 0000000..e48098d
--- /dev/null
+++ b/tools/test_reconnect_worker.py
@@ -0,0 +1,127 @@
+"""Exercise only the reconnect helper plus a harmless fixture executable.
+
+The fixture is a fake waiting parent or argv logger, never a game launcher.
+Build tests/ReconnectWorkerFixture.cpp as build/ReconnectWorkerFixture.exe first.
+"""
+import ctypes
+from ctypes import wintypes
+import json
+import os
+from pathlib import Path
+import subprocess
+import time
+import uuid
+
+
+ROOT = Path(__file__).resolve().parents[1]
+HELPER = ROOT / "build/ReconnectHelper.exe"
+FIXTURE = ROOT / "build/ReconnectWorkerFixture.exe"
+OUTPUT = ROOT / "build/reconnect-worker-tests"
+OUTPUT.mkdir(exist_ok=True)
+
+kernel = ctypes.WinDLL("kernel32", use_last_error=True)
+kernel.CreateEventW.argtypes = (wintypes.LPVOID, wintypes.BOOL, wintypes.BOOL, wintypes.LPCWSTR)
+kernel.CreateEventW.restype = wintypes.HANDLE
+kernel.SetEvent.argtypes = (wintypes.HANDLE,)
+kernel.SetEvent.restype = wintypes.BOOL
+kernel.WaitForSingleObject.argtypes = (wintypes.HANDLE, wintypes.DWORD)
+kernel.WaitForSingleObject.restype = wintypes.DWORD
+kernel.CloseHandle.argtypes = (wintypes.HANDLE,)
+kernel.CloseHandle.restype = wintypes.BOOL
+
+checks = 0
+
+
+def check(value, message):
+    global checks
+    checks += 1
+    if not value:
+        raise AssertionError(message)
+
+
+def event(name):
+    handle = kernel.CreateEventW(None, True, False, name)
+    if not handle:
+        raise ctypes.WinError(ctypes.get_last_error())
+    return handle
+
+
+def spawn(arguments, **kwargs):
+    return subprocess.Popen([str(value) for value in arguments],
+                            creationflags=subprocess.CREATE_NO_WINDOW, **kwargs)
+
+
+def stop_owned(process):
+    if process is not None and process.poll() is None:
+        process.terminate()
+        process.wait(timeout=5)
+
+
+def run_case(ready_exists):
+    suffix = uuid.uuid4().hex
+    ready_name = "Local\\NLBinderWorkerTestReady-" + suffix
+    exit_name = "Local\\NLBinderWorkerTestExit-" + suffix
+    ready = event(ready_name) if ready_exists else None
+    parent_exit = event(exit_name)
+    log = OUTPUT / (suffix + ".argv.txt")
+    parent = worker = None
+    try:
+        parent = spawn([FIXTURE, "--fixture-parent", exit_name])
+        check(parent.poll() is None, "Fixture parent must be alive")
+        expected_arguments = ["-h", "127.0.0.1", "-p", "7777", "-n", "[RCB]Fixture",
+                              "-g", "C:\\Harmless Test Game Path\\", 'quoted\\"argument']
+        environment = dict(os.environ, NLBINDER_TEST_LAUNCH_LOG=str(log))
+        worker = spawn([HELPER, "--parent", parent.pid, "--ready", ready_name,
+                        "--mode", "openmp", "--launcher", FIXTURE,
+                        "--working-directory", OUTPUT, *expected_arguments], env=environment)
+        if ready_exists:
+            check(kernel.WaitForSingleObject(ready, 4000) == 0, "Helper must signal readiness")
+            check(parent.poll() is None, "Readiness must precede parent exit")
+            time.sleep(0.3)
+            check(worker.poll() is None, "Helper must wait while parent is alive")
+            check(not log.exists(), "Launcher must not start before parent exit")
+        else:
+            check(worker.wait(timeout=5) == 3, "Missing ready event must fail closed")
+            check(not log.exists(), "Readiness failure must not launch fixture")
+
+        check(bool(kernel.SetEvent(parent_exit)), "Fixture exit event must be signaled")
+        check(parent.wait(timeout=5) == 0, "Fixture parent must exit normally")
+        if ready_exists:
+            check(worker.wait(timeout=5) == 0, "Ready worker must launch after parent exits")
+            deadline = time.monotonic() + 5
+            while not log.exists() and time.monotonic() < deadline:
+                time.sleep(0.01)
+            check(log.exists(), "Dummy launcher must write argv log")
+            # Fixture writes and closes a small UTF-16 file immediately.
+            deadline = time.monotonic() + 2
+            actual_arguments = []
+            while time.monotonic() < deadline:
+                try:
+                    actual_arguments = log.read_text(encoding="utf-16").splitlines()
+                    if actual_arguments:
+                        break
+                except (OSError, UnicodeError):
+                    pass
+                time.sleep(0.01)
+            check(actual_arguments == [str(FIXTURE), *expected_arguments], "Launcher argv must round-trip exactly")
+        else:
+            time.sleep(0.1)
+            check(not log.exists(), "Failed readiness must remain cancelled after parent exit")
+    finally:
+        kernel.SetEvent(parent_exit)
+        stop_owned(worker)
+        stop_owned(parent)
+        if ready:
+            kernel.CloseHandle(ready)
+        kernel.CloseHandle(parent_exit)
+
+
+check(HELPER.is_file() and FIXTURE.is_file(), "Built helper and fixture are required")
+invalid = spawn([HELPER])
+check(invalid.wait(timeout=5) == 2, "Invalid helper arguments must return 2")
+run_case(True)
+run_case(False)
+result = {"checks": checks, "failures": 0,
+          "scope": "Harmless fixture processes only; no game or installed launcher executed"}
+(OUTPUT / "result.json").write_text(json.dumps(result, indent=2) + "\n", encoding="utf-8")
+print(json.dumps(result, indent=2))
diff --git a/tools/verify_revision4_artifact.py b/tools/verify_revision4_artifact.py
new file mode 100644
index 0000000..f60c5e6
--- /dev/null
+++ b/tools/verify_revision4_artifact.py
@@ -0,0 +1,115 @@
+"""Read-only r4 PE/artifact verification; never loads or executes binaries."""
+import hashlib
+import json
+from pathlib import Path
+import struct
+import sys
+
+
+def require(condition, message):
+    if not condition:
+        raise ValueError(message)
+
+
+class PE:
+    def __init__(self, path):
+        self.path = Path(path)
+        self.data = self.path.read_bytes()
+        require(self.data[:2] == b"MZ", "Missing DOS header")
+        start = self.u32(0x3C)
+        require(self.data[start:start + 4] == b"PE\0\0", "Missing PE signature")
+        self.machine = self.u16(start + 4)
+        count = self.u16(start + 6)
+        self.characteristics = self.u16(start + 22)
+        self.optional = start + 24
+        require(self.u16(self.optional) == 0x10B, "Expected PE32")
+        self.sections = []
+        table = self.optional + self.u16(start + 20)
+        for index in range(count):
+            row = table + index * 40
+            virtual_size, rva, size, raw = struct.unpack_from("<IIII", self.data, row + 8)
+            self.sections.append((rva, max(virtual_size, size), raw, size))
+
+    def u16(self, offset):
+        return struct.unpack_from("<H", self.data, offset)[0]
+
+    def u32(self, offset):
+        return struct.unpack_from("<I", self.data, offset)[0]
+
+    def offset(self, rva):
+        for start, span, raw, size in self.sections:
+            if start <= rva < start + span:
+                require(rva - start < size, "RVA has no raw file data")
+                return raw + rva - start
+        raise ValueError(f"Unmapped RVA: {rva:#x}")
+
+    def imports(self):
+        directory = self.u32(self.optional + 96 + 8)
+        if not directory:
+            return []
+        row = self.offset(directory)
+        result = []
+        while any(struct.unpack_from("<IIIII", self.data, row)):
+            name = self.offset(self.u32(row + 12))
+            end = self.data.index(0, name)
+            result.append(self.data[name:end].decode("ascii"))
+            row += 20
+        return sorted(result, key=str.lower)
+
+    def resource(self, type_id, resource_id):
+        base = self.offset(self.u32(self.optional + 96 + 16))
+
+        def entries(relative):
+            head = base + relative
+            total = self.u16(head + 12) + self.u16(head + 14)
+            return [struct.unpack_from("<II", self.data, head + 16 + i * 8) for i in range(total)]
+
+        directory = 0
+        for expected in (type_id, resource_id):
+            candidates = [value for name, value in entries(directory) if name == expected]
+            require(len(candidates) == 1, f"Resource ID {expected} missing or ambiguous")
+            require(candidates[0] & 0x80000000, "Expected resource directory")
+            directory = candidates[0] & 0x7FFFFFFF
+        languages = entries(directory)
+        require(len(languages) == 1, "Expected one embedded worker language")
+        leaf = languages[0][1]
+        require(not leaf & 0x80000000, "Expected resource data entry")
+        rva, size = struct.unpack_from("<II", self.data, base + leaf)
+        start = self.offset(rva)
+        return self.data[start:start + size]
+
+
+def main():
+    root = Path(__file__).resolve().parents[1]
+    asi = PE(sys.argv[1] if len(sys.argv) > 1 else root / "build/Release/Keybinder.asi")
+    helper = PE(root / "build/ReconnectHelper.exe")
+    require(asi.machine == helper.machine == 0x14C, "Expected both binaries to be x86")
+    require(asi.characteristics & 0x2000, "ASI must be a DLL")
+    require(not helper.characteristics & 0x2000, "Worker must be an executable")
+    require(asi.resource(10, 300) == helper.data, "Embedded helper differs from built helper")
+    imports = asi.imports()
+    require(not any(name.lower().startswith(("vcruntime", "msvcp", "ucrtbased")) for name in imports),
+            "Unexpected external C++ runtime dependency")
+    try:
+        display_path = asi.path.resolve().relative_to(root).as_posix()
+    except ValueError:
+        display_path = asi.path.name
+    result = {
+        "revision": "v0.1.1-r4",
+        "asi": display_path,
+        "bytes": len(asi.data),
+        "format": "PE32 x86 DLL",
+        "sha256": hashlib.sha256(asi.data).hexdigest(),
+        "imports": imports,
+        "embedded_helper_id": 300,
+        "embedded_helper_bytes": len(helper.data),
+        "helper_sha256": hashlib.sha256(helper.data).hexdigest(),
+        "embedded_helper_matches": True,
+    }
+    report = json.dumps(result, indent=2)
+    (root / "build/revision4-artifact.json").write_text(report + "\n", encoding="utf-8")
+    print(report)
+
+
+if __name__ == "__main__":
+    main()
