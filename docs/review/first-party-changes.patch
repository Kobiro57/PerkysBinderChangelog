+    hooks.getTickCount = [&]() { return now; };
+    hooks.getDriverVehicle = [&](unsigned short& id, bool& running) { id = vehicle; running = engineOn; return driver; };
+    hooks.isEngineInputAvailable = [&]() { return inputAvailable; };
