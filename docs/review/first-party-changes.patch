+            input.currentGearMinSpeedKmh = gear.m_fChangeDownVelocity * kSpeedMultiplierKmh;
+            input.currentGearMaxSpeedKmh = gear.m_fMaxVelocity * kSpeedMultiplierKmh;
+        }
+    }
+    return result;
+}
