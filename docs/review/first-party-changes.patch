+    engineOn = true;
+    now = 6000;
+    bridge.Update();
+    ASSERT_EQ(keyStates.size(), std::size_t(2));
+    vehicle = 11;
+    bridge.Update();
+    now = 8000;
+    bridge.Update();
+    ASSERT_EQ(keyStates.size(), std::size_t(2)); // running engine must not be toggled off
+    engineOn = false;
+    vehicle = 12;
+    inputAvailable = false;
+    bridge.Update();
+    now = 10000;
+    bridge.Update();
+    ASSERT_EQ(keyStates.size(), std::size_t(2)); // chat/cursor/focus gating
+    inputAvailable = true;
