+    SAMPBridge::SetTestingHooks(context.Hooks());
+    SAMPBridge bridge;
+    CHECK(bridge.Initialize());
+    bridge.Update();
+    std::string error;
+    CHECK(!bridge.RequestManualStateSynchronization(error) && !error.empty()); // Active login sync.
+    CHECK(CompleteFreshSyncDialogs(bridge, context, 10, 3, 20));
+    const auto commandsBefore = context.commands.size();
+    keybinder::MainWindowUI ui;
+    ui.SetSAMPBridge(&bridge);
+    context.dialog.get()->m_bIsActive = TRUE;
+    CHECK(!ui.RequestManualStateSynchronization() && !ui.WasCloseRequested());
+    context.dialog.get()->m_bIsActive = FALSE;
+    context.input.get()->m_bEnabled = TRUE;
+    CHECK(!ui.RequestManualStateSynchronization() && !ui.WasCloseRequested());
+    context.input.get()->m_bEnabled = FALSE;
+    CHECK(bridge.BeginManualTextInput());
+    CHECK(!bridge.RequestManualStateSynchronization(error));
+    bridge.CancelManualTextInput();
+    context.local.get()->m_bIsWasted = TRUE;
+    CHECK(!ui.RequestManualStateSynchronization() && !ui.WasCloseRequested());
+    context.local.get()->m_bIsWasted = FALSE;
+    context.network.get()->m_nGameState = sampapi::v03dl::CNetGame::GAME_MODE_RESTARTING;
+    CHECK(!ui.RequestManualStateSynchronization() && !ui.WasCloseRequested());
+    context.network.get()->m_nGameState = sampapi::v03dl::CNetGame::GAME_MODE_CONNECTED;
+    CHECK(context.commands.size() == commandsBefore && !bridge.IsManualStateSynchronizationPending());
+    context.game.get()->m_nCursorMode = 2;
+    CHECK(ui.RequestManualStateSynchronization() && ui.WasCloseRequested());
+    ui.ResetCloseRequest();
+    CHECK(!ui.RequestManualStateSynchronization() && !ui.WasCloseRequested());
+    CHECK(context.commands.size() == commandsBefore);
+    context.game.get()->m_nCursorMode = 0;
+    bridge.Update();
+    CHECK(context.commands.size() == commandsBefore + 1);
+    context.network.get()->m_nGameState = sampapi::v03dl::CNetGame::GAME_MODE_RESTARTING;
+    bridge.Update();
+    CHECK(!bridge.IsManualStateSynchronizationPending() && ManualSyncSuccessNotices(context) == 0);
+    CHECK(bridge.GetTotalKills() == 10);
+    bridge.Shutdown();
+    SAMPBridge::ResetTestingHooks();
+}
+
+void TestManualSyncChatCountersAreImportedWithoutArtificialSessionEvents() {
+    Context context;
+    context.ready = context.jobSkillsReady = true;
+    SAMPBridge::SetTestingHooks(context.Hooks());
+    SAMPBridge bridge;
+    bridge.SetKillTrackerEnabled(true);
+    bridge.SetKillTrackerServerKillMessageEnabled(true);
+    bridge.SetKillTrackerServerKillMessageTemplate("/f must-not-send-for-import");
+    CHECK(bridge.Initialize());
+    bridge.Update();
+    CHECK(CompleteFreshSyncDialogs(bridge, context, 10, 3, 20));
+    std::string error;
+    CHECK(bridge.RequestManualStateSynchronization(error));
+    bridge.Update();
+    CHECK(!bridge.ProcessIncomingChatLineForTesting(nullptr, "*** SyncPlayer ***"));
+    CHECK(!bridge.ProcessIncomingChatLineForTesting(nullptr,
+        "Kills: [11] Tode: [4] Fraktion: [Zivilist] Gang: [-]"));
+    bridge.Update();
+    CHECK(bridge.GetTotalKills() == 11 && bridge.GetTotalDeaths() == 4);
+    CHECK(bridge.GetKillTracker()->GetSessionKills() == 0 && bridge.GetKillTracker()->GetSessionDeaths() == 0);
+    CHECK(context.commands == (std::vector<std::string>{"/stats", "/jobskills", "/stats", "/jobskills"}));
+    CHECK(bridge.IsManualStateSynchronizationPending() && ManualSyncSuccessNotices(context) == 0);
+    CHECK(DeliverDialog(bridge, context, 801, 5, "Jobs \xBB Skill\xFC" "bersicht",
+        TestGameEncoding(ManualSyncSkillsTable(bridge, 21))));
+    bridge.Update();
+    CHECK(ManualSyncSuccessNotices(context) == 1 && !bridge.IsManualStateSynchronizationPending());
+    CHECK(context.messages.empty());
+    bridge.Shutdown();
+    SAMPBridge::ResetTestingHooks();
+}
+
+void TestManualSyncCannotCompleteAcrossPlayerIdentityChange() {
+    Context context;
+    context.ready = context.jobSkillsReady = true;
+    SAMPBridge::SetTestingHooks(context.Hooks());
+    SAMPBridge bridge;
+    CHECK(bridge.Initialize());
+    bridge.Update();
+    CHECK(CompleteFreshSyncDialogs(bridge, context, 10, 3, 20));
+    std::string error;
+    CHECK(bridge.RequestManualStateSynchronization(error));
+    bridge.Update();
+    context.name = "NextPlayer";
+    bridge.ProcessStatsDialogForTesting({899, 0, "Statistiken", "Name: SyncPlayer\nKills: 999\nTode: 999"});
+    bridge.Update();
+    CHECK(!bridge.IsManualStateSynchronizationPending() && ManualSyncSuccessNotices(context) == 0);
+    CHECK(!bridge.AreStatsSynchronized() && bridge.GetTotalKills() == 10);
+    CHECK(context.commands == (std::vector<std::string>{"/stats", "/jobskills", "/stats", "/stats"}));
+    CHECK(CompleteFreshSyncDialogs(bridge, context, 15, 8, 30));
+    CHECK(bridge.GetSynchronizedStats().playerName == "NextPlayer");
+    CHECK(bridge.GetTotalKills() == 15 && ManualSyncSuccessNotices(context) == 0);
+    bridge.Shutdown();
+    SAMPBridge::ResetTestingHooks();
+}
+
+void TestManualSyncPreservesRealEventsConfirmedAfterTheRequest() {
+    Context context;
+    context.ready = context.jobSkillsReady = true;
+    SAMPBridge::SetTestingHooks(context.Hooks());
+    SAMPBridge bridge;
+    bridge.SetKillTrackerEnabled(true);
+    bridge.SetKillTrackerServerKillMessageEnabled(false);
+    CHECK(bridge.Initialize());
+    bridge.Update();
+    CHECK(CompleteFreshSyncDialogs(bridge, context, 10, 3, 20));
+    for (int i = 0; i < 3; ++i) { context.now += 400; bridge.Update(); }
+    std::string error;
+    CHECK(bridge.RequestManualStateSynchronization(error));
+    bridge.Update();
+    bridge.ProcessDeathMessageForTesting({5, 9, 31, std::time(nullptr), true});
+    bridge.ProcessDeathMessageForTesting({8, 5, 31, std::time(nullptr), true});
+    CHECK(bridge.GetTotalKills() == 11 && bridge.GetTotalDeaths() == 3);
+    CHECK(bridge.GetKillTracker()->GetSessionDeaths() == 0); // Native victim RPCs do not count.
+    bridge.ProcessIncomingChatLineForTesting(nullptr,
+        "Willkommen auf dem Friedhof. Hier verweilst du, bis du entweder reanimiert wirst oder deine Zeit abl\xC3\xA4uft.");
+    bridge.Update();
+    CHECK(bridge.GetTotalDeaths() == 3); // Cemetery chat is never a live event.
+    context.deathHealth = 0.0f;
+    bridge.Update(); // The actual native death is confirmed after the sync request.
+    CHECK(bridge.GetTotalKills() == 11 && bridge.GetTotalDeaths() == 4);
+    CHECK(bridge.GetKillTracker()->GetSessionKills() == 1 && bridge.GetKillTracker()->GetSessionDeaths() == 1);
+    CHECK(CompleteFreshSyncDialogs(bridge, context, 10, 3, 21)); // Reply created before the real events.
+    CHECK(bridge.GetTotalKills() == 11 && bridge.GetTotalDeaths() == 4);
+    CHECK(context.commands == (std::vector<std::string>{"/stats", "/jobskills", "/stats", "/jobskills"}));
+    CHECK(ManualSyncSuccessNotices(context) == 1 && !bridge.IsManualStateSynchronizationPending());
+    bridge.ProcessDeathMessageForTesting({5, 11, 31, std::time(nullptr), true});
+    CHECK(bridge.GetTotalKills() == 12 && bridge.GetKillTracker()->GetSessionKills() == 2);
+    context.now += 9000;
+    for (int i = 0; i < 4; ++i) bridge.Update(); // Unchanged collector is never reimported later.
+    CHECK(bridge.GetTotalKills() == 12 && bridge.GetTotalDeaths() == 4);
+    CHECK(bridge.GetKillTracker()->GetSessionKills() == 2 && bridge.GetKillTracker()->GetSessionDeaths() == 1);
+    CHECK(ManualSyncSuccessNotices(context) == 1);
+    bridge.Shutdown();
+    SAMPBridge::ResetTestingHooks();
+}
+
+} // namespace
+
+int RunStartupStatsSyncTests() {
+    checks = failures = 0;
+    TestOneFastRequestImportsBaselineAndPreservesChatChannelForSimulation();
+    TestTimeoutDoesNotSpamOrClaimSuccessAndReconnectCanSyncAgain();
+    TestOnlyAnIdentifiedOwnStatsDialogCloses();
+    TestStatsCacheRoundTripAndOldConfigurations();
+    TestAllStatsDialogStylesImportCloseAndSendRealTotalInSameFrame();
+    TestManualStatsRecoversAfterTimeoutAndOtherDialogsStayOpen();
+    TestObservedNovaScreenshotLayoutThroughCompressedRpcWithDynamicPlayerName();
+    TestSpeedCommandPerformsThreeExactDialogRepliesAndSubmitsOnlyOnce();
+    TestStartupSynchronizesStatsThenJobSkillsAndKeepsExistingEarnings();
+    TestManualFullSyncReusesPipelineAndImportsFreshValuesWithoutNewKills();
+    TestManualSyncTimeoutPreservesValuesAndCanBeRetried();
+    TestManualSyncSaveFailureDoesNotClaimSuccessOrFetchJobSkills();
+    TestManualSyncRequestRejectsBusyOrOfflineAndUiClosesOnlyWhenAccepted();
+    TestManualSyncChatCountersAreImportedWithoutArtificialSessionEvents();
+    TestManualSyncCannotCompleteAcrossPlayerIdentityChange();
+    TestManualSyncPreservesRealEventsConfirmedAfterTheRequest();
+    std::printf("StartupStatsSyncTests: %d checks, %d failures\n", checks, failures);
+    return failures;
+}
diff --git a/tests/StatsDialogRPCAdapterTests.cpp b/tests/StatsDialogRPCAdapterTests.cpp
new file mode 100644
index 0000000..3ab1df3
--- /dev/null
+++ b/tests/StatsDialogRPCAdapterTests.cpp
@@ -0,0 +1,114 @@
+#include "../include/StatsDialogRPCAdapter.h"
+#include "../include/RakHook/include/RakNet/BitStream.h"
+#include "../include/RakHook/include/RakNet/StringCompressor.h"
+
+#include <cstdio>
+#include <string>
+#include <vector>
+
+namespace {
+int checks = 0, failures = 0;
+#define CHECK(value) do { ++checks; if (!(value)) { ++failures; std::printf("[FAIL] StatsDialogRPC: %s (line %d)\n", #value, __LINE__); return; } } while (0)
+
+void WriteByteString(RakNet::BitStream& payload, const std::string& text) {
+    payload.Write(static_cast<unsigned char>(text.size()));
+    if (!text.empty()) payload.Write(text.data(), static_cast<int>(text.size()));
+}
+
+void WriteDialog(RakNet::BitStream& payload, unsigned char style, const std::string& caption,
+                 const std::string& body, unsigned short id = 104) {
+    payload.Write(id);
+    payload.Write(style);
+    WriteByteString(payload, caption);
+    WriteByteString(payload, "Schliessen");
+    WriteByteString(payload, "");
+    StringCompressor::Instance()->EncodeString(body.c_str(), 0, &payload);
+}
+
+void TestAllReadOnlyDialogStylesDeliverFullCompressedTextAndPreserveOffset() {
+    keybinder::StatsDialogRPCAdapter adapter;
+    std::vector<keybinder::StatsDialogEvent> events;
+    adapter.SetDialogCallback([&](const auto& event) { events.push_back(event); });
+    CHECK(adapter.Initialize());
+    const std::string body = "Wert\tStand\nKills\t123\nTode\t45\nBargeld\t1.234$\nKontostand\t5.678$\n" + std::string(6000, 'a');
+    for (unsigned char style : {0, 1, 2, 4, 5}) {
+        RakNet::BitStream payload;
+        payload.Write(true); payload.Write(false); payload.Write(true);
+        const int start = payload.GetNumberOfBitsUsed();
+        WriteDialog(payload, style, "{FFFFFF}Statistik von Fixture_Player", body);
+        payload.SetReadOffset(start);
+        CHECK(adapter.ProcessRpcForTesting(61, &payload));
+        CHECK(payload.GetReadOffset() == start);
+        CHECK(events.back().id == 104 && events.back().style == style);
+        CHECK(events.back().caption == "{FFFFFF}Statistik von Fixture_Player");
+        CHECK(events.back().text == body);
+    }
+    CHECK(events.size() == 5);
+    adapter.Shutdown();
+}
+
+void TestMalformedTruncatedAndInputPayloadsDoNotDeliverOrConsume() {
+    keybinder::StatsDialogRPCAdapter adapter;
+    int delivered = 0;
+    adapter.SetDialogCallback([&](const auto&) { ++delivered; });
+    CHECK(adapter.Initialize());
+    CHECK(!adapter.ProcessRpcForTesting(61, nullptr));
+    RakNet::BitStream complete;
+    WriteDialog(complete, 4, "Statistik", "Kills\t12\nTode\t4");
+    const int completeBits = complete.GetNumberOfBitsUsed();
+    for (int bits = 0; bits < completeBits; ++bits) {
+        RakNet::BitStream truncated(complete.GetData(), complete.GetNumberOfBytesUsed(), true);
+        truncated.SetWriteOffset(bits);
+        CHECK(!adapter.ProcessRpcForTesting(61, &truncated));
+        CHECK(truncated.GetReadOffset() == 0);
+    }
+    for (unsigned char style : {3, 6, 255}) {
+        RakNet::BitStream payload;
+        WriteDialog(payload, style, "Statistik", "Kills: [12]");
+        CHECK(!adapter.ProcessRpcForTesting(61, &payload));
+        CHECK(payload.GetReadOffset() == 0);
+    }
+    CHECK(!adapter.ProcessRpcForTesting(93, &complete));
+    CHECK(complete.GetReadOffset() == 0 && delivered == 0);
+    RakNet::BitStream closeDialog;
+    WriteDialog(closeDialog, 0, "", "", 0xFFFF);
+    CHECK(!adapter.ProcessRpcForTesting(61, &closeDialog));
+    CHECK(closeDialog.GetReadOffset() == 0);
+    RakNet::BitStream embeddedNull;
+    WriteDialog(embeddedNull, 0, std::string("Stats\0foreign", 13), "Kills: [12]");
+    CHECK(!adapter.ProcessRpcForTesting(61, &embeddedNull));
+    CHECK(delivered == 0);
+}
+
+void TestLifecycleNeverDeliversAfterShutdownAndSupportsReinitialize() {
+    keybinder::StatsDialogRPCAdapter adapter;
+    int delivered = 0;
+    adapter.SetDialogCallback([&](const auto&) { ++delivered; });
+    RakNet::BitStream noPayload;
+    CHECK(!adapter.ProcessRpcForTesting(61, &noPayload));
+    CHECK(adapter.Initialize());
+    CHECK(adapter.Initialize());
+    RakNet::BitStream payload;
+    WriteDialog(payload, 0, "Stats", "Kills: [12]");
+    CHECK(adapter.ProcessRpcForTesting(61, &payload));
+    CHECK(delivered == 1);
+    adapter.Shutdown();
+    CHECK(!adapter.ProcessRpcForTesting(61, &payload));
+    CHECK(delivered == 1 && payload.GetReadOffset() == 0);
+    adapter.Shutdown();
+    adapter.SetDialogCallback([&](const auto&) { delivered += 10; });
+    CHECK(adapter.Initialize());
+    CHECK(adapter.ProcessRpcForTesting(61, &payload));
+    CHECK(delivered == 11);
+    adapter.Shutdown();
+}
+} // namespace
+
+int RunStatsDialogRPCAdapterTests() {
+    checks = failures = 0;
+    TestAllReadOnlyDialogStylesDeliverFullCompressedTextAndPreserveOffset();
+    TestMalformedTruncatedAndInputPayloadsDoNotDeliverOrConsume();
+    TestLifecycleNeverDeliversAfterShutdownAndSupportsReinitialize();
+    std::printf("StatsDialogRPCAdapterTests: %d checks, %d failures\n", checks, failures);
+    return failures;
+}
diff --git a/tests/WeaponIconManagerTests.cpp b/tests/WeaponIconManagerTests.cpp
new file mode 100644
index 0000000..fd49b20
--- /dev/null
+++ b/tests/WeaponIconManagerTests.cpp
@@ -0,0 +1,181 @@
+#include "../include/WeaponIconManager.h"
+#include "../include/PersistentPaths.h"
+
+#include <cstdio>
+#include <cstdint>
+#include <set>
+#include <string>
+#include <vector>
+#include <windows.h>
+
+namespace {
+int checks = 0, failures = 0;
+#define CHECK(value) do { ++checks; if (!(value)) { ++failures; std::printf("[FAIL] WeaponIcons: %s (line %d)\n", #value, __LINE__); return; } } while (0)
+
+struct TestAssets {
+    std::vector<std::string> files;
+    bool Add(const char* filename, int weapon = 24) {
+        const auto* definition = keybinder::FindWeaponIconDefinition(weapon);
+        if (!definition) return false;
+        const std::string directory = keybinder::PersistentPaths::WeaponIconsDir() + "\\" + definition->folder;
+        CreateDirectoryA(directory.c_str(), nullptr);
+        const std::string path = directory + "\\" + filename;
+        HANDLE file = CreateFileA(path.c_str(), GENERIC_WRITE, 0, nullptr, CREATE_ALWAYS, FILE_ATTRIBUTE_NORMAL, nullptr);
+        if (file == INVALID_HANDLE_VALUE) return false;
+        // The manager's injected loader owns the test image-decoder decision.
+        const unsigned char pngHeader[] = {0x89, 'P', 'N', 'G', '\r', '\n', 0x1A, '\n'};
+        DWORD written = 0;
+        const bool result = WriteFile(file, pngHeader, sizeof(pngHeader), &written, nullptr) && written == sizeof(pngHeader);
+        CloseHandle(file);
+        files.push_back(path);
+        return result;
+    }
+    ~TestAssets() { for (const auto& file : files) DeleteFileA(file.c_str()); }
+};
+
+struct TextureTracker {
+    int loads = 0, destroyed = 0;
+    std::set<void*> alive;
+    keybinder::WeaponIconManager::TestingHooks Hooks() {
+        keybinder::WeaponIconManager::TestingHooks hooks;
+        hooks.loadTexture = [&](const std::string& path) -> void* {
+            ++loads;
+            if (path.find("broken.png") != std::string::npos) return nullptr;
+            void* texture = reinterpret_cast<void*>(static_cast<uintptr_t>(loads + 100));
+            alive.insert(texture);
+            return texture;
+        };
+        hooks.destroyTexture = [&](void* texture) { if (alive.erase(texture) != 1) ++failures; ++destroyed; };
+        return hooks;
+    }
+};
+
+void TestCatalogAndPathsAreWeaponScoped() {
+    std::set<int> ids;
+    for (const auto& weapon : keybinder::kWeaponIconCatalog) {
+        CHECK(ids.insert(weapon.weaponId).second);
+        CHECK(keybinder::FindWeaponIconDefinition(weapon.weaponId) == &weapon);
+        const std::string path = std::string("Waffenicons\\") + weapon.folder + "\\icon.png";
+        CHECK(keybinder::NormalizeWeaponIconPath(weapon.weaponId, path) == path);
+    }
+    CHECK(ids.size() == 43);
+    for (int invalid : {-1, 0, 19, 20, 21, 47, 54, 100}) CHECK(!keybinder::FindWeaponIconDefinition(invalid));
+    CHECK(keybinder::NormalizeWeaponIconPath(24, "waffenicons/desert eagle/Custom.PNG") == "Waffenicons\\Desert Eagle\\Custom.PNG");
+    for (const char* path : {"C:\\icon.png", "\\server\\icon.png", "../icon.png", "Waffenicons/Desert Eagle/../icon.png",
+        "Waffenicons/Desert Eagle/nested/icon.png", "Waffenicons/M4/icon.png", "Waffenicons/Desert Eagle/icon.jpg",
+        "Waffenicons/Desert Eagle/icon.png ", "Waffenicons/Desert Eagle/icon.png:stream", "Waffenicons/Desert Eagle/.png"})
+        CHECK(keybinder::NormalizeWeaponIconPath(24, path).empty());
+}
+
+void TestAutomaticChoiceExplicitSelectionAndOriginalFallback() {
+    TestAssets assets;
+    TextureTracker textures;
+    keybinder::WeaponIconManager manager;
+    manager.SetTestingHooks(textures.Hooks());
+    manager.Initialize();
+    CHECK(!manager.IsEnabled());
+    CHECK(!manager.IsAppliedForWeapon(24));
+    for (const auto& weapon : keybinder::kWeaponIconCatalog) {
+        const auto path = keybinder::PersistentPaths::WeaponIconsDir() + "\\" + weapon.folder;
+        CHECK(GetFileAttributesA(path.c_str()) != INVALID_FILE_ATTRIBUTES);
+    }
+    CHECK(assets.Add("z_test.png"));
+    CHECK(assets.Add("A_test.PNG"));
+    CHECK(assets.Add("ignored.jpg"));
+    CHECK(assets.Add("m4_test.png", 31));
+    CHECK(manager.RefreshLibrary());
+    const auto files = manager.GetAvailableIcons(24);
+    CHECK(files.size() == 2);
+    CHECK(files.front() == "Waffenicons\\Desert Eagle\\A_test.PNG");
+    CHECK(textures.loads == 0);
+    keybinder::Settings settings;
+    settings.weapon_icons_enabled = true;
+    CHECK(manager.ApplySettings(settings));
+    CHECK(manager.IsAppliedForWeapon(24) && manager.IsAppliedForWeapon(31));
+    CHECK(!manager.IsAppliedForWeapon(0));
+    CHECK(manager.GetConfiguredIcon(24) == files.front());
+    CHECK(textures.loads == 2);
+    CHECK(manager.ApplySettings(settings));
+    CHECK(textures.loads == 2); // unchanged selection reuses the loaded texture
+    settings.weapon_icon_selections = {{24, "Waffenicons/Desert Eagle/z_test.png", true}, {31, "", false}};
+    CHECK(manager.ApplySettings(settings));
+    CHECK(manager.GetConfiguredIcon(24) == "Waffenicons\\Desert Eagle\\z_test.png");
+    CHECK(manager.IsAppliedForWeapon(24) && !manager.IsAppliedForWeapon(31));
+    CHECK(textures.loads == 3 && textures.destroyed == 2);
+    settings.weapon_icon_selections[0].path = "Waffenicons/Desert Eagle/missing.png";
+    CHECK(manager.ApplySettings(settings));
+    CHECK(manager.GetConfiguredIcon(24).empty() && !manager.IsAppliedForWeapon(24));
+    CHECK(textures.alive.empty());
+    settings.weapon_icon_selections = {{24, "Waffenicons/M4/m4_test.png", true}, {31, "", false}};
+    CHECK(manager.ApplySettings(settings));
+    CHECK(!manager.IsAppliedForWeapon(24));
+    manager.Shutdown();
+    CHECK(textures.alive.empty());
+}
+
+void TestDecodeFailureReloadAndDeviceLifetime() {
+    TestAssets assets;
+    TextureTracker textures;
+    keybinder::WeaponIconManager manager;
+    manager.SetTestingHooks(textures.Hooks());
+    manager.Initialize();
+    CHECK(assets.Add("good.png"));
+    CHECK(assets.Add("broken.png"));
+    CHECK(manager.RefreshLibrary());
+    keybinder::Settings settings;
+    settings.weapon_icons_enabled = true;
+    settings.weapon_icon_selections = {{24, "Waffenicons/Desert Eagle/broken.png", true}};
+    CHECK(!manager.ApplySettings(settings));
+    CHECK(!manager.IsAppliedForWeapon(24) && textures.alive.empty());
+    CHECK(!manager.GetLastError().empty());
+    settings.weapon_icon_selections[0].path = "Waffenicons/Desert Eagle/good.png";
+    CHECK(manager.ApplySettings(settings));
+    CHECK(manager.GetLastError().empty() && manager.IsAppliedForWeapon(24));
+    const int loadedBefore = textures.loads;
+    manager.OnDeviceLost();
+    CHECK(!manager.IsAppliedForWeapon(24) && textures.alive.empty());
+    CHECK(!manager.IsDeviceReadyForTesting());
+    CHECK(manager.ApplySettings(settings));
+    CHECK(textures.loads == loadedBefore);
+    manager.OnDeviceReset();
+    CHECK(manager.IsAppliedForWeapon(24) && textures.loads == loadedBefore + 1);
+    CHECK(manager.RefreshLibrary());
+    CHECK(manager.IsAppliedForWeapon(24) && textures.loads == loadedBefore + 2);
+    settings.weapon_icons_enabled = false;
+    CHECK(manager.ApplySettings(settings));
+    CHECK(!manager.IsAppliedForWeapon(24) && textures.alive.empty());
+    manager.Shutdown();
+    CHECK(textures.destroyed == textures.loads - 1); // only the broken image was never created
+}
+
+void TestDeferredSettingsAndMissingFileOnRefresh() {
+    TestAssets assets;
+    TextureTracker textures;
+    keybinder::WeaponIconManager manager;
+    manager.SetTestingHooks(textures.Hooks());
+    keybinder::Settings settings;
+    settings.weapon_icons_enabled = true;
+    settings.weapon_icon_selections = {{24, "Waffenicons/Desert Eagle/deferred.png", true}};
+    CHECK(manager.ApplySettings(settings));
+    CHECK(!manager.IsAppliedForWeapon(24));
+    CHECK(!keybinder::PersistentPaths::EnsureLayout().empty());
+    CHECK(assets.Add("deferred.png"));
+    manager.Initialize();
+    CHECK(manager.IsAppliedForWeapon(24));
+    CHECK(textures.loads == 1);
+    DeleteFileA(assets.files.back().c_str());
+    CHECK(manager.RefreshLibrary());
+    CHECK(!manager.IsAppliedForWeapon(24) && textures.alive.empty());
+    manager.Shutdown();
+}
+} // namespace
+
+int RunWeaponIconManagerTests() {
+    checks = failures = 0;
+    TestCatalogAndPathsAreWeaponScoped();
+    TestAutomaticChoiceExplicitSelectionAndOriginalFallback();
+    TestDecodeFailureReloadAndDeviceLifetime();
+    TestDeferredSettingsAndMissingFileOnRefresh();
+    std::printf("WeaponIconManagerTests: %d checks, %d failures\n", checks, failures);
+    return failures;
+}
diff --git a/tests/WeaponIconSettingsTests.cpp b/tests/WeaponIconSettingsTests.cpp
