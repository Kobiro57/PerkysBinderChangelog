+"""Assemble the real CEF runtime; binaries stay outside the source repository."""
+from pathlib import Path
+import hashlib
+import json
+import os
+import shutil
+
+R=Path(__file__).resolve().parents[1]
+source=R/'build/cef-host/Release'
+target=R/'build/NLBinder/Browser'
+target.mkdir(parents=True,exist_ok=True)
+allowed={'.dll','.pak','.dat','.bin','.json'}
+files=[]
+for path in sorted(source.rglob('*')):
+    if not path.is_file():continue
+    relative=path.relative_to(source)
+    if path.name!='NLBinderBrowser.exe' and path.suffix.lower() not in allowed:continue
+    destination=target/relative
+    destination.parent.mkdir(parents=True,exist_ok=True)
+    if destination.exists() and destination.stat().st_size==path.stat().st_size and os.path.samefile(path,destination):pass
+    else:
+        if destination.exists():destination.unlink()
+        try:os.link(path,destination)
+        except OSError:shutil.copyfile(path,destination)
+    files.append(relative.as_posix())
+cef=Path((R/'build/cef-root.txt').read_text(encoding='utf-8'))
+shutil.copyfile(cef/'LICENSE.txt',target/'CEF-LICENSE.txt')
+if (cef/'README.txt').exists():shutil.copyfile(cef/'README.txt',target/'CEF-README.txt')
+lock=json.loads((R/'tools/cef-runtime.lock.json').read_text(encoding='utf-8'))
+record={'cef_version':lock['version'],'architecture':'x64','sandbox':True,'files':[]}
+for path in sorted(target.rglob('*')):
+    if path.is_file():record['files'].append({'path':path.relative_to(target).as_posix(),'bytes':path.stat().st_size,'sha256':hashlib.file_digest(path.open('rb'),'sha256').hexdigest()})
+(R/'build/revision16-browser-runtime.json').write_text(json.dumps(record,indent=2)+'\n',encoding='utf-8')
+print(json.dumps({'runtime_files':len(record['files']),'runtime_bytes':sum(x['bytes'] for x in record['files'])},indent=2))
diff --git a/tools/prepare_github_review.py b/tools/prepare_github_review.py
new file mode 100644
index 0000000..141fb7f
--- /dev/null
+++ b/tools/prepare_github_review.py
@@ -0,0 +1,135 @@
+"""Prepare auditable source snapshots; never reads credentials or pushes Git.
+
+The original ZIP is read only. Personal runtime files, nested Git metadata and
+compiler output are excluded. The current ASI is copied without modification.
+"""
+from pathlib import Path, PurePosixPath
+import hashlib
+import json
+import os
+import shutil
+import zipfile
+
+ROOT = Path(__file__).resolve().parents[1]
+ORIGINAL = Path.home() / "Downloads/NLBinder-master.zip"
+OUTPUT = ROOT / "build/github-publication"
+BASELINE = OUTPUT / "original"
+CURRENT = OUTPUT / "current"
+EXPECTED_ORIGINAL = "a328e78eea63420e9bfe9c084883100177fe0fd9c2d62c4fcaef38c0a44801e9"
+EXPECTED_ASI = "fc27a8a39fc2f78c40f1b686d5a71dcc0c2956854d1250278a84bd79200c7cef"
+SOURCE_DIRS = {"src", "include", "res", "tests", "tools", "third_party", "docs"}
+ROOT_FILES = {".gitignore", "README.md", "Keybinder.rc", "Keybinder.sln", "Keybinder.vcxproj"}
+EXCLUDED_DIRS = {".git", ".vs", "__pycache__", "output", "debug", "release", "obj", "cmakefiles"}
+EXCLUDED_SUFFIXES = {".obj", ".pdb", ".ilk", ".exp", ".suo", ".user", ".log", ".pyc", ".o"}
+EXCLUDED_NAMES = {"keybinder.json", "jobs_data.json", "imgui.ini", "nul", "keybinder_crash.log"}
+VENDOR_BINARY_SUFFIXES = {".lib", ".exe", ".dll"}
+RELEASE_DIR = Path("dist/NLBinder-0.1.1-r3")
+
+
+def sha(data):
+    return hashlib.sha256(data).hexdigest()
+
+
+def allowed(path):
+    path = PurePosixPath(path)
+    if path.is_absolute() or ".." in path.parts or not path.parts:
+        return False
+    if path.parts[0] not in SOURCE_DIRS and str(path) not in ROOT_FILES:
+        return False
+    if any(part.lower() in EXCLUDED_DIRS for part in path.parts[:-1]):
+        return False
+    if path.name.lower() in EXCLUDED_NAMES or path.suffix.lower() in EXCLUDED_SUFFIXES:
+        return False
+    if path.suffix.lower() in {".asi", ".exe", ".lib", ".dll"}:
+        # Only pre-existing source dependency binaries belong in the tree.
+        return path.parts[0] in {"include", "third_party"}
+    return True
+
+
+def write(path, data):
+    path.parent.mkdir(parents=True, exist_ok=True)
+    path.write_bytes(data)
+
+
+def snapshot_files(directory):
+    return {str(path.relative_to(directory)).replace("\\", "/"): path
+            for path in directory.rglob("*") if path.is_file()}
+
+
+def main():
+    assert sha(ORIGINAL.read_bytes()) == EXPECTED_ORIGINAL, "Original ZIP differs"
+    assert sha((ROOT / RELEASE_DIR / "Keybinder.asi").read_bytes()) == EXPECTED_ASI, "ASI differs"
+    BASELINE.mkdir(parents=True, exist_ok=False)
+    CURRENT.mkdir(parents=True, exist_ok=False)
+    with zipfile.ZipFile(ORIGINAL) as archive:
+        comment = archive.comment.decode("ascii", errors="strict").strip()
+        for entry in archive.infolist():
+            if entry.is_dir():
+                continue
+            path = PurePosixPath(entry.filename)
+            if path.parts[0] != "NLBinder-master":
+                raise ValueError("Unexpected archive root")
+            relative = PurePosixPath(*path.parts[1:])
+            if allowed(relative):
+                write(BASELINE / str(relative), archive.read(entry))
+    for start in SOURCE_DIRS:
+        for current, directories, files in os.walk(ROOT / start):
+            directories[:] = [name for name in directories if name.lower() not in EXCLUDED_DIRS]
+            for name in files:
+                path = Path(current) / name
+                relative = path.relative_to(ROOT).as_posix()
+                if path.is_symlink():
+                    raise ValueError(f"Unexpected symlink: {relative}")
+                if allowed(relative):
+                    write(CURRENT / relative, path.read_bytes())
+    for name in ROOT_FILES:
+        write(CURRENT / name, (ROOT / name).read_bytes())
+    for path in (ROOT / RELEASE_DIR).iterdir():
+        if path.suffix.lower() in {".asi", ".md", ".json", ".txt"}:
+            data = path.read_bytes()
+            if path.name == "PRUEFBERICHT.json":
+                report = json.loads(data)
+                report["asi"] = "Keybinder.asi"  # Avoid publishing machine-specific profile paths.
+                data = (json.dumps(report, indent=2) + "\n").encode()
+            write(CURRENT / RELEASE_DIR / path.name, data)
+    # Preserve the complete original project README when adding the review entry page.
+    write(CURRENT / "docs/ORIGINAL-README.md", (BASELINE / "README.md").read_bytes())
+    write(CURRENT / "docs/BUILD-README.md", (ROOT / "README.md").read_bytes())
+    write(CURRENT / "README.md", (ROOT / "docs/review/README-GITHUB.md").read_bytes())
+    write(CURRENT / ".gitattributes", b"* text=auto\n*.cpp text eol=lf\n*.h text eol=lf\n*.md text eol=lf\n*.json text eol=lf\n*.bat text eol=crlf\n*.asi binary\n*.png binary\n*.ttf binary\n*.lib binary\n*.exe binary\n*.dll binary\n")
+    original_files = snapshot_files(BASELINE)
+    current_files = snapshot_files(CURRENT)
+    changes = []
+    for relative in sorted(original_files.keys() | current_files.keys()):
+        before = original_files[relative].read_bytes() if relative in original_files else None
+        after = current_files[relative].read_bytes() if relative in current_files else None
+        if before == after:
+            continue
+        # Distinguish formatting-only CRLF/LF differences from content changes.
+        formatting_only = before is not None and after is not None and before.replace(b"\r\n", b"\n") == after.replace(b"\r\n", b"\n")
+        changes.append({"path": relative, "status": "added" if before is None else "deleted" if after is None else "modified",
+                        "dependency": relative.startswith(("include/plugin-sdk/", "include/RakHook/")),
+                        "line_endings_only": formatting_only,
+                        "before_sha256": sha(before) if before is not None else None,
+                        "after_sha256": sha(after) if after is not None else None})
+    record = {"original_archive": "NLBinder-master.zip", "original_sha256": EXPECTED_ORIGINAL,
+              "original_archive_commit_comment": comment, "release_asi_sha256": EXPECTED_ASI,
+              "baseline_files": len(original_files), "current_files": len(current_files), "changes": changes}
+    write(CURRENT / "docs/review/SOURCE-COMPARISON.json", (json.dumps(record, indent=2, ensure_ascii=False) + "\n").encode())
+    relevant = [item for item in changes if not item["dependency"] and not item["line_endings_only"]]
+    text = ["# Dateivergleich mit dem Originalarchiv", "",
+            f"Originalarchiv: `{EXPECTED_ORIGINAL}`; Commitkennung im ZIP: `{comment}`.", "",
+            "Alle Dateien einschließlich wiederhergestellter Abhängigkeiten stehen in [SOURCE-COMPARISON.json](SOURCE-COMPARISON.json).",
+            "Reine CRLF/LF-Unterschiede sind dort separat markiert. Diese Liste enthält Inhaltsänderungen außerhalb der beiden wiederhergestellten SDK-Verzeichnisse.", "",
+            "| Status | Datei |", "| --- | --- |"]
+    for item in relevant:
+        path = item["path"]
+        text.append(f"| {item['status']} | [{path}](../../{path}) |")
+    write(CURRENT / "docs/review/DATEIVERGLEICH.md", ("\n".join(text) + "\n").encode())
+    print(json.dumps({"original": str(BASELINE), "current": str(CURRENT), "original_files": len(original_files),
+                      "current_files": len(current_files), "changed_or_added": len(changes),
+                      "non_dependency_content_changes": len(relevant), "archive_comment": comment}, indent=2))
+
+
+if __name__ == "__main__":
+    main()
diff --git a/tools/publish_revision16.py b/tools/publish_revision16.py
new file mode 100644
index 0000000..306121a
--- /dev/null
+++ b/tools/publish_revision16.py
@@ -0,0 +1,268 @@
+"""Prepare/publish only the authorized r16 update to Kobiro57/PerkysBinderChangelog.
+
+Uses the existing Git credential manager in memory; never logs or stores tokens.
+Large Chromium binaries belong in the release asset, not Git history.
+"""
+from pathlib import Path, PurePosixPath
+import argparse
+import hashlib
+import json
+import os
+import re
+import shutil
+import subprocess
+import urllib.request
+import urllib.error
+
+ROOT=Path(__file__).resolve().parents[1]
+REPO=ROOT/'build/github-publication/repository'
+URL='https://github.com/Kobiro57/PerkysBinderChangelog'
+API='https://api.github.com/repos/Kobiro57/PerkysBinderChangelog'
+TAG='v0.1.1-r16'
+PREVIOUS='0ecb46892401bc0b7ef0236436ca1ad04bcd85f8'
+PACKAGE='dist/NLBinder-0.1.1-r16'
+BASE='original-archive-92ce219'
+GENERATED={'docs/review/SOURCE-COMPARISON.json','docs/review/DATEIVERGLEICH.md',
+ 'docs/review/DIFFSTAT.txt','docs/review/first-party-changes.patch',
+ 'docs/review/REVISION16-DIFFSTAT.txt','docs/review/revision16-changes.patch'}
+PRIVATE_DIRS={'.git','.vs','__pycache__','output','debug','release','obj','cmakefiles','.codex','.agents','.aws'}
+PRIVATE_NAMES={'keybinder.json','jobs_data.json','imgui.ini','gps.xml','.env','.git-credentials','nul'}
+PRIVATE_SUFFIXES={'.obj','.pdb','.ilk','.exp','.log','.pyc','.suo','.user','.o'}
+PROGRAM=['src','browser','tests','tools','res','include/*.h','Keybinder.rc','Keybinder.vcxproj','Keybinder.sln']
+
+def require(ok,message):
+    if not ok:raise ValueError(message)
+
+def digest(data):return hashlib.sha256(data).hexdigest()
+
+def filehash(path):
+    with path.open('rb') as f:return hashlib.file_digest(f,'sha256').hexdigest()
+
+def git(*args,input=None):
+    p=subprocess.run(['git',*args],cwd=REPO,input=input,stdout=subprocess.PIPE,stderr=subprocess.PIPE)
+    if p.returncode:raise RuntimeError('Git failed: '+str(args[:3])+': '+p.stderr.decode('utf-8','replace')[:1500])
+    return p.stdout
+
+def write(relative,data):
+    p=REPO/relative;p.parent.mkdir(parents=True,exist_ok=True)
+    p.write_bytes(data.encode('utf-8') if isinstance(data,str) else data)
+
+def paths(revision):
+    entries={}
+    if revision==':':
+        records=git('ls-files','--stage','-z').split(b'\0')
+        for record in records:
+            if not record:continue
+            meta,name=record.split(b'\t',1);mode,oid,stage=meta.split()
+            require(stage==b'0' and mode in {b'100644',b'100755'},'Unmerged/link entry')
+            entries[name.decode()]=oid
+    else:
+        for record in git('ls-tree','-r','-z',revision).split(b'\0'):
+            if not record:continue
+            meta,name=record.split(b'\t',1);mode,kind,oid=meta.split()
+            require(kind==b'blob' and mode in {b'100644',b'100755'},'Submodule/link entry')
+            entries[name.decode()]=oid
+    return entries
+
+def blobs(entries):
+    oids=sorted(set(entries.values()))
+    process=subprocess.Popen(['git','cat-file','--batch'],cwd=REPO,stdin=subprocess.PIPE,stdout=subprocess.PIPE,stderr=subprocess.PIPE)
+    raw,err=process.communicate(b'\n'.join(oids)+b'\n')
+    require(process.returncode==0,'Cannot read source blobs')
+    values={};at=0
+    for oid in oids:
+        end=raw.index(b'\n',at);header=raw[at:end].split()
+        require(header[0]==oid and header[1]==b'blob','Invalid blob batch')
+        size=int(header[2]);at=end+1;values[oid]=raw[at:at+size];at+=size+1
+    require(at==len(raw),'Trailing source bytes')
+    return {name:values[oid] for name,oid in entries.items()}
+
+def allowed(relative):
+    p=PurePosixPath(relative)
+    return not (p.is_absolute() or '..' in p.parts or ':' in relative or '\\' in relative
+      or any(x.lower() in PRIVATE_DIRS for x in p.parts[:-1])
+      or p.name.lower() in PRIVATE_NAMES or p.suffix.lower() in PRIVATE_SUFFIXES)
+
+def historical(relative):
+    return bool(re.fullmatch(r'docs/review/(REVISION(?:[4-9]|1[0-5])-DIFFSTAT\.txt|revision(?:[4-9]|1[0-5])-changes\.patch)',relative))
+
+def stage():
+    require(git('remote','get-url','origin').decode().strip().removesuffix('.git')==URL,'Wrong target repository')
+    require(git('rev-parse','HEAD').decode().strip()==PREVIOUS,'Publication must start on the known r15 commit')
+    require(not git('status','--porcelain'),'Publication checkout has unrelated changes')
+    proof=json.loads((ROOT/'build/revision16-package.json').read_text())
+    require(proof['revision']==TAG and filehash(ROOT/'build/Release/NLBinder.asi')==proof['asi_sha256'],'Package proof stale')
+    original_entries=paths(BASE)
+    previous_entries=paths('HEAD')
+    for start in ['src','tests','tools','docs','res','browser']:
+        for parent,dirs,names in os.walk(ROOT/start):
+            dirs[:]=[x for x in dirs if x.lower() not in PRIVATE_DIRS]
+            for name in names:
+                path=Path(parent)/name;relative=path.relative_to(ROOT).as_posix()
+                if relative in GENERATED or historical(relative) or not allowed(relative):continue
+                require(not path.is_symlink() and path.stat().st_size<90*1024*1024,'Unexpected source link/large binary: '+relative)
+                require(path.suffix.lower() not in {'.asi','.exe','.dll','.lib'},'Binary in first-party source: '+relative)
+                write(relative,path.read_bytes())
+    for path in (ROOT/'include').glob('*.h'):write(path.relative_to(ROOT).as_posix(),path.read_bytes())
+    for relative in previous_entries:
+        if relative.startswith(('include/','third_party/')) and len(PurePosixPath(relative).parts)>2:
+            source=ROOT/relative
+            require(source.is_file() and allowed(relative),'Missing required dependency '+relative)
+            write(relative,source.read_bytes())
+    for name in ['.gitignore','.gitattributes','Keybinder.rc','Keybinder.sln','Keybinder.vcxproj']:
+        write(name,(ROOT/name).read_bytes())
+    write('README.md',(ROOT/'build/README-GITHUB-r16.md').read_bytes())
+    for path in (ROOT/PACKAGE).iterdir():
+        if path.is_file():write(PACKAGE+'/'+path.name,path.read_bytes())
+    publication=json.loads((ROOT/'docs/review/PUBLICATION.json').read_text())
+    publication.update(release=TAG,previous_release='v0.1.1-r15',previous_published_commit=PREVIOUS,
+      asi_sha256=proof['asi_sha256'],history_note='Original and dependency imports remain intact. r16 is a subsequent update; no history is rewritten.',
+      complete_runtime_asset=proof['archive'],complete_runtime_sha256=proof['archive_sha256'])
+    write('docs/review/PUBLICATION.json',json.dumps(publication,indent=2)+'\n')
+    git('add','--all')
+    # Patches describe program changes and avoid recursively including their own bytes.
+    write('docs/review/first-party-changes.patch',git('diff','--cached','--binary','build-dependencies-baseline','--',*PROGRAM))
+    write('docs/review/DIFFSTAT.txt',git('diff','--cached','--stat','build-dependencies-baseline','--',*PROGRAM))
+    write('docs/review/revision16-changes.patch',git('diff','--cached','--binary',PREVIOUS,'--',*PROGRAM))
+    write('docs/review/REVISION16-DIFFSTAT.txt',git('diff','--cached','--stat',PREVIOUS,'--',*PROGRAM))
+    git('add','--all')
+    current_entries=paths(':')
+    selected=lambda name:not name.startswith('dist/') and name not in GENERATED and not historical(name)
+    before=blobs({p:o for p,o in original_entries.items() if selected(p)})
+    after=blobs({p:o for p,o in current_entries.items() if selected(p)})
+    changes=[]
+    for name in sorted(before.keys()|after.keys()):
+        b=before.get(name);a=after.get(name)
+        if a==b:continue
+        changes.append({'path':name,'status':'added' if b is None else 'deleted' if a is None else 'modified',
+          'dependency':name.startswith(('include/plugin-sdk/','include/RakHook/')),
+          'line_endings_only':a is not None and b is not None and a.replace(b'\r\n',b'\n')==b.replace(b'\r\n',b'\n'),
+          'before_sha256':digest(b) if b is not None else None,'after_sha256':digest(a) if a is not None else None})
