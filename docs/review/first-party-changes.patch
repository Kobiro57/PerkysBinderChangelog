+    context.Respawn();
+    context.health = 8000050.0f; context.pedState = 54;
+    context.bridge.Update(); // Actual GTA DIE state is independent of positive protected raw HP.
+    CHECK(context.bridge.GetTotalDeaths() == 5 && context.DeathNotices() == 2);
