+'''
+p.write_text(t,encoding='utf-8')
+p=R/'tools/export_full_changelog.py';t=p.read_text(encoding='utf-8').replace('range(1, 22)','range(1, 23)').replace('1–21','1–22');p.write_text(t,encoding='utf-8')
