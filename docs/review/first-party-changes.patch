+    bridge.Update();
+    now = 2499;
+    bridge.Update();
+    ASSERT_TRUE(keyStates.empty());
+    now = 2500;
+    bridge.Update();
+    ASSERT_EQ(keyStates.size(), std::size_t(1));
+    ASSERT_TRUE(keyStates[0]);
+    now = 2600;
+    bridge.Update();
+    ASSERT_EQ(keyStates.size(), std::size_t(1));
+    now = 2650;
+    bridge.Update();
+    ASSERT_EQ(keyStates.size(), std::size_t(2));
