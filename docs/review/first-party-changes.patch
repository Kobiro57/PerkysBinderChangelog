+        worker = spawn([helper, "--parent", parent.pid, "--ready", ready_name,
+            "--mode", "nova", "--launcher", launcher, "--working-directory", folder,
+            "--game-executable", game, "--timeout-ms", "4500" if no_entry else "14000",
