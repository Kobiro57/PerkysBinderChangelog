@@ -0,0 +1,74 @@
+@echo off
+setlocal
+pushd "%~dp0.." || exit /b 2
+if not exist build mkdir build
+if not defined NLBINDER_PYTHON set "NLBINDER_PYTHON=%USERPROFILE%\.cache\codex-runtimes\codex-primary-runtime\dependencies\python\python.exe"
+if /i "%~1"=="tests" goto tests
+if /i "%~1"=="build" goto build
+if /i "%~1"=="worker" goto worker
+if /i "%~1"=="document" goto document
+if /i "%~1"=="package" goto package
+if /i "%~1"=="prepare-publication" goto preparepublication
+if /i "%~1"=="publish" goto publish
+if /i "%~1"=="verify-public" goto verifypublic
+if /i "%~1"=="export" goto export
+if /i "%~1"=="install" goto install
+set "NLBINDER_RESULT=2"
+goto finish
+:tests
+call tools\run_tests.bat > build\revision19-tests.log 2>&1
+set "NLBINDER_RESULT=%ERRORLEVEL%"
+"%NLBINDER_PYTHON%" tools\report_revision19_log.py tests
+goto finish
+:build
+call tools\build_release.bat > build\revision19-build.log 2>&1
+set "NLBINDER_RESULT=%ERRORLEVEL%"
+>>build\revision19-build.log echo RELEASE_BUILD_EXIT_CODE=%NLBINDER_RESULT%
+"%NLBINDER_PYTHON%" tools\report_revision19_log.py build
+goto finish
+:worker
+"%NLBINDER_PYTHON%" tools\test_reconnect_worker.py > build\revision19-reconnect.log 2>&1
+set "NLBINDER_RESULT=%ERRORLEVEL%"
+type build\revision19-reconnect.log
+goto finish
+:document
+"%NLBINDER_PYTHON%" tools\document_revision19.py
+if errorlevel 1 goto failed
+"%NLBINDER_PYTHON%" tools\export_full_changelog.py
+set "NLBINDER_RESULT=%ERRORLEVEL%"
+goto finish
+:package
+"%NLBINDER_PYTHON%" tools\verify_revision19_artifact.py
+if errorlevel 1 goto failed
+"%NLBINDER_PYTHON%" tools\document_revision19.py
+if errorlevel 1 goto failed
+"%NLBINDER_PYTHON%" tools\export_full_changelog.py
+if errorlevel 1 goto failed
+"%NLBINDER_PYTHON%" tools\package_revision19.py
+set "NLBINDER_RESULT=%ERRORLEVEL%"
+goto finish
+:preparepublication
+"%NLBINDER_PYTHON%" tools\publish_revision19.py --prepare
+set "NLBINDER_RESULT=%ERRORLEVEL%"
+goto finish
+:publish
+"%NLBINDER_PYTHON%" tools\publish_revision19.py --publish
+set "NLBINDER_RESULT=%ERRORLEVEL%"
+goto finish
+:export
+"%NLBINDER_PYTHON%" tools\finalize_revision19.py
+set "NLBINDER_RESULT=%ERRORLEVEL%"
+goto finish
+:verifypublic
+"%NLBINDER_PYTHON%" tools\verify_revision19_public.py
+set "NLBINDER_RESULT=%ERRORLEVEL%"
+goto finish
+:install
+"%NLBINDER_PYTHON%" tools\install_revision19.py
+set "NLBINDER_RESULT=%ERRORLEVEL%"
+goto finish
+:failed
+set "NLBINDER_RESULT=2"
+:finish
+popd
+exit /b %NLBINDER_RESULT%
