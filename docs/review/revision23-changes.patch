+        fixture.context.inputAvailable = false;
+        fixture.bridge.Update();
+        CHECK(fixture.context.commands.empty());
+        fixture.context.inputAvailable = true;
+        ++fixture.context.now;
+        fixture.bridge.Update();
+        CHECK(fixture.context.commands == std::vector<std::string>{expectedRadio});
+    }
+}
+
+void OverflowDiscardsAmbiguousBatchesInsteadOfReplayingResults() {
+    Fixture fixture;
+    fixture.Start();
+    fixture.context.now += 30000;
+    fixture.Marker();
+    fixture.Chat(successLine);
+    for (int line = 0; line < 65; ++line) fixture.Chat("Ein normaler Serverhinweis");
+    fixture.bridge.Update();
+    CHECK(fixture.context.commands.empty());
+    CHECK(fixture.context.resolvedPositions.empty());
+    fixture.Chat(successLine);
+    fixture.Marker();
+    fixture.bridge.Update();
+    CHECK(fixture.context.commands.empty());
+}
+
+} // namespace
+
+int RunPoliceLocateBridgeTests() {
+    checks = failures = 0;
+    ActualCheckpointApplicationAndMarkerDistrictAreRequired();
+    SuccessBeforeCheckpointWorksAndDuplicateHooksDoNotRepeatRadio();
+    DisabledAndMismatchedNativeMarkersCannotBeAnnounced();
+    PlayerPrefixesCannotSpoofPersonalDetectiveMessages();
+    OnlyVerifiedPoliceAliasesCanUseTheFeature();
+    RevokedOrChangedIdentityDiscardsPendingEventsAndNeverReplaysThem();
+    LocalGpsAndOldServerCheckpointsNeverCountAsLocatedTarget();
+    ExpiredOperationsCannotSendAndUnavailableInputDefersOutput();
+    OverflowDiscardsAmbiguousBatchesInsteadOfReplayingResults();
+    std::printf("PoliceLocateBridgeTests: %d checks, %d failures\n", checks, failures);
+    return failures;
+}
diff --git a/tests/PoliceLocateTrackerTests.cpp b/tests/PoliceLocateTrackerTests.cpp
new file mode 100644
index 0000000..bce81a3
--- /dev/null
+++ b/tests/PoliceLocateTrackerTests.cpp
@@ -0,0 +1,233 @@
+#include "../include/PoliceLocateTracker.h"
+
+#include <cstdio>
+#include <limits>
+#include <stdexcept>
+
+namespace {
+int checks = 0, failures = 0;
+#define CHECK(x) do { ++checks; if (!(x)) { ++failures; std::printf("[FAIL] PoliceLocateTracker: %s at %d\n", #x, __LINE__); } } while (0)
+using Tracker = keybinder::PoliceLocateTracker;
+using Marker = keybinder::LocateCheckpoint;
+constexpr std::uint32_t start = 100000;
+const Marker targetMarker{1927.8734f, 168.8767f, 40.1172f, 4.0f};
+const char* success = "Detektiv: Das Ziel wurde geortet und wird dir nun auf der Karte angezeigt.";
+const char* locate = "Detektiv: Das Handy und die Ortung von Lesch wurde gestartet und dauert 30 Sekunden.";
+const std::string expected = "/r [ORTUNG] Gesuchter Lesch wurde zuletzt in [Palomino Creek] geortet.";
+std::string District(float, float, float) { return "Palomino Creek"; }
+
+Tracker Authorized() {
+    Tracker tracker;
+    tracker.SetSession(true, "server:7777/Officer");
+    return tracker;
+}
+
+void MarkerAndSuccessAreBothRequiredInEitherOrder() {
+    auto tracker = Authorized();
+    CHECK(!tracker.ObserveCheckpoint(targetMarker, start));
+    CHECK(!tracker.ObserveChat(success, start));
+    CHECK(tracker.TakeRadioMessage(start, District).empty());
+    CHECK(tracker.ObserveChat(locate, start));
+    CHECK(tracker.HasPendingLocate());
+    CHECK(!tracker.ObserveCheckpoint(targetMarker, start + 1000));
+    CHECK(!tracker.ObserveChat(success, start + 1000));
+    CHECK(tracker.TakeRadioMessage(start + 1000, District).empty());
+    CHECK(tracker.ObserveCheckpoint(targetMarker, start + 30000));
+    CHECK(tracker.TakeRadioMessage(start + 30000, District).empty());
+    CHECK(tracker.ObserveChat(success, start + 30001));
+    int calls = 0;
+    const auto message = tracker.TakeRadioMessage(start + 30002, [&](float x, float y, float z) {
+        ++calls;
+        CHECK(x == targetMarker.x && y == targetMarker.y && z == targetMarker.z);
+        return "Palomino Creek";
+    });
+    CHECK(message == expected);
+    CHECK(calls == 1);
+    CHECK(!tracker.HasPendingLocate());
+    CHECK(tracker.TakeRadioMessage(start + 30003, District).empty());
+    CHECK(!tracker.ObserveChat(success, start + 30003));
+    CHECK(!tracker.ObserveCheckpoint(targetMarker, start + 30003));
+
+    tracker = Authorized();
+    CHECK(tracker.ObserveChat(locate, start));
+    CHECK(tracker.ObserveChat(success, start + 30000));
+    CHECK(tracker.TakeRadioMessage(start + 30000, District).empty());
+    CHECK(tracker.ObserveCheckpoint(targetMarker, start + 30005));
+    CHECK(tracker.TakeRadioMessage(start + 30006, District) == expected);
+}
+
+void OldMarkersAndUnrelatedChatNeverSupplyTheResult() {
+    auto tracker = Authorized();
+    CHECK(!tracker.ObserveCheckpoint(targetMarker, start - 10));
+    CHECK(tracker.ObserveChat(locate, start));
+    CHECK(!tracker.ObserveCheckpoint(targetMarker, start + 27999));
+    CHECK(tracker.ObserveChat(success, start + 30000));
+    CHECK(tracker.TakeRadioMessage(start + 30001, District).empty());
+    CHECK(!tracker.ObserveChat("Detektiv: Du hast die Fähigkeit auf Stufe 191 verbessert.", start + 30002));
+    CHECK(tracker.TakeRadioMessage(start + 30003, District).empty());
+    CHECK(tracker.ObserveCheckpoint(targetMarker, start + 30004));
+    CHECK(tracker.TakeRadioMessage(start + 30005, District) == expected);
+
+    tracker = Authorized();
+    CHECK(tracker.ObserveChat(locate, start));
+    CHECK(tracker.ObserveCheckpoint(targetMarker, start + 28000));
+    CHECK(tracker.ObserveChat(success, start + 34000));
+    CHECK(tracker.TakeRadioMessage(start + 34001, District).empty());
+    CHECK(tracker.ObserveCheckpoint(targetMarker, start + 34002));
+    CHECK(tracker.TakeRadioMessage(start + 34003, District) == expected);
+
+    tracker = Authorized();
+    CHECK(tracker.ObserveChat(locate, start));
+    CHECK(tracker.ObserveCheckpoint(targetMarker, start + 30000));
+    tracker.ObserveCheckpointDisabled();
+    CHECK(tracker.ObserveChat(success, start + 30001));
+    CHECK(tracker.TakeRadioMessage(start + 30002, District).empty());
+}
+
+void SessionAndRoleChangesDiscardEveryPendingResult() {
+    for (int change = 0; change < 5; ++change) {
+        auto tracker = Authorized();
+        CHECK(tracker.ObserveChat(locate, start));
+        CHECK(tracker.ObserveCheckpoint(targetMarker, start + 30000));
+        if (change == 0) tracker.SetSession(false, "server:7777/Officer");
+        if (change == 1) tracker.SetSession(true, "server:7777/OtherOfficer");
+        if (change == 2) tracker.SetSession(true, "other-server:7777/Officer");
+        if (change == 3) tracker.SetSession(true, "");
+        if (change == 4) tracker.Reset();
+        CHECK(!tracker.HasPendingLocate());
+        CHECK(!tracker.ObserveChat(success, start + 30001));
+        CHECK(tracker.TakeRadioMessage(start + 30002, District).empty());
+        tracker.SetSession(true, "server:7777/Officer");
+        CHECK(!tracker.ObserveCheckpoint(targetMarker, start + 30003));
+        CHECK(!tracker.ObserveChat(success, start + 30004));
+        CHECK(tracker.TakeRadioMessage(start + 30005, District).empty());
+    }
+    Tracker denied;
+    CHECK(!denied.ObserveChat(locate, start));
+    CHECK(!denied.ObserveCheckpoint(targetMarker, start + 30000));
+    denied.SetSession(false, "server:7777/Civilian");
+    CHECK(!denied.ObserveChat(locate, start));
+    CHECK(!denied.ObserveChat(success, start + 30000));
+
+    auto tracker = Authorized();
+    CHECK(tracker.ObserveChat(locate, start));
+    tracker.SetSession(true, "server:7777/Officer");
+    CHECK(tracker.HasPendingLocate());
+    CHECK(tracker.ObserveChat(success, start + 30000));
+    CHECK(tracker.ObserveCheckpoint(targetMarker, start + 30001));
+    CHECK(tracker.TakeRadioMessage(start + 30002, District) == expected);
+}
+
+void DeadlinesHandleStallsDuplicatesAndCounterWrap() {
+    auto tracker = Authorized();
+    CHECK(tracker.ObserveChat(locate, start));
+    CHECK(!tracker.ObserveChat(locate, start + 999));
+    CHECK(tracker.ObserveCheckpoint(targetMarker, start + 30000));
+    CHECK(tracker.ObserveChat(success, start + 30000));
+    CHECK(!tracker.ObserveChat(success, start + 30001));
+    CHECK(tracker.TakeRadioMessage(start + 30002, District) == expected);
+
+    tracker = Authorized();
+    CHECK(tracker.ObserveChat(locate, start));
+    CHECK(!tracker.ObserveCheckpoint(targetMarker, start + Tracker::kOperationTimeoutMs + 1));
+    CHECK(!tracker.HasPendingLocate());
+    CHECK(tracker.TakeRadioMessage(start + Tracker::kOperationTimeoutMs + 1, District).empty());
+
+    tracker = Authorized();
+    CHECK(tracker.ObserveChat(locate, start));
+    CHECK(tracker.ObserveChat(success, start + 30000));
+    CHECK(!tracker.ObserveCheckpoint(targetMarker, start + 35001));
+    CHECK(!tracker.HasPendingLocate());
+
+    tracker = Authorized();
+    CHECK(tracker.ObserveChat(locate, start));
+    CHECK(tracker.ObserveCheckpoint(targetMarker, start + 30000));
+    CHECK(tracker.ObserveChat(success, start + 35000));
+    CHECK(tracker.TakeRadioMessage(start + 35001, District) == expected);
+
+    tracker = Authorized();
+    const std::uint32_t wrapStart = std::numeric_limits<std::uint32_t>::max() - 1000;
+    CHECK(tracker.ObserveChat(locate, wrapStart));
+    CHECK(tracker.ObserveChat(success, wrapStart + 30000));
+    CHECK(tracker.ObserveCheckpoint(targetMarker, wrapStart + 30001));
+    CHECK(tracker.TakeRadioMessage(wrapStart + 30002, District) == expected);
+}
+
+void NamesColorCodesAndExactServerEnvelopesAreValidated() {
+    for (const char* invalid : {
+        "Other: Detektiv: Das Handy und die Ortung von Lesch wurde gestartet und dauert 30 Sekunden.",
+        "[r] Detektiv: Das Handy und die Ortung von Lesch wurde gestartet und dauert 30 Sekunden.",
+        "Detektiv: Das Handy und die Ortung von Lesch wurde gestartet und dauert 0 Sekunden.",
+        "Detektiv: Das Handy und die Ortung von Lesch wurde gestartet und dauert 121 Sekunden.",
+        "Detektiv: Das Handy und die Ortung von Lesch wurde gestartet und dauert 3x Sekunden.",
+        "Detektiv: Das Handy und die Ortung von Lesch wurde gestartet und dauert 30 Sekunden. Zusatz",
+        "Detektiv: Das Handy und die Ortung von Bad Name wurde gestartet und dauert 30 Sekunden.",
+        "Detektiv: Das Handy und die Ortung von Evil\n/r injected wurde gestartet und dauert 30 Sekunden.",
+        "Detektiv: Das Handy und die Ortung von wurde gestartet und dauert 30 Sekunden.",
+        "Detektiv: Das Handy und die Ortung von AAAAAAAAAAAAAAAAAAAAAAAAA wurde gestartet und dauert 30 Sekunden."}) {
+        auto tracker = Authorized();
+        CHECK(!tracker.ObserveChat(invalid, start));
+        CHECK(!tracker.HasPendingLocate());
+    }
+    auto tracker = Authorized();
+    CHECK(tracker.ObserveChat("[13:20:30] {33CCFF}Detektiv: {FFFFFF}Das Handy und die Ortung von [RCB]Lesch wurde gestartet und dauert 30 Sekunden.\r\n", start));
+    CHECK(tracker.ObserveCheckpoint(targetMarker, start + 30000));
+    CHECK(!tracker.ObserveChat("Other: Detektiv: Das Ziel wurde geortet und wird dir nun auf der Karte angezeigt.", start + 30001));
+    CHECK(tracker.TakeRadioMessage(start + 30001, District).empty());
+    CHECK(tracker.ObserveChat("{33CCFF}Detektiv: {FFFFFF}Das Ziel wurde geortet und wird dir nun auf der Karte angezeigt.", start + 30002));
+    CHECK(tracker.TakeRadioMessage(start + 30003, District)
+        == "/r [ORTUNG] Gesuchter [RCB]Lesch wurde zuletzt in [Palomino Creek] geortet.");
+
+    tracker = Authorized();
+    CHECK(tracker.ObserveChat("Detektiv: Das Handy und die Ortung von New_Target wurde gestartet und dauert 10 Sekunden.", start));
+    CHECK(tracker.ObserveChat(success, start + 10000));
+    CHECK(tracker.ObserveCheckpoint(targetMarker, start + 10001));
+    CHECK(tracker.TakeRadioMessage(start + 10002, District)
+        == "/r [ORTUNG] Gesuchter New_Target wurde zuletzt in [Palomino Creek] geortet.");
+}
+
+void NewOperationAndInvalidDistrictsNeverRecycleOldData() {
+    auto tracker = Authorized();
+    CHECK(tracker.ObserveChat(locate, start));
+    CHECK(tracker.ObserveCheckpoint(targetMarker, start + 30000));
+    CHECK(tracker.ObserveChat("Detektiv: Das Handy und die Ortung von Next_Target wurde gestartet und dauert 30 Sekunden.", start + 30001));
+    CHECK(!tracker.ObserveChat(success, start + 30002));
+    CHECK(tracker.TakeRadioMessage(start + 30003, District).empty());
+    CHECK(tracker.ObserveChat(success, start + 60001));
+    CHECK(tracker.TakeRadioMessage(start + 60002, District).empty());
+    CHECK(tracker.ObserveCheckpoint(targetMarker, start + 60003));
+    CHECK(tracker.TakeRadioMessage(start + 60004, {}).empty());
+    for (const std::string badDistrict : {"", "Unknown", "unknown", "\r\n", "Market\n/r injected", "{FF0000}Market", "[Market]"}) {
+        CHECK(tracker.TakeRadioMessage(start + 60004, [&](float, float, float) { return badDistrict; }).empty());
+    }
+    CHECK(tracker.TakeRadioMessage(start + 60005, [](float, float, float) -> std::string { throw std::runtime_error("test"); }).empty());
+    CHECK(tracker.TakeRadioMessage(start + 60006, [](float, float, float) { return " Market "; })
+        == "/r [ORTUNG] Gesuchter Next_Target wurde zuletzt in [Market] geortet.");
+
+    for (const Marker invalid : {
+        Marker{std::numeric_limits<float>::quiet_NaN(), 1, 2, 3},
+        Marker{1, std::numeric_limits<float>::infinity(), 2, 3},
+        Marker{1, 2, -std::numeric_limits<float>::infinity(), 3},
+        Marker{1, 2, 3, std::numeric_limits<float>::quiet_NaN()},
+        Marker{1, 2, 3, 0}, Marker{1, 2, 3, -1}, Marker{1, 2, 3, 1001}, Marker{20001, 2, 3, 4}}) {
+        tracker = Authorized();
+        CHECK(tracker.ObserveChat(locate, start));
+        CHECK(!tracker.ObserveCheckpoint(invalid, start + 30000));
+        CHECK(tracker.ObserveChat(success, start + 30001));
+        CHECK(tracker.TakeRadioMessage(start + 30002, District).empty());
+    }
+}
+
+} // namespace
+
+int RunPoliceLocateTrackerTests() {
+    checks = failures = 0;
+    MarkerAndSuccessAreBothRequiredInEitherOrder();
+    OldMarkersAndUnrelatedChatNeverSupplyTheResult();
+    SessionAndRoleChangesDiscardEveryPendingResult();
+    DeadlinesHandleStallsDuplicatesAndCounterWrap();
+    NamesColorCodesAndExactServerEnvelopesAreValidated();
+    NewOperationAndInvalidDistrictsNeverRecycleOldData();
+    std::printf("PoliceLocateTrackerTests: %d checks, %d failures\n", checks, failures);
+    return failures;
+}
diff --git a/tests/ServerCheckpointRPCAdapterTests.cpp b/tests/ServerCheckpointRPCAdapterTests.cpp
new file mode 100644
index 0000000..74a9df6
--- /dev/null
+++ b/tests/ServerCheckpointRPCAdapterTests.cpp
@@ -0,0 +1,314 @@
+#include "../include/ServerCheckpointRPCAdapter.h"
+#include "../include/RakHook/include/RakNet/BitStream.h"
+
+#include <atomic>
+#include <cmath>
+#include <cstdio>
+#include <limits>
+#include <stdexcept>
+#include <thread>
+#include <vector>
+
+namespace {
+int checks = 0, failures = 0;
+#define CHECK(value) do { ++checks; if (!(value)) { ++failures; std::printf("[FAIL] ServerCheckpointRPC: %s (line %d)\n", #value, __LINE__); return; } } while (0)
+
+constexpr unsigned char kSetCheckpoint = 107;
+constexpr unsigned char kDisableCheckpoint = 37;
+
+struct PayloadSnapshot {
+    int readOffset;
+    int usedBits;
+    std::vector<unsigned char> bytes;
+};
+
+PayloadSnapshot Snapshot(const RakNet::BitStream& payload) {
+    return {payload.GetReadOffset(), payload.GetNumberOfBitsUsed(),
+        std::vector<unsigned char>(payload.GetData(), payload.GetData() + payload.GetNumberOfBytesUsed())};
+}
+
+bool Unchanged(const RakNet::BitStream& payload, const PayloadSnapshot& before) {
+    return payload.GetReadOffset() == before.readOffset
+        && payload.GetNumberOfBitsUsed() == before.usedBits
+        && std::vector<unsigned char>(payload.GetData(),
+            payload.GetData() + payload.GetNumberOfBytesUsed()) == before.bytes;
+}
+
+void WriteCheckpoint(RakNet::BitStream& payload, float x = 1583.9396f, float y = 33.5867f,
+                     float z = 26.9868f, float radius = 3.0f) {
+    payload.Write(x);
+    payload.Write(y);
+    payload.Write(z);
+    payload.Write(radius);
+}
+
+void TestSetCheckpointParsesEveryBitAlignmentAndDoesNotMutateTheRpc() {
+    keybinder::ServerCheckpointRPCAdapter adapter;
+    std::vector<keybinder::ServerCheckpointEvent> events;
+    adapter.SetCallback([&](const auto& event) { events.push_back(event); });
+    CHECK(adapter.Initialize());
+    for (int prefixBits = 0; prefixBits < 8; ++prefixBits) {
+        RakNet::BitStream payload;
+        for (int bit = 0; bit < prefixBits; ++bit) payload.Write(bit % 2 == 0);
+        WriteCheckpoint(payload, -2354.125f, 1420.5f, 41.75f, 4.5f);
+        payload.Write(static_cast<unsigned short>(0xCAFE));
+        payload.Write(false);
+        payload.SetReadOffset(prefixBits);
+        const auto before = Snapshot(payload);
+        CHECK(adapter.ProcessRpcForTesting(kSetCheckpoint, &payload));
+        CHECK(Unchanged(payload, before));
+        CHECK(events.size() == static_cast<std::size_t>(prefixBits + 1));
+        const auto& event = events.back();
+        CHECK(event.enabled);
+        CHECK(event.x == -2354.125f && event.y == 1420.5f && event.z == 41.75f && event.radius == 4.5f);
+    }
+}
+
+void TestEveryTruncatedPayloadRestoresTheOriginalReadPositionAndBytes() {
+    keybinder::ServerCheckpointRPCAdapter adapter;
+    int delivered = 0;
+    adapter.SetCallback([&](const auto&) { ++delivered; });
+    CHECK(adapter.Initialize());
+    CHECK(!adapter.ProcessRpcForTesting(kSetCheckpoint, nullptr));
+    RakNet::BitStream complete;
+    complete.Write(true); complete.Write(false); complete.Write(true);
+    WriteCheckpoint(complete);
+    for (int bodyBits = 0; bodyBits < 128; ++bodyBits) {
+        RakNet::BitStream truncated(complete.GetData(), complete.GetNumberOfBytesUsed(), true);
+        truncated.SetWriteOffset(3 + bodyBits);
+        truncated.SetReadOffset(3);
+        const auto before = Snapshot(truncated);
+        CHECK(!adapter.ProcessRpcForTesting(kSetCheckpoint, &truncated));
+        CHECK(Unchanged(truncated, before));
+        CHECK(delivered == 0);
+    }
+    complete.SetReadOffset(complete.GetNumberOfBitsUsed());
+    const auto consumed = Snapshot(complete);
+    CHECK(!adapter.ProcessRpcForTesting(kSetCheckpoint, &complete));
+    CHECK(Unchanged(complete, consumed) && delivered == 0);
+}
+
+void TestNanInfinityInvalidCoordinatesAndRadiusNeverReachTheCallback() {
+    keybinder::ServerCheckpointRPCAdapter adapter;
+    int delivered = 0;
+    adapter.SetCallback([&](const auto&) { ++delivered; });
+    CHECK(adapter.Initialize());
+    const float nan = std::numeric_limits<float>::quiet_NaN();
+    const float inf = std::numeric_limits<float>::infinity();
+    for (int field = 0; field < 4; ++field) {
+        for (float invalid : {nan, inf, -inf}) {
+            float values[] = {100.0f, -200.0f, 30.0f, 3.0f};
+            values[field] = invalid;
+            RakNet::BitStream payload;
+            payload.Write(true);
+            WriteCheckpoint(payload, values[0], values[1], values[2], values[3]);
+            payload.SetReadOffset(1);
+            const auto before = Snapshot(payload);
+            CHECK(!adapter.ProcessRpcForTesting(kSetCheckpoint, &payload));
+            CHECK(Unchanged(payload, before));
+        }
+    }
+    for (int field = 0; field < 3; ++field) {
+        for (float outside : {std::nextafter(100000.0f, inf), std::nextafter(-100000.0f, -inf)}) {
+            float values[] = {100.0f, -200.0f, 30.0f, 3.0f};
+            values[field] = outside;
+            RakNet::BitStream payload;
+            WriteCheckpoint(payload, values[0], values[1], values[2], values[3]);
+            const auto before = Snapshot(payload);
+            CHECK(!adapter.ProcessRpcForTesting(kSetCheckpoint, &payload));
+            CHECK(Unchanged(payload, before));
+        }
+    }
+    for (float invalid : {0.0f, -0.0f, -1.0f, std::nextafter(10000.0f, inf)}) {
+        RakNet::BitStream payload;
+        WriteCheckpoint(payload, 0.0f, 0.0f, 0.0f, invalid);
+        const auto before = Snapshot(payload);
+        CHECK(!adapter.ProcessRpcForTesting(kSetCheckpoint, &payload));
+        CHECK(Unchanged(payload, before));
+    }
+    CHECK(delivered == 0);
+}
+
+void TestCoordinateAndRadiusBoundariesRemainValidAndReadOnly() {
+    keybinder::ServerCheckpointRPCAdapter adapter;
+    std::vector<keybinder::ServerCheckpointEvent> events;
+    adapter.SetCallback([&](const auto& event) { events.push_back(event); });
+    CHECK(adapter.Initialize());
+    for (float radius : {std::numeric_limits<float>::min(), 1.0f, 10000.0f}) {
+        RakNet::BitStream payload;
+        WriteCheckpoint(payload, -100000.0f, 100000.0f, -100000.0f, radius);
+        const auto before = Snapshot(payload);
+        CHECK(adapter.ProcessRpcForTesting(kSetCheckpoint, &payload));
+        CHECK(Unchanged(payload, before));
+        CHECK(events.back().enabled && events.back().x == -100000.0f
+            && events.back().y == 100000.0f && events.back().z == -100000.0f
+            && events.back().radius == radius);
+    }
+    CHECK(events.size() == 3);
+}
+
+void TestOnlyNormalServerCheckpointRpcIdsAreObserved() {
+    keybinder::ServerCheckpointRPCAdapter adapter;
+    int delivered = 0;
+    adapter.SetCallback([&](const auto&) { ++delivered; });
+    CHECK(adapter.Initialize());
+    RakNet::BitStream payload;
+    payload.Write(true); payload.Write(true);
+    WriteCheckpoint(payload);
+    payload.SetReadOffset(2);
+    const auto before = Snapshot(payload);
+    for (unsigned char rpc : {0, 1, 36, 38, 39, 61, 106, 108, 255}) {
+        CHECK(!adapter.ProcessRpcForTesting(rpc, &payload));
+        CHECK(Unchanged(payload, before));
+        CHECK(!adapter.ProcessRpcForTesting(rpc, nullptr));
+    }
+    CHECK(delivered == 0);
+}
+
+void TestDisableCheckpointAllowsNullOrUnrelatedPayloadWithoutReadingIt() {
+    keybinder::ServerCheckpointRPCAdapter adapter;
+    std::vector<keybinder::ServerCheckpointEvent> events;
+    adapter.SetCallback([&](const auto& event) { events.push_back(event); });
+    CHECK(adapter.Initialize());
+    CHECK(adapter.ProcessRpcForTesting(kDisableCheckpoint, nullptr));
+    CHECK(events.size() == 1 && !events.back().enabled);
+    CHECK(events.back().x == 0.0f && events.back().y == 0.0f
+        && events.back().z == 0.0f && events.back().radius == 0.0f);
+    RakNet::BitStream arbitrary;
+    arbitrary.Write(static_cast<unsigned char>(0xEF));
+    arbitrary.Write(true);
+    arbitrary.SetReadOffset(4);
+    const auto before = Snapshot(arbitrary);
+    CHECK(adapter.ProcessRpcForTesting(kDisableCheckpoint, &arbitrary));
+    CHECK(Unchanged(arbitrary, before));
+    CHECK(events.size() == 2 && !events.back().enabled);
+}
+
+void TestLifecycleRequiresInitializationCallbackAndSupportsSafeReinitialize() {
+    keybinder::ServerCheckpointRPCAdapter adapter;
+    RakNet::BitStream payload;
+    WriteCheckpoint(payload);
+    const auto before = Snapshot(payload);
+    int delivered = 0;
+    CHECK(!adapter.ProcessRpcForTesting(kSetCheckpoint, &payload));
+    CHECK(Unchanged(payload, before));
+    adapter.SetCallback([&](const auto&) { ++delivered; });
+    CHECK(!adapter.ProcessRpcForTesting(kSetCheckpoint, &payload));
+    CHECK(!adapter.ProcessRpcForTesting(kDisableCheckpoint, nullptr));
+    CHECK(adapter.Initialize());
+    CHECK(adapter.Initialize());
+    CHECK(adapter.ProcessRpcForTesting(kSetCheckpoint, &payload));
+    CHECK(delivered == 1 && Unchanged(payload, before));
+    adapter.SetCallback([&](const auto&) { delivered += 10; });
+    CHECK(adapter.ProcessRpcForTesting(kDisableCheckpoint, nullptr));
+    CHECK(delivered == 11);
+    adapter.Shutdown();
+    adapter.Shutdown();
+    CHECK(!adapter.ProcessRpcForTesting(kSetCheckpoint, &payload));
+    CHECK(!adapter.ProcessRpcForTesting(kDisableCheckpoint, nullptr));
+    CHECK(delivered == 11 && Unchanged(payload, before));
+    CHECK(adapter.Initialize());
+    CHECK(!adapter.ProcessRpcForTesting(kSetCheckpoint, &payload));
+    CHECK(!adapter.ProcessRpcForTesting(kDisableCheckpoint, nullptr));
+    adapter.SetCallback([&](const auto&) { delivered += 100; });
+    CHECK(adapter.ProcessRpcForTesting(kSetCheckpoint, &payload));
+    CHECK(delivered == 111 && Unchanged(payload, before));
+    adapter.SetCallback({});
+    CHECK(!adapter.ProcessRpcForTesting(kSetCheckpoint, &payload));
+    CHECK(!adapter.ProcessRpcForTesting(kDisableCheckpoint, nullptr));
+    CHECK(Unchanged(payload, before));
+    {
+        keybinder::ServerCheckpointRPCAdapter scoped;
+        scoped.SetCallback([&](const auto&) { delivered += 1000; });
+        CHECK(scoped.Initialize());
+        CHECK(scoped.ProcessRpcForTesting(kDisableCheckpoint, nullptr));
+        scoped.Shutdown();
+        CHECK(!scoped.ProcessRpcForTesting(kDisableCheckpoint, nullptr));
+    }
+    CHECK(delivered == 1111);
+}
+
+void TestCallbackFailureStillLeavesTheIncomingPayloadReadOnly() {
+    keybinder::ServerCheckpointRPCAdapter adapter;
+    adapter.SetCallback([](const auto&) { throw std::runtime_error("test callback failure"); });
+    CHECK(adapter.Initialize());
+    RakNet::BitStream payload;
+    payload.Write(true);
+    WriteCheckpoint(payload);
+    payload.SetReadOffset(1);
+    const auto before = Snapshot(payload);
+    bool threw = false;
+    try { adapter.ProcessRpcForTesting(kSetCheckpoint, &payload); }
+    catch (const std::runtime_error&) { threw = true; }
+    CHECK(threw);
+    CHECK(Unchanged(payload, before));
+    adapter.Shutdown();
+    CHECK(!adapter.ProcessRpcForTesting(kSetCheckpoint, &payload));
+    CHECK(Unchanged(payload, before));
+}
+
+void TestConcurrentShutdownAndDispatchDoNotDeliverAfterShutdownReturns() {
+    keybinder::ServerCheckpointRPCAdapter adapter;
+    std::atomic<int> callbacks{0};
+    std::atomic<bool> malformed{false};
+    std::atomic<bool> start{false};
+    auto callback = [&](const keybinder::ServerCheckpointEvent& event) {
+        if (event.enabled && (event.x != 1.25f || event.y != -2.5f
+            || event.z != 3.75f || event.radius != 4.0f)) malformed = true;
+        ++callbacks;
+    };
+    adapter.SetCallback(callback);
+    CHECK(adapter.Initialize());
+    std::thread dispatcher([&]() {
+        RakNet::BitStream payload;
+        payload.Write(true); payload.Write(false);
+        WriteCheckpoint(payload, 1.25f, -2.5f, 3.75f, 4.0f);
+        payload.SetReadOffset(2);
+        const auto before = Snapshot(payload);
+        while (!start.load()) std::this_thread::yield();
+        for (int i = 0; i < 1000; ++i) {
+            adapter.ProcessRpcForTesting(kSetCheckpoint, &payload);
+            adapter.ProcessRpcForTesting(kDisableCheckpoint, nullptr);
+            if (adapter.ProcessRpcForTesting(38, &payload) || !Unchanged(payload, before)) malformed = true;
+        }
+    });
+    std::thread lifecycle([&]() {
+        while (!start.load()) std::this_thread::yield();
+        for (int i = 0; i < 100; ++i) {
+            adapter.Shutdown();
+            adapter.SetCallback(callback);
+            adapter.Initialize();
+        }
+    });
+    start = true;
+    dispatcher.join();
+    lifecycle.join();
+    adapter.Shutdown();
+    const int afterShutdown = callbacks.load();
+    RakNet::BitStream payload;
+    WriteCheckpoint(payload, 1.25f, -2.5f, 3.75f, 4.0f);
+    const auto before = Snapshot(payload);
+    for (int i = 0; i < 32; ++i) {
+        CHECK(!adapter.ProcessRpcForTesting(kSetCheckpoint, &payload));
+        CHECK(!adapter.ProcessRpcForTesting(kDisableCheckpoint, nullptr));
+        CHECK(Unchanged(payload, before));
+    }
+    CHECK(callbacks.load() == afterShutdown);
+    CHECK(!malformed.load());
+}
+} // namespace
+
+int RunServerCheckpointRPCAdapterTests() {
+    checks = failures = 0;
+    TestSetCheckpointParsesEveryBitAlignmentAndDoesNotMutateTheRpc();
+    TestEveryTruncatedPayloadRestoresTheOriginalReadPositionAndBytes();
+    TestNanInfinityInvalidCoordinatesAndRadiusNeverReachTheCallback();
+    TestCoordinateAndRadiusBoundariesRemainValidAndReadOnly();
+    TestOnlyNormalServerCheckpointRpcIdsAreObserved();
+    TestDisableCheckpointAllowsNullOrUnrelatedPayloadWithoutReadingIt();
+    TestLifecycleRequiresInitializationCallbackAndSupportsSafeReinitialize();
+    TestCallbackFailureStillLeavesTheIncomingPayloadReadOnly();
+    TestConcurrentShutdownAndDispatchDoNotDeliverAfterShutdownReturns();
+    std::printf("ServerCheckpointRPCAdapterTests: %d checks, %d failures\n", checks, failures);
+    return failures;
+}
