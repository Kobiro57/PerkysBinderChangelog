diff --git a/src/PoliceLocateBridge.cpp b/src/PoliceLocateBridge.cpp
new file mode 100644
index 0000000..9d02459
--- /dev/null
+++ b/src/PoliceLocateBridge.cpp
@@ -0,0 +1,155 @@
+#include "../include/SAMPBridge.h"
+#include "../include/FactionAccess.h"
+#include <algorithm>
+#include <cctype>
+#include <cmath>
+#include <cstring>
+#ifndef KEYBINDER_TESTING
+#include "CTheZones.h"
+#endif
+
+namespace {
+unsigned long PoliceTick() {
+#ifdef KEYBINDER_TESTING
+    const auto& hooks = SAMPBridge::GetTestingHooks();
+    if (hooks.getTickCount) return hooks.getTickCount();
+#endif
+    return GetTickCount();
+}
+
+#ifndef KEYBINDER_TESTING
+std::string ZoneTextToUtf8(const char* text) {
+    if (!text || !*text) return {};
+    const int length = static_cast<int>(strnlen(text, 256));
+    if (length == 256) return {};
+    if (MultiByteToWideChar(CP_UTF8, MB_ERR_INVALID_CHARS, text, length, nullptr, 0) > 0)
+        return std::string(text, length);
+    const int wideLength = MultiByteToWideChar(CP_ACP, 0, text, length, nullptr, 0);
+    if (wideLength <= 0) return {};
+    std::wstring wide(wideLength, L'\0');
+    MultiByteToWideChar(CP_ACP, 0, text, length, wide.data(), wideLength);
+    const int count = WideCharToMultiByte(CP_UTF8, 0, wide.data(), wideLength, nullptr, 0, nullptr, nullptr);
+    if (count <= 0) return {};
+    std::string result(count, '\0');
+    WideCharToMultiByte(CP_UTF8, 0, wide.data(), wideLength, result.data(), count, nullptr, nullptr);
+    return result;
+}
+#endif
+} // namespace
+
+void SAMPBridge::InitializePoliceLocate() {
+    if (!policeCheckpointAdapter_)
+        policeCheckpointAdapter_ = std::make_unique<keybinder::ServerCheckpointRPCAdapter>();
+    policeCheckpointAdapter_->SetCallback([this](const keybinder::ServerCheckpointEvent& event) {
+        CapturePoliceCheckpoint(event);
+    });
+    policeCheckpointAdapter_->Initialize();
+}
+
+void SAMPBridge::ShutdownPoliceLocate() {
+    {
+        std::lock_guard<std::mutex> lock(policeLocateMutex_);
+        policeLocateCaptureActive_ = false;
+        policeLocateQueueOverflow_ = false;
+        pendingPoliceLocateEvents_.clear();
+    }
+    if (policeCheckpointAdapter_) policeCheckpointAdapter_->Shutdown();
+    policeCheckpointAdapter_.reset();
+    policeLocateTracker_.Reset();
+    policeLocateSession_.clear();
+}
+
+void SAMPBridge::CapturePoliceLocateChat(const std::string& text) {
+    if (text.empty() || text.size() > 1024) return;
+    std::lock_guard<std::mutex> lock(policeLocateMutex_);
+    if (!policeLocateCaptureActive_) return;
+    if (pendingPoliceLocateEvents_.size() >= 64) {
+        pendingPoliceLocateEvents_.clear();
+        policeLocateCaptureActive_ = false;
+        policeLocateQueueOverflow_ = true;
+        return;
+    }
+    pendingPoliceLocateEvents_.push_back({false, text, {}, PoliceTick()});
+}
+
+void SAMPBridge::CapturePoliceCheckpoint(const keybinder::ServerCheckpointEvent& event) {
+    std::lock_guard<std::mutex> lock(policeLocateMutex_);
+    if (!policeLocateCaptureActive_) return;
+    if (pendingPoliceLocateEvents_.size() >= 64) {
+        pendingPoliceLocateEvents_.clear();
+        policeLocateCaptureActive_ = false;
+        policeLocateQueueOverflow_ = true;
+        return;
+    }
+    pendingPoliceLocateEvents_.push_back({true, {}, event, PoliceTick()});
+}
+
+std::string SAMPBridge::ResolvePoliceCheckpointDistrict(float x, float y, float z) const {
+    // The server RPC is observed before the game applies it. Only announce a
+    // marker that is actually enabled at the received location this frame.
+    const auto* game = GetGame();
+    if (!game || !game->m_checkpoint.m_bEnabled
+        || !std::isfinite(game->m_checkpoint.m_position.x)
+        || !std::isfinite(game->m_checkpoint.m_position.y)
+        || !std::isfinite(game->m_checkpoint.m_position.z)
+        || std::abs(game->m_checkpoint.m_position.x - x) > 0.25f
+        || std::abs(game->m_checkpoint.m_position.y - y) > 0.25f
+        || std::abs(game->m_checkpoint.m_position.z - z) > 0.25f) return {};
+#ifdef KEYBINDER_TESTING
+    const auto& hooks = GetTestingHooks();
+    return hooks.getDistrictAtPosition ? hooks.getDistrictAtPosition(x, y, z) : std::string{};
+#else
+    const CVector position(x, y, z);
+    CZone* zone = CTheZones::FindSmallestZoneForPosition(position, false);
+    return zone ? ZoneTextToUtf8(zone->GetTranslatedName()) : std::string{};
+#endif
+}
+
+void SAMPBridge::UpdatePoliceLocate(unsigned long now) {
+    const auto* network = GetNetGame();
+    const auto* local = GetLocalPlayer();
+    const std::string playerName = GetLocalPlayerName();
+    const bool allowed = initialized_ && network && !playerName.empty()
+        && network->m_nGameState == sampapi::v03dl::CNetGame::GAME_MODE_CONNECTED
+        && local && local->m_bIsActive && !local->m_bIsWasted
+        && keybinder::IsPoliceMember(GetLocalFaction());
+    std::string identity;
+    if (allowed) {
+        identity = std::string(network->m_szHostAddress, strnlen(network->m_szHostAddress, 257))
+            + ":" + std::to_string(network->m_nPort) + "/" + playerName;
+        std::transform(identity.begin(), identity.end(), identity.begin(), [](unsigned char ch) {
+            return static_cast<char>(std::tolower(ch));
+        });
+    }
+    std::vector<PendingPoliceLocateEvent> events;
+    bool overflow = false;
+    {
+        std::lock_guard<std::mutex> lock(policeLocateMutex_);
+        if (!allowed || identity != policeLocateSession_) pendingPoliceLocateEvents_.clear();
+        overflow = policeLocateQueueOverflow_;
+        policeLocateQueueOverflow_ = false;
+        policeLocateCaptureActive_ = allowed;
+        policeLocateSession_ = identity;
+        events.swap(pendingPoliceLocateEvents_);
+    }
+    if (overflow) policeLocateTracker_.Reset();
+    policeLocateTracker_.SetSession(allowed, identity);
+    if (!allowed) return;
+    for (const auto& event : events) {
+        if (!event.isCheckpoint) policeLocateTracker_.ObserveChat(event.text, event.at);
+        else if (!event.checkpoint.enabled) policeLocateTracker_.ObserveCheckpointDisabled();
+        else policeLocateTracker_.ObserveCheckpoint({event.checkpoint.x, event.checkpoint.y,
+            event.checkpoint.z, event.checkpoint.radius}, event.at);
+    }
+    if (GetInput() == nullptr) return;
+    const std::string radio = policeLocateTracker_.TakeRadioMessage(now, [this](float x, float y, float z) {
+        return ResolvePoliceCheckpointDistrict(x, y, z);
+    });
+    if (!radio.empty()) SendCommand(radio);
+}
+
+#ifdef KEYBINDER_TESTING
+bool SAMPBridge::ProcessServerCheckpointRpcForTesting(unsigned char id, RakNet::BitStream* payload) {
+    return policeCheckpointAdapter_ && policeCheckpointAdapter_->ProcessRpcForTesting(id, payload);
+}
+#endif
diff --git a/src/PoliceLocateTracker.cpp b/src/PoliceLocateTracker.cpp
new file mode 100644
index 0000000..fb8778c
--- /dev/null
+++ b/src/PoliceLocateTracker.cpp
@@ -0,0 +1,194 @@
+#include "../include/PoliceLocateTracker.h"
+
+#include <algorithm>
+#include <cmath>
+
+namespace keybinder {
+namespace {
+
+bool IsHex(char ch) {
+    return (ch >= '0' && ch <= '9') || (ch >= 'A' && ch <= 'F') || (ch >= 'a' && ch <= 'f');
+}
+
+std::string Trim(const std::string& value) {
+    const auto first = value.find_first_not_of(" \t\r\n");
+    if (first == std::string::npos) return {};
+    return value.substr(first, value.find_last_not_of(" \t\r\n") - first + 1);
+}
+
+std::string NormalizeLine(const std::string& line) {
+    std::string text;
+    text.reserve(line.size());
+    for (std::size_t at = 0; at < line.size();) {
+        if (line[at] == '{') {
+            const auto end = line.find('}', at + 1);
+            if (end != std::string::npos && (end - at == 7 || end - at == 9)) {
+                bool hex = true;
+                for (auto digit = at + 1; digit < end; ++digit) hex = hex && IsHex(line[digit]);
+                if (hex) { at = end + 1; continue; }
+            }
+        }
+        text.push_back(line[at++]);
+    }
+    text = Trim(text);
+    // A log-style timestamp is allowed only at the beginning. Never match
+    // detective text quoted inside another player's chat or a radio message.
+    if (text.size() >= 11 && text[0] == '[' && text[3] == ':' && text[6] == ':'
+        && text[9] == ']' && text[10] == ' ') {
+        bool digits = true;
+        for (int pos : {1, 2, 4, 5, 7, 8}) digits = digits && text[pos] >= '0' && text[pos] <= '9';
+        if (digits) text = Trim(text.substr(11));
+    }
+    return text;
+}
+
+bool ValidTarget(const std::string& target) {
+    if (target.empty() || target.size() > 24) return false;
+    for (unsigned char ch : target) {
+        if (!((ch >= 'A' && ch <= 'Z') || (ch >= 'a' && ch <= 'z')
+            || (ch >= '0' && ch <= '9') || ch == '_' || ch == '[' || ch == ']'
+            || ch == '(' || ch == ')' || ch == '.' || ch == '$' || ch == '@'
+            || ch == '=' || ch == '-')) return false;
+    }
+    return true;
+}
+
+bool ParseStart(const std::string& line, std::string& target, std::uint32_t& durationMs) {
+    const std::string prefix = "Detektiv: Das Handy und die Ortung von ";
+    const std::string separator = " wurde gestartet und dauert ";
+    const std::string suffix = " Sekunden.";
+    if (line.compare(0, prefix.size(), prefix) != 0 || line.size() <= prefix.size() + suffix.size()
+        || line.compare(line.size() - suffix.size(), suffix.size(), suffix) != 0) return false;
+    const auto separatorAt = line.find(separator, prefix.size());
+    if (separatorAt == std::string::npos) return false;
+    target = line.substr(prefix.size(), separatorAt - prefix.size());
+    if (!ValidTarget(target)) return false;
+    const auto durationAt = separatorAt + separator.size();
+    const auto durationSize = line.size() - suffix.size() - durationAt;
+    if (durationSize == 0 || durationSize > 3) return false;
+    std::uint32_t seconds = 0;
+    for (std::size_t at = durationAt; at < durationAt + durationSize; ++at) {
+        if (line[at] < '0' || line[at] > '9') return false;
+        seconds = seconds * 10 + static_cast<std::uint32_t>(line[at] - '0');
+    }
+    if (seconds == 0 || seconds * 1000 > PoliceLocateTracker::kOperationTimeoutMs) return false;
+    durationMs = seconds * 1000;
+    return true;
+}
+
+bool ValidCheckpoint(const LocateCheckpoint& checkpoint) {
+    // GTA's world is well within these limits, including supported interiors.
+    // Reject corrupt network floats rather than resolving a misleading zone.
+    return std::isfinite(checkpoint.x) && std::isfinite(checkpoint.y)
+        && std::isfinite(checkpoint.z) && std::isfinite(checkpoint.radius)
+        && std::fabs(checkpoint.x) <= 20000.0f && std::fabs(checkpoint.y) <= 20000.0f
+        && std::fabs(checkpoint.z) <= 20000.0f
+        && checkpoint.radius > 0.0f && checkpoint.radius <= 1000.0f;
+}
+
+bool WithinWindow(std::uint32_t first, std::uint32_t second) {
+    return static_cast<std::uint32_t>(first - second) <= PoliceLocateTracker::kCompletionWindowMs
+        || static_cast<std::uint32_t>(second - first) <= PoliceLocateTracker::kCompletionWindowMs;
+}
+
+std::string SafeDistrict(const std::string& value) {
+    const std::string district = Trim(value);
+    if (district.empty() || district.size() > 100 || district == "Unknown" || district == "unknown") return {};
+    for (unsigned char ch : district) {
+        if (ch < 0x20 || ch == 0x7f || ch == '{' || ch == '}' || ch == '[' || ch == ']') return {};
+    }
+    return district;
+}
+
+} // namespace
+
+void PoliceLocateTracker::SetSession(bool policeAllowed, const std::string& connectionIdentity) {
+    const bool permitted = policeAllowed && !connectionIdentity.empty();
+    if (!permitted || !allowed_ || connectionIdentity != identity_) ClearOperation();
+    allowed_ = permitted;
+    identity_ = permitted ? connectionIdentity : std::string{};
+}
+
+void PoliceLocateTracker::Reset() {
+    ClearOperation();
+    allowed_ = false;
+    identity_.clear();
+}
+
+void PoliceLocateTracker::ClearOperation() {
+    pending_ = false;
+    target_.clear();
+    startedAt_ = durationMs_ = 0;
+    successObserved_ = markerObserved_ = false;
+    successAt_ = markerAt_ = 0;
+    marker_ = {};
+}
+
+bool PoliceLocateTracker::ValidatePending(std::uint32_t nowMs) {
+    if (!allowed_ || !pending_) return false;
+    if (static_cast<std::uint32_t>(nowMs - startedAt_) > kOperationTimeoutMs
+        || (successObserved_ && static_cast<std::uint32_t>(nowMs - successAt_) > kCompletionWindowMs)) {
+        ClearOperation();
+        return false;
+    }
+    return true;
+}
+
+bool PoliceLocateTracker::ObserveChat(const std::string& line, std::uint32_t nowMs) {
+    if (!allowed_) return false;
+    const std::string normalized = NormalizeLine(line);
+    std::string target;
+    std::uint32_t durationMs = 0;
+    if (ParseStart(normalized, target, durationMs)) {
+        if (ValidatePending(nowMs) && target_ == target && durationMs_ == durationMs
+            && static_cast<std::uint32_t>(nowMs - startedAt_) < 1000) return false;
+        ClearOperation();
+        pending_ = true;
+        target_ = std::move(target);
+        startedAt_ = nowMs;
+        durationMs_ = durationMs;
+        return true;
+    }
+    if (normalized != "Detektiv: Das Ziel wurde geortet und wird dir nun auf der Karte angezeigt."
+        || !ValidatePending(nowMs) || successObserved_) return false;
+    const std::uint32_t earliestMs = durationMs_ > kEarlyMarkerToleranceMs
+        ? durationMs_ - kEarlyMarkerToleranceMs : 0;
+    if (static_cast<std::uint32_t>(nowMs - startedAt_) < earliestMs) return false;
+    successObserved_ = true;
+    successAt_ = nowMs;
+    if (markerObserved_ && !WithinWindow(markerAt_, successAt_)) markerObserved_ = false;
+    return true;
+}
+
+bool PoliceLocateTracker::ObserveCheckpoint(const LocateCheckpoint& checkpoint, std::uint32_t nowMs) {
+    if (!ValidatePending(nowMs) || !ValidCheckpoint(checkpoint)) return false;
+    const std::uint32_t earliestMs = durationMs_ > kEarlyMarkerToleranceMs
+        ? durationMs_ - kEarlyMarkerToleranceMs : 0;
+    if (static_cast<std::uint32_t>(nowMs - startedAt_) < earliestMs
+        || (successObserved_ && !WithinWindow(nowMs, successAt_))) return false;
+    marker_ = checkpoint;
+    markerAt_ = nowMs;
+    markerObserved_ = true;
+    return true;
+}
+
+void PoliceLocateTracker::ObserveCheckpointDisabled() {
+    markerObserved_ = false;
+    marker_ = {};
+    markerAt_ = 0;
+}
+
+std::string PoliceLocateTracker::TakeRadioMessage(std::uint32_t nowMs, const DistrictResolver& resolveDistrict) {
+    if (!ValidatePending(nowMs) || !successObserved_ || !markerObserved_
+        || !WithinWindow(markerAt_, successAt_) || !resolveDistrict) return {};
+    std::string district;
+    try { district = SafeDistrict(resolveDistrict(marker_.x, marker_.y, marker_.z)); }
+    catch (...) { return {}; }
+    if (district.empty()) return {};
+    const std::string message = "/r [ORTUNG] Gesuchter " + target_
+        + " wurde zuletzt in [" + district + "] geortet.";
+    ClearOperation();
+    return message;
+}
+
+} // namespace keybinder
