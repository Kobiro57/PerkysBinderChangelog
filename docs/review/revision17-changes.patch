diff --git a/tools/test_browser_setup.py b/tools/test_browser_setup.py
new file mode 100644
index 0000000..b2592c3
--- /dev/null
+++ b/tools/test_browser_setup.py
@@ -0,0 +1,80 @@
+"""Exercise the native installer with an actual public download and private fixtures."""
+from pathlib import Path
+import ctypes as c
+from ctypes import wintypes as w
+import hashlib,json,shutil,subprocess,time,uuid
+
+R=Path(__file__).resolve().parents[1]
+LOCK=json.loads((R/'res/browser-runtime.json').read_text())
+BASE=R/'build/browser-setup-tests'/uuid.uuid4().hex
+BASE.mkdir(parents=True)
+kernel=c.WinDLL('kernel32',use_last_error=True)
+kernel.CreateFileMappingW.argtypes=[w.HANDLE,c.c_void_p,w.DWORD,w.DWORD,w.DWORD,w.LPCWSTR];kernel.CreateFileMappingW.restype=w.HANDLE
+kernel.MapViewOfFile.argtypes=[w.HANDLE,w.DWORD,w.DWORD,w.DWORD,c.c_size_t];kernel.MapViewOfFile.restype=c.c_void_p
+kernel.UnmapViewOfFile.argtypes=[c.c_void_p];kernel.CloseHandle.argtypes=[w.HANDLE]
+class Progress(c.Structure):
+    _fields_=[('magic',c.c_uint32),('bytes',c.c_uint32),('phase',c.c_int32),('percent',c.c_int32),('cancel',c.c_int32),('error',c.c_char*256)]
+assert c.sizeof(Progress)==276
+checks=0;cases=[]
+def check(ok,text):
+    global checks
+    checks+=1
+    if not ok:raise AssertionError(text)
+def sha(path):
+    with path.open('rb') as f:return hashlib.file_digest(f,'sha256').hexdigest()
+def run(label,root,extra=(),success=True,cancel=False):
+    name='Local\\NLBinder.BrowserSetup.'+str(subprocess.os.getpid())+'.'+uuid.uuid4().hex
+    mapping=kernel.CreateFileMappingW(w.HANDLE(-1),None,4,0,c.sizeof(Progress),name)
+    check(bool(mapping),'Create installer progress mapping')
+    address=kernel.MapViewOfFile(mapping,0xf001f,0,0,c.sizeof(Progress));check(bool(address),'Map installer progress')
+    p=Progress.from_address(address);p.magic=0x4e4c4253;p.bytes=c.sizeof(Progress);p.phase=1;p.cancel=int(cancel)
+    process=None;phases=set();started=time.monotonic()
+    print('Checking native browser setup:',label,flush=True)
+    try:
+        process=subprocess.Popen([str(R/'build/BrowserSetup.exe'),'--root',str(root),'--progress',name,*map(str,extra)],cwd=R,creationflags=subprocess.CREATE_NO_WINDOW)
+        while process.poll() is None and time.monotonic()-started<240:
+            phases.add(p.phase);time.sleep(.03)
+        if process.poll() is None:process.kill();raise AssertionError('Native installer timeout: '+label)
+        error=bytes(p.error).split(b'\0')[0].decode('utf-8','replace')
+        check((process.returncode==0)==success,label+': '+error)
+        check(p.phase==(5 if success else 7 if cancel else 6),label+': wrong terminal phase '+str(p.phase))
+        check(not list(root.glob('.setup-*')),label+': leftover staging directory')
+        if success:
+            for entry in LOCK['files']:
+                file=root/LOCK['runtime_id']/entry['path']
+                check(file.is_file() and file.stat().st_size==entry['bytes'] and sha(file)==entry['sha256'],label+': '+entry['path'])
+        else:check(bool(error),label+': missing local failure reason')
+        cases.append({'case':label,'success_expected':success,'exit_code':process.returncode,'phases':sorted(phases),'seconds':round(time.monotonic()-started,2)})
+        return phases
+    finally:
+        if process and process.poll() is None:process.kill();process.wait()
+        del p;kernel.UnmapViewOfFile(address);kernel.CloseHandle(mapping)
+
+subprocess.run([str(R/'build/BrowserSetupUnitTests.exe')],cwd=R,check=True)
+try:
+    root=BASE/'Frischer Browser mit Umlaut ä'/ 'Browser'
+    phases=run('real pinned HTTPS download',root)
+    check(3 in phases and 4 in phases,'Real download and extraction must be exercised')
+    runtime=root/LOCK['runtime_id'];stamp=(runtime/'NLBinderBrowser.exe').stat().st_mtime_ns
+    phases=run('already installed without a download',root,['--archive',BASE/'does-not-exist.zip'])
+    check(3 not in phases and (runtime/'NLBinderBrowser.exe').stat().st_mtime_ns==stamp,'Existing good files must be reused')
+    file=runtime/'CEF-README.txt';data=file.read_bytes();file.write_bytes(bytes([data[0]^1])+data[1:])
+    run('repair same-size damaged file',root,['--archive',R/'dist'/LOCK['asset']])
+    check(bool(list(root.glob(LOCK['runtime_id']+'.previous-*'))),'Damaged old runtime retained as backup')
+    migration=BASE/'migration'/'Browser'
+    phases=run('migrate supplied runtime without download',migration,['--source',runtime])
+    check(2 in phases and 3 not in phases,'Verified local source must be copied without network')
+    invalid=BASE/'invalid.zip';invalid.write_bytes(b'invalid')
+    rejected=BASE/'bad-archive'/'Browser';run('reject incorrect archive',rejected,['--archive',invalid],success=False)
+    check(not (rejected/LOCK['runtime_id']).exists(),'Bad archive must not become an active runtime')
+    cancelled=BASE/'cancelled'/'Browser';run('cancel before installation',cancelled,['--archive',R/'dist'/LOCK['asset']],success=False,cancel=True)
+    check(not (cancelled/LOCK['runtime_id']).exists(),'Cancelled setup must not become active')
+    result={'revision':'v0.1.1-r17','checks':checks,'failures':0,'real_public_https_download':True,'archive_sha256':LOCK['archive_sha256'],
+        'native_installer':True,'unicode_and_spaces_in_paths':True,'all_runtime_files_verified':len(LOCK['files']),
+        'cases':cases,'personal_documents_modified':False,'login_or_post_submitted':False}
+    (R/'build/revision17-setup-tests.json').write_text(json.dumps(result,indent=2)+'\n',encoding='utf-8')
+    print(json.dumps(result,indent=2),flush=True)
+finally:
+    # Only the uniquely generated fixture directory inside this build root.
+    assert BASE.resolve().parent==(R/'build/browser-setup-tests').resolve()
+    shutil.rmtree(BASE)
diff --git a/tools/verify_revision17_artifact.py b/tools/verify_revision17_artifact.py
new file mode 100644
index 0000000..decfdb1
--- /dev/null
+++ b/tools/verify_revision17_artifact.py
@@ -0,0 +1,124 @@
+"""Read-only r17 PE/artifact verification; never loads or executes binaries."""
+import hashlib
+import json
+from pathlib import Path
+import struct
+import sys
+
+
+def require(condition, message):
+    if not condition:
+        raise ValueError(message)
+
+
+class PE:
+    def __init__(self, path):
+        self.path = Path(path)
+        self.data = self.path.read_bytes()
+        require(self.data[:2] == b"MZ", "Missing DOS header")
+        start = self.u32(0x3C)
+        require(self.data[start:start + 4] == b"PE\0\0", "Missing PE signature")
+        self.machine = self.u16(start + 4)
+        count = self.u16(start + 6)
+        self.characteristics = self.u16(start + 22)
+        self.optional = start + 24
+        require(self.u16(self.optional) == 0x10B, "Expected PE32")
+        self.sections = []
+        table = self.optional + self.u16(start + 20)
+        for index in range(count):
+            row = table + index * 40
+            virtual_size, rva, size, raw = struct.unpack_from("<IIII", self.data, row + 8)
+            self.sections.append((rva, max(virtual_size, size), raw, size))
+
+    def u16(self, offset):
+        return struct.unpack_from("<H", self.data, offset)[0]
+
+    def u32(self, offset):
+        return struct.unpack_from("<I", self.data, offset)[0]
+
+    def offset(self, rva):
+        for start, span, raw, size in self.sections:
+            if start <= rva < start + span:
+                require(rva - start < size, "RVA has no raw file data")
+                return raw + rva - start
+        raise ValueError(f"Unmapped RVA: {rva:#x}")
+
+    def imports(self):
+        directory = self.u32(self.optional + 96 + 8)
+        if not directory:
+            return []
+        row = self.offset(directory)
+        result = []
+        while any(struct.unpack_from("<IIIII", self.data, row)):
+            name = self.offset(self.u32(row + 12))
+            end = self.data.index(0, name)
+            result.append(self.data[name:end].decode("ascii"))
+            row += 20
+        return sorted(result, key=str.lower)
+
+    def resource(self, type_id, resource_id):
+        base = self.offset(self.u32(self.optional + 96 + 16))
+
+        def entries(relative):
+            head = base + relative
+            total = self.u16(head + 12) + self.u16(head + 14)
+            return [struct.unpack_from("<II", self.data, head + 16 + i * 8) for i in range(total)]
+
+        directory = 0
+        for expected in (type_id, resource_id):
+            candidates = [value for name, value in entries(directory) if name == expected]
+            require(len(candidates) == 1, f"Resource ID {expected} missing or ambiguous")
+            require(candidates[0] & 0x80000000, "Expected resource directory")
+            directory = candidates[0] & 0x7FFFFFFF
+        languages = entries(directory)
+        require(len(languages) == 1, "Expected one embedded worker language")
+        leaf = languages[0][1]
+        require(not leaf & 0x80000000, "Expected resource data entry")
+        rva, size = struct.unpack_from("<II", self.data, base + leaf)
+        start = self.offset(rva)
+        return self.data[start:start + size]
+
+
+def main():
+    root = Path(__file__).resolve().parents[1]
+    asi = PE(sys.argv[1] if len(sys.argv) > 1 else root / "build/Release/NLBinder.asi")
+    helper = PE(root / "build/ReconnectHelper.exe")
+    require(asi.machine == helper.machine == 0x14C, "Expected both binaries to be x86")
+    require(asi.characteristics & 0x2000, "ASI must be a DLL")
+    require(not helper.characteristics & 0x2000, "Worker must be an executable")
+    require(asi.resource(10, 300) == helper.data, "Embedded helper differs from built helper")
+    setup = PE(root / "build/BrowserSetup.exe")
+    require(setup.machine == 0x14C and not setup.characteristics & 0x2000, "Installer must be x86 EXE")
+    require(asi.resource(10, 301) == setup.data, "Embedded browser installer differs")
+    require(b"asInvoker" in setup.resource(24, 1), "Browser installer must not request elevation")
+    imports = asi.imports()
+    require(not any(name.lower().startswith(("vcruntime", "msvcp", "ucrtbased")) for name in imports),
+            "Unexpected external C++ runtime dependency")
+    try:
+        display_path = asi.path.resolve().relative_to(root).as_posix()
+    except ValueError:
+        display_path = asi.path.name
+    result = {
+        "revision": "v0.1.1-r17",
+        "asi": display_path,
+        "bytes": len(asi.data),
+        "format": "PE32 x86 DLL",
+        "sha256": hashlib.sha256(asi.data).hexdigest(),
+        "imports": imports,
+        "embedded_helper_id": 300,
+        "embedded_helper_bytes": len(helper.data),
+        "helper_sha256": hashlib.sha256(helper.data).hexdigest(),
+        "embedded_helper_matches": True,
+        "embedded_browser_setup_id": 301,
+        "embedded_browser_setup_bytes": len(setup.data),
+        "embedded_browser_setup_sha256": hashlib.sha256(setup.data).hexdigest(),
+        "embedded_browser_setup_matches": True,
+        "browser_setup_as_invoker": True,
+    }
+    report = json.dumps(result, indent=2)
+    (root / "build/revision17-artifact.json").write_text(report + "\n", encoding="utf-8")
+    print(report)
+
+
+if __name__ == "__main__":
+    main()
