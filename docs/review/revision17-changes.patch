@@ -0,0 +1,40 @@
+"""Create the immutable browser-only download and its compiled SHA-256 manifest."""
+from pathlib import Path
+import hashlib,json,zipfile
+
+R=Path(__file__).resolve().parents[1]
+ASSET='NLBinder-Browser-cef156-r1.zip'
+def sha(path):
+    with path.open('rb') as f:return hashlib.file_digest(f,'sha256').hexdigest()
+def main():
+    runtime=json.loads((R/'build/revision16-browser-runtime.json').read_text())
+    source=R/'build/NLBinder/Browser'
+    archive=R/'dist'/ASSET
+    manifest=R/'res/browser-runtime.json'
+    if not archive.exists():
+        with zipfile.ZipFile(archive,'w',zipfile.ZIP_DEFLATED,compresslevel=6) as z:
+            for entry in runtime['files']:
+                path=source/entry['path'];assert sha(path)==entry['sha256']
+                info=zipfile.ZipInfo(entry['path'],date_time=(2026,11,3,0,0,0))
+                info.compress_type=zipfile.ZIP_DEFLATED;info.external_attr=0o100644<<16
+                z.writestr(info,path.read_bytes(),compress_type=zipfile.ZIP_DEFLATED,compresslevel=6)
+    with zipfile.ZipFile(archive) as z:
+        assert set(z.namelist())=={x['path'] for x in runtime['files']}
+        assert z.testzip() is None
+        for e in runtime['files']:assert hashlib.sha256(z.read(e['path'])).hexdigest()==e['sha256']
+    lock=dict(runtime,asset=ASSET,archive_bytes=archive.stat().st_size,archive_sha256=sha(archive),runtime_id='cef156-r1',
+      download_url='https://github.com/Kobiro57/PerkysBinderChangelog/releases/download/browser-cef156-r1/'+ASSET)
+    manifest.write_text(json.dumps(lock,indent=2)+'\n',encoding='utf-8')
+    header=['// Generated by tools/prepare_browser_autoinstall.py. Do not edit hashes manually.','#pragma once','#include <cstdint>',
+      'namespace keybinder::browser_setup {',
+      'inline constexpr wchar_t kRuntimeId[] = L"cef156-r1";',
+      'inline constexpr wchar_t kDownloadUrl[] = L"'+lock['download_url']+'";',
+      'inline constexpr char kArchiveSha256[] = "'+lock['archive_sha256']+'";',
+      'inline constexpr std::uint64_t kArchiveBytes = '+str(lock['archive_bytes'])+'ULL;',
+      'struct RuntimeFile { const char* name; std::uint64_t bytes; const char* sha256; };',
+      'inline constexpr RuntimeFile kRuntimeFiles[] = {']
+    for e in runtime['files']:header.append('    {"'+e['path']+'", '+str(e['bytes'])+'ULL, "'+e['sha256']+'"},')
+    header+=['};','} // namespace keybinder::browser_setup','']
+    (R/'include/BrowserRuntimeLock.h').write_text('\n'.join(header),encoding='utf-8')
+    print(json.dumps({k:lock[k] for k in ['asset','archive_bytes','archive_sha256','runtime_id']},indent=2))
+if __name__=='__main__':main()
diff --git a/tools/publish_revision17.py b/tools/publish_revision17.py
