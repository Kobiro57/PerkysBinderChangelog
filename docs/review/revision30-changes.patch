+
+def stage():
+    require(git('remote','get-url','origin').decode().strip().removesuffix('.git')==URL,'Wrong target repository')
+    require(git('rev-parse','HEAD').decode().strip()==PREVIOUS,'Publication must start on the known r29 commit')
