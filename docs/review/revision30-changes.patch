+set "NLBINDER_RESULT=%ERRORLEVEL%"
+goto finish
+:export
+"%NLBINDER_PYTHON%" tools\finalize_revision30.py
+set "NLBINDER_RESULT=%ERRORLEVEL%"
+goto finish
+:verifypublic
+"%NLBINDER_PYTHON%" tools\verify_revision30_public.py
+set "NLBINDER_RESULT=%ERRORLEVEL%"
+goto finish
+:failed
+set "NLBINDER_RESULT=2"
+:finish
+popd
+exit /b %NLBINDER_RESULT%
