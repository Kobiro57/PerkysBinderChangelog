+Dokumente/GTA San Andreas User Files/NLBinder/Waffenicons/<Waffe>/
+PNG-Dateien in den passenden Unterordner legen, z.B. Desert Eagle/mein-icon.png.
+Am einfachsten im Binder unter Mods / Waffenicons auf 'Waffenicons-Ordner öffnen'
+klicken: So wird auch ein verschobener Dokumente-Ordner, etwa unter OneDrive,
+korrekt geöffnet. Danach Waffenicons aktivieren und bei Bedarf neu einlesen.
+Mehrere PNGs pro Waffe sind möglich; ohne PNG bleibt das originale Waffenicon.
+Die Fist wird weiterhin unter Mods / Hud eingerichtet.
+'@ | Set-Content -LiteralPath (Join-Path $templateRoot 'LIESMICH.md') -Encoding utf8
+
+$buildInfo = @"
+NLBinder v.0.1.1 by KOBiRO – Überarbeitung 14
+Erstellt: $([System.TimeZoneInfo]::ConvertTimeBySystemTimeZoneId([DateTime]::UtcNow, 'W. Europe Standard Time').ToString('dd.MM.yyyy HH:mm:ss')) (Europe/Berlin)
+Datei: NLBinder.asi
+Format: Win32 Release, PE32/x86 DLL
+Größe: $($report.bytes) Bytes
+SHA256: $binaryHash
+Eingebetteter Reconnect-Helfer: Ressource 300, $($report.embedded_helper_bytes) Bytes
+Helfer-SHA256: $($report.helper_sha256)
+
+Verifikation:
+- Vollständige automatisierte Tests: Exitcode 0
+- Release-Build: Exitcode 0
+- ASI-Format, Windows-Imports und eingebetteter Helfer geprüft
+- Eingebetteter Reconnect-Helfer stimmt mit dem geprüften Helfer überein
+- Nativer Reconnect-Helfer: $($workerResult.checks) Prüfungen, 0 Fehler
+- Dafür ausschließlich harmlose Testprozesse verwendet
+- Die Helferprüfung startet/beendet kein echtes Spiel und keinen installierten Launcher
+- Live-Ursachendiagnose mit r14 belegt
+- Neue r15-ASI im Spiel bestätigt: Explosionstod genau einmal, Friedhofs-Relog ohne Doppelzählung
+
+Neue Änderungen:
+- Friedhofs-Chat löst keine eigene Todeszählung mehr aus
+- Ein echter eigener Alive-zu-Dead-Übergang zählt einmal
+- Login/Relog übernimmt eine Basis ohne rückwirkenden Zusatz-Tod
+- Belegter nativer HP-Schutzaufschlag von 8.000.000 wird vor der Auswertung entfernt
+- Geschützte Todesübergänge werden mit einem neuen eigenen Server-Todesstand bestätigt
+- Höchstens zwei eigene Statistikabrufe pro Todesprüfung; keine Jobskills-Abfrage
+- Damagelog nutzt tatsächliche HP-/Westenverluste; kein zusätzlicher TakeDamage-Rohschaden
+- Übergelaufene 8-Bit-HP werden nicht als HP-Ersatz verwendet
+- Damagelog-Präfix bleibt {33CCFF}; vorhandene Hitsound-Filter bleiben getrennt
+- Manuelle Stats-/Jobskills-Synchronisation und sämtliche bisherigen Anpassungen bleiben enthalten
+- Kompilierte Datei heißt weiterhin NLBinder.asi
+- Gesamter Changelog liegt als CHANGELOG-GESAMT.txt bei
+
+Die früheren Job-, Skilltree-, Fraktions-, Radar-, Tacho- und Reconnect-
+Anpassungen sind enthalten. Die ursprüngliche Oberfläche bleibt Grundlage.
+Der Reconnect-Helfer ist in der ASI enthalten.
+
+Grenzen: Die Synchronisation wartet auf eine echte Serverantwort. Bei ausschließlich nativer
+Messung können mehrere Verluste zwischen Messungen als Gesamtverlust erscheinen.
+Explosionstod und anschließender Friedhofs-Relog sind mit dieser ASI im Spiel bestätigt.
+Beschuss und Fallschaden sind automatisiert geprüft; der installierte Launcher wurde nicht separat getestet.
+Installation und weitere Hinweise stehen in LIESMICH.md.
+"@
+$buildInfo | Set-Content -LiteralPath (Join-Path $packageDirectory 'BUILD-INFO.txt') -Encoding utf8
+"$binaryHash  NLBinder.asi" | Set-Content -LiteralPath (Join-Path $packageDirectory 'SHA256SUMS.txt') -Encoding ascii
+Compress-Archive -LiteralPath $packageDirectory -DestinationPath $archive -CompressionLevel Optimal
+
+Add-Type -AssemblyName System.IO.Compression.FileSystem
+$templateZip = [System.IO.Compression.ZipFile]::Open($archive, [System.IO.Compression.ZipArchiveMode]::Update)
+try {
+    foreach ($folderName in $weaponFolderNames) {
+        $entryName = 'NLBinder-0.1.1-r15/NLBinder/Waffenicons/' + $folderName + '/'
+        if (-not $templateZip.GetEntry($entryName)) { $null = $templateZip.CreateEntry($entryName) }
+    }
+} finally { $templateZip.Dispose() }
+$zip = [System.IO.Compression.ZipFile]::OpenRead($archive)
+try {
+    $entry = $zip.Entries | Where-Object { $_.FullName -match '/NLBinder\.asi$' }
+    if (@($entry).Count -ne 1) { throw 'ASI fehlt im Archiv oder ist mehrfach enthalten.' }
+    $stream = $entry.Open()
+    $digest = [System.Security.Cryptography.SHA256]::Create()
+    try {
+        $zippedHash = [BitConverter]::ToString($digest.ComputeHash($stream)).Replace('-', '').ToLowerInvariant()
+        if ($zippedHash -ne $binaryHash) { throw 'ASI-Prüfsumme im Archiv stimmt nicht.' }
+    } finally { $stream.Dispose(); $digest.Dispose() }
+} finally { $zip.Dispose() }
+$stagedHash = (Get-FileHash -LiteralPath (Join-Path $packageDirectory 'NLBinder.asi') -Algorithm SHA256).Hash.ToLowerInvariant()
+if ($stagedHash -ne $binaryHash) { throw 'Kopierte ASI stimmt nicht überein.' }
+Get-Item -LiteralPath (Join-Path $packageDirectory 'NLBinder.asi'), $archive | Select-Object FullName,Length
+Write-Output "SHA256: $binaryHash"
diff --git a/tools/verify_revision15_artifact.py b/tools/verify_revision15_artifact.py
new file mode 100644
index 0000000..7daaf37
--- /dev/null
+++ b/tools/verify_revision15_artifact.py
@@ -0,0 +1,115 @@
+"""Read-only r15 PE/artifact verification; never loads or executes binaries."""
+import hashlib
+import json
+from pathlib import Path
+import struct
+import sys
+
+
+def require(condition, message):
+    if not condition:
+        raise ValueError(message)
+
+
+class PE:
+    def __init__(self, path):
+        self.path = Path(path)
+        self.data = self.path.read_bytes()
+        require(self.data[:2] == b"MZ", "Missing DOS header")
+        start = self.u32(0x3C)
+        require(self.data[start:start + 4] == b"PE\0\0", "Missing PE signature")
+        self.machine = self.u16(start + 4)
+        count = self.u16(start + 6)
+        self.characteristics = self.u16(start + 22)
+        self.optional = start + 24
+        require(self.u16(self.optional) == 0x10B, "Expected PE32")
+        self.sections = []
+        table = self.optional + self.u16(start + 20)
+        for index in range(count):
+            row = table + index * 40
+            virtual_size, rva, size, raw = struct.unpack_from("<IIII", self.data, row + 8)
+            self.sections.append((rva, max(virtual_size, size), raw, size))
+
+    def u16(self, offset):
+        return struct.unpack_from("<H", self.data, offset)[0]
+
+    def u32(self, offset):
+        return struct.unpack_from("<I", self.data, offset)[0]
+
+    def offset(self, rva):
+        for start, span, raw, size in self.sections:
+            if start <= rva < start + span:
+                require(rva - start < size, "RVA has no raw file data")
+                return raw + rva - start
+        raise ValueError(f"Unmapped RVA: {rva:#x}")
+
+    def imports(self):
+        directory = self.u32(self.optional + 96 + 8)
+        if not directory:
+            return []
+        row = self.offset(directory)
+        result = []
+        while any(struct.unpack_from("<IIIII", self.data, row)):
+            name = self.offset(self.u32(row + 12))
+            end = self.data.index(0, name)
+            result.append(self.data[name:end].decode("ascii"))
+            row += 20
+        return sorted(result, key=str.lower)
+
+    def resource(self, type_id, resource_id):
+        base = self.offset(self.u32(self.optional + 96 + 16))
+
+        def entries(relative):
+            head = base + relative
+            total = self.u16(head + 12) + self.u16(head + 14)
+            return [struct.unpack_from("<II", self.data, head + 16 + i * 8) for i in range(total)]
+
+        directory = 0
+        for expected in (type_id, resource_id):
+            candidates = [value for name, value in entries(directory) if name == expected]
+            require(len(candidates) == 1, f"Resource ID {expected} missing or ambiguous")
+            require(candidates[0] & 0x80000000, "Expected resource directory")
+            directory = candidates[0] & 0x7FFFFFFF
+        languages = entries(directory)
+        require(len(languages) == 1, "Expected one embedded worker language")
+        leaf = languages[0][1]
+        require(not leaf & 0x80000000, "Expected resource data entry")
+        rva, size = struct.unpack_from("<II", self.data, base + leaf)
+        start = self.offset(rva)
+        return self.data[start:start + size]
+
+
+def main():
+    root = Path(__file__).resolve().parents[1]
+    asi = PE(sys.argv[1] if len(sys.argv) > 1 else root / "build/Release/NLBinder.asi")
+    helper = PE(root / "build/ReconnectHelper.exe")
+    require(asi.machine == helper.machine == 0x14C, "Expected both binaries to be x86")
+    require(asi.characteristics & 0x2000, "ASI must be a DLL")
+    require(not helper.characteristics & 0x2000, "Worker must be an executable")
+    require(asi.resource(10, 300) == helper.data, "Embedded helper differs from built helper")
+    imports = asi.imports()
+    require(not any(name.lower().startswith(("vcruntime", "msvcp", "ucrtbased")) for name in imports),
+            "Unexpected external C++ runtime dependency")
+    try:
+        display_path = asi.path.resolve().relative_to(root).as_posix()
+    except ValueError:
+        display_path = asi.path.name
+    result = {
+        "revision": "v0.1.1-r15",
+        "asi": display_path,
+        "bytes": len(asi.data),
+        "format": "PE32 x86 DLL",
+        "sha256": hashlib.sha256(asi.data).hexdigest(),
+        "imports": imports,
+        "embedded_helper_id": 300,
+        "embedded_helper_bytes": len(helper.data),
+        "helper_sha256": hashlib.sha256(helper.data).hexdigest(),
+        "embedded_helper_matches": True,
+    }
+    report = json.dumps(result, indent=2)
+    (root / "build/revision15-artifact.json").write_text(report + "\n", encoding="utf-8")
+    print(report)
+
+
+if __name__ == "__main__":
+    main()
