+
+    for (const char* drug : {"Kokain", "Heroin", "Speed", "Ecstasy", "Cannabis", "Adrenalin", "Morphium", "Ectasy"}) {
+        Tracker prefixed, plain;
+        const std::string action = std::string("Local_Player nimmt ") + drug + " zu sich.";
