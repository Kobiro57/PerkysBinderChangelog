+    return fields['password']
+
+def api(token,url,method='GET',data=None,content_type='application/json'):
+    require(url.startswith(('https://api.github.com/','https://uploads.github.com/repos/Kobiro57/PerkysBinderChangelog/')),'Unexpected API host')
+    body=json.dumps(data).encode() if data is not None and content_type=='application/json' else data
+    req=urllib.request.Request(url,data=body,method=method,headers={'Authorization':'Bearer '+token,
+      'Accept':'application/vnd.github+json','X-GitHub-Api-Version':'2022-11-28','User-Agent':'NLBinder-authorized-r20-publication','Content-Type':content_type})
+    try:
+        with urllib.request.urlopen(req,timeout=600) as response:return json.load(response)
+    except urllib.error.HTTPError as e:
+        raise RuntimeError('GitHub API status '+str(e.code)+' for '+url.split('?')[0]) from None
+
+def publish():
+    proof=json.loads((ROOT/'build/revision20-package.json').read_text())
+    prepared=json.loads((ROOT/'build/revision20-publication-ready.json').read_text())
+    token=credential()
+    user=api(token,'https://api.github.com/user')
+    require(user['login'].casefold()=='kobiro57','Wrong GitHub account')
+    head=git('rev-parse','HEAD').decode().strip()
+    if head==PREVIOUS:
+        require(git('write-tree').decode().strip()==prepared['staged_tree'],'Staged source changed after review')
+        verify_index()
+        email=str(user['id'])+'+'+user['login']+'@users.noreply.github.com'
+        git('-c','user.name='+user['login'],'-c','user.email='+email,'commit','-m',
+          'v0.1.2: restore perkys credits and publish forum installer source and file disclosure')
+        head=git('rev-parse','HEAD').decode().strip()
+    require(git('rev-parse','HEAD^').decode().strip()==PREVIOUS,'Unexpected parent commit')
+    require(not git('status','--porcelain'),'Publication checkout not clean')
+    tag_exists=subprocess.run(['git','rev-parse','--verify','refs/tags/'+TAG],cwd=REPO,stdout=subprocess.PIPE,stderr=subprocess.PIPE).returncode==0
+    if not tag_exists:git('tag',TAG,head)
+    require(git('rev-parse',TAG+'^{commit}').decode().strip()==head,'Release tag points elsewhere')
+    git('push','--atomic','origin','HEAD:main','refs/tags/'+TAG)
+    require(api(token,API+'/commits/main')['sha']==head,'Remote main commit differs')
+    releases=api(token,API+'/releases?per_page=100')
+    release=next((r for r in releases if r['tag_name']==TAG),None)
+    body=(ROOT/'docs/FORUM-CHANGELOG-v0.1.2.txt').read_text(encoding='utf-8-sig')
+    body+='\nASI SHA-256: `'+proof['asi_sha256']+'`\n\nZIP SHA-256: `'+proof['archive_sha256']+'`\n'
+    if release is None:release=api(token,API+'/releases','POST',{'tag_name':TAG,'target_commitish':head,'name':'NLBinder v0.1.2 by perkys & edited by KOBiRO – r20','body':body,'draft':False,'prerelease':False})
+    archive=ROOT/'dist'/proof['archive']
+    require(filehash(archive)==proof['archive_sha256'],'Release ZIP changed')
+    assets=api(token,API+'/releases/'+str(release['id'])+'/assets')
+    asset=next((a for a in assets if a['name']==archive.name),None)
+    if asset is None:
+        upload='https://uploads.github.com/repos/Kobiro57/PerkysBinderChangelog/releases/'+str(release['id'])+'/assets?name='+archive.name
+        asset=api(token,upload,'POST',archive.read_bytes(),'application/zip')
+    require(asset['state']=='uploaded' and asset['size']==archive.stat().st_size,'Release asset incomplete')
+    remote_digest=asset.get('digest')
+    require(remote_digest=='sha256:'+proof['archive_sha256'],'GitHub release asset digest differs')
+    result={'published':True,'repository':URL,'commit':head,'commit_url':URL+'/commit/'+head,
+      'tag':TAG,'release_url':release['html_url'],'download_url':asset['browser_download_url'],
+      'asset_bytes':asset['size'],'asset_sha256_verified':True,'asi_sha256':proof['asi_sha256']}
+    (ROOT/'build/revision20-published.json').write_text(json.dumps(result,indent=2)+'\n')
+    print(json.dumps(result,indent=2))
+
+if __name__=='__main__':
+    parser=argparse.ArgumentParser(description=__doc__)
+    modes=parser.add_mutually_exclusive_group(required=True)
+    modes.add_argument('--prepare',action='store_true');modes.add_argument('--publish',action='store_true')
+    args=parser.parse_args()
+    if args.prepare:stage()
+    else:publish()
diff --git a/tools/report_revision20_log.py b/tools/report_revision20_log.py
new file mode 100644
index 0000000..79582f0
--- /dev/null
+++ b/tools/report_revision20_log.py
@@ -0,0 +1,10 @@
+"""Show a compact result from the fixed r20 log paths."""
+from pathlib import Path
+import sys
+root=Path(__file__).resolve().parents[1]
+mode=sys.argv[1]
+if mode not in {'tests','build'}:raise ValueError('Unexpected log kind')
+lines=(root/('build/revision20-'+mode+'.log')).read_text(encoding='utf-8-sig',errors='replace').splitlines()
+important=[line for line in lines if '[FAIL]' in line or 'error ' in line.lower() or 'DrugUseTrackerTests:' in line
+           or 'Online Settings:' in line or 'OnlineOverlayRendererTests:' in line or 'Test exit code:' in line]
+for line in (important if mode=='tests' else lines[-10:]):print(line)
diff --git a/tools/run_revision20.bat b/tools/run_revision20.bat
new file mode 100644
index 0000000..a803804
--- /dev/null
+++ b/tools/run_revision20.bat
@@ -0,0 +1,74 @@
+@echo off
+setlocal
+pushd "%~dp0.." || exit /b 2
+if not exist build mkdir build
+if not defined NLBINDER_PYTHON set "NLBINDER_PYTHON=%USERPROFILE%\.cache\codex-runtimes\codex-primary-runtime\dependencies\python\python.exe"
+if /i "%~1"=="tests" goto tests
+if /i "%~1"=="build" goto build
+if /i "%~1"=="worker" goto worker
+if /i "%~1"=="document" goto document
+if /i "%~1"=="package" goto package
+if /i "%~1"=="prepare-publication" goto preparepublication
+if /i "%~1"=="publish" goto publish
+if /i "%~1"=="verify-public" goto verifypublic
+if /i "%~1"=="export" goto export
+if /i "%~1"=="install" goto install
+set "NLBINDER_RESULT=2"
+goto finish
+:tests
+call tools\run_tests.bat > build\revision20-tests.log 2>&1
+set "NLBINDER_RESULT=%ERRORLEVEL%"
+"%NLBINDER_PYTHON%" tools\report_revision20_log.py tests
+goto finish
+:build
+call tools\build_release.bat > build\revision20-build.log 2>&1
+set "NLBINDER_RESULT=%ERRORLEVEL%"
+>>build\revision20-build.log echo RELEASE_BUILD_EXIT_CODE=%NLBINDER_RESULT%
+"%NLBINDER_PYTHON%" tools\report_revision20_log.py build
+goto finish
+:worker
+"%NLBINDER_PYTHON%" tools\test_reconnect_worker.py > build\revision20-reconnect.log 2>&1
+set "NLBINDER_RESULT=%ERRORLEVEL%"
+type build\revision20-reconnect.log
+goto finish
+:document
+"%NLBINDER_PYTHON%" tools\document_revision20.py
+if errorlevel 1 goto failed
+"%NLBINDER_PYTHON%" tools\export_full_changelog.py
+set "NLBINDER_RESULT=%ERRORLEVEL%"
+goto finish
+:package
+"%NLBINDER_PYTHON%" tools\verify_revision20_artifact.py
+if errorlevel 1 goto failed
+"%NLBINDER_PYTHON%" tools\document_revision20.py
+if errorlevel 1 goto failed
+"%NLBINDER_PYTHON%" tools\export_full_changelog.py
+if errorlevel 1 goto failed
+"%NLBINDER_PYTHON%" tools\package_revision20.py
+set "NLBINDER_RESULT=%ERRORLEVEL%"
+goto finish
+:preparepublication
+"%NLBINDER_PYTHON%" tools\publish_revision20.py --prepare
+set "NLBINDER_RESULT=%ERRORLEVEL%"
+goto finish
+:publish
+"%NLBINDER_PYTHON%" tools\publish_revision20.py --publish
+set "NLBINDER_RESULT=%ERRORLEVEL%"
+goto finish
+:export
+"%NLBINDER_PYTHON%" tools\finalize_revision20.py
+set "NLBINDER_RESULT=%ERRORLEVEL%"
+goto finish
+:verifypublic
+"%NLBINDER_PYTHON%" tools\verify_revision20_public.py
+set "NLBINDER_RESULT=%ERRORLEVEL%"
+goto finish
+:install
+"%NLBINDER_PYTHON%" tools\install_revision20.py
+set "NLBINDER_RESULT=%ERRORLEVEL%"
+goto finish
+:failed
+set "NLBINDER_RESULT=2"
+:finish
+popd
+exit /b %NLBINDER_RESULT%
diff --git a/tools/verify_revision20_artifact.py b/tools/verify_revision20_artifact.py
new file mode 100644
index 0000000..fb62629
--- /dev/null
+++ b/tools/verify_revision20_artifact.py
@@ -0,0 +1,58 @@
+"""Verify the r20 PE and embedded helpers without loading executable code."""
+import hashlib,json
+from pathlib import Path
+import sys
+from verify_revision18_artifact import PE, require
+
+def main():
+    root = Path(__file__).resolve().parents[1]
+    asi = PE(sys.argv[1] if len(sys.argv) > 1 else root / "build/Release/NLBinder.asi")
+    helper = PE(root / "build/ReconnectHelper.exe")
+    require(asi.machine == helper.machine == 0x14C, "Expected both binaries to be x86")
+    require(asi.characteristics & 0x2000, "ASI must be a DLL")
+    require(not helper.characteristics & 0x2000, "Worker must be an executable")
+    require(asi.resource(10, 300) == helper.data, "Embedded helper differs from built helper")
+    setup = PE(root / "build/BrowserSetup.exe")
+    require(setup.machine == 0x14C and not setup.characteristics & 0x2000, "Installer must be x86 EXE")
+    require(asi.resource(10, 301) == setup.data, "Embedded browser installer differs")
+    require(b"asInvoker" in setup.resource(24, 1), "Browser installer must not request elevation")
+    require(asi.resource(10, 302) == (root / "third_party/miniz/LICENSE").read_bytes(), "Missing embedded miniz notice")
+    imports = asi.imports()
+    require("libcef.dll" not in [name.lower() for name in imports], "Chromium must remain out of the game process")
+    require(not any(name.lower().startswith(("vcruntime", "msvcp", "ucrtbased")) for name in imports),
+            "Unexpected external C++ runtime dependency")
+    startup = (b"{33CCFF}[NLBinder]{FFFFFF} NLBinder v.0.1.2 by perkys & edited by KOBiRO "
+               b"wurde {00CC00}erfolgreich{FFFFFF} gestartet!")
+    require(startup in asi.data, "The requested v0.1.2 startup message is missing from the ASI")
+    require(b"NLBinder v.0.1.2 by perkys & edited by KOBiRO" in asi.data,
+            "The matching version/credit caption is missing")
+    try:
+        display_path = asi.path.resolve().relative_to(root).as_posix()
+    except ValueError:
+        display_path = asi.path.name
+    result = {
+        "revision": "v0.1.2-r20",
+        "asi": display_path,
+        "bytes": len(asi.data),
+        "format": "PE32 x86 DLL",
+        "sha256": hashlib.sha256(asi.data).hexdigest(),
+        "imports": imports,
+        "requested_startup_message_present": True,
+        "version_and_credit": "NLBinder v.0.1.2 by perkys & edited by KOBiRO",
+        "embedded_helper_id": 300,
+        "embedded_helper_bytes": len(helper.data),
+        "helper_sha256": hashlib.sha256(helper.data).hexdigest(),
+        "embedded_helper_matches": True,
+        "embedded_browser_setup_id": 301,
+        "embedded_browser_setup_bytes": len(setup.data),
+        "embedded_browser_setup_sha256": hashlib.sha256(setup.data).hexdigest(),
+        "embedded_browser_setup_matches": True,
+        "browser_setup_as_invoker": True,
+    }
+    report = json.dumps(result, indent=2)
+    (root / "build/revision20-artifact.json").write_text(report + "\n", encoding="utf-8")
+    print(report)
+
+
+if __name__ == "__main__":
+    main()
diff --git a/tools/verify_revision20_public.py b/tools/verify_revision20_public.py
new file mode 100644
index 0000000..4eecc2d
--- /dev/null
+++ b/tools/verify_revision20_public.py
@@ -0,0 +1,35 @@
+"""Verify the published r20 viewer and release metadata without using a credential."""
+from pathlib import Path
+import json,posixpath,re,urllib.request
+R=Path(__file__).resolve().parents[1]
+BASE='https://api.github.com/repos/Kobiro57/PerkysBinderChangelog'
+
+def get(path):
+    request=urllib.request.Request(BASE+path,headers={'User-Agent':'NLBinder-r20-anonymous-verification',
+        'Accept':'application/vnd.github+json'})
+    with urllib.request.urlopen(request,timeout=45) as response:return json.load(response)
+
+def require(ok,message):
+    if not ok:raise ValueError(message)
+
+def main():
+    publication=json.loads((R/'build/revision20-published.json').read_text(encoding='utf-8'))
+    proof=json.loads((R/'build/revision20-package.json').read_text(encoding='utf-8'))
+    require(get('')['private'] is False,'Repository is not anonymously readable')
+    require(get('/commits/main')['sha']==publication['commit'],'Remote main differs')
+    release=get('/releases/tags/v0.1.2-r20')
+    asset=next(a for a in release['assets'] if a['name']==proof['archive'])
+    require(asset['digest']=='sha256:'+proof['archive_sha256'] and asset['size']==proof['archive_bytes'],
+            'Release asset digest or size differs')
+    repository=R/'build/github-publication/repository'
+    for name in ['README.md','docs/NLBinder-0.1.2-r20-DE.md','docs/review/r20-PRUEFUNG-DE.md','docs/FORUM-INSTALLATION-DE.md']:
+        for href in re.findall(r'\]\(([^)]+)\)',(repository/name).read_text(encoding='utf-8-sig')):
+            if href.startswith(('http:','https:','#')):continue
+            path=posixpath.normpath(posixpath.join(posixpath.dirname(name),href.split('#')[0]))
+            require((repository/path).exists(),'Broken review link: '+name+' -> '+href)
+    result={'anonymous_viewer_access':True,'main_commit_verified':True,'release_asset_sha256_verified':True,
+        'review_document_links_verified':True,'release_url':release['html_url']}
+    (R/'build/revision20-public-access.json').write_text(json.dumps(result,indent=2)+'\n',encoding='utf-8')
+    print(json.dumps(result,indent=2))
+
+if __name__=='__main__':main()
