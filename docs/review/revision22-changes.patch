+struct ClaimDrawContext {
+    ImGuiContext* previous = ImGui::GetCurrentContext();
+    ImGuiContext* context = ImGui::CreateContext();
+    ClaimDrawContext() {
+        ImGuiIO& io = ImGui::GetIO();
+        io.DisplaySize = ImVec2(1000,1000);
