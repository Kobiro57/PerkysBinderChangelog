diff --git a/tests/StatsDialogRPCAdapterTests.cpp b/tests/StatsDialogRPCAdapterTests.cpp
new file mode 100644
index 0000000..25ff9c5
--- /dev/null
+++ b/tests/StatsDialogRPCAdapterTests.cpp
@@ -0,0 +1,114 @@
+#include "../include/StatsDialogRPCAdapter.h"
+#include "../include/RakHook/include/RakNet/BitStream.h"
+#include "../include/RakHook/include/RakNet/StringCompressor.h"
+
+#include <cstdio>
+#include <string>
+#include <vector>
+
+namespace {
+int checks = 0, failures = 0;
+#define CHECK(value) do { ++checks; if (!(value)) { ++failures; std::printf("[FAIL] StatsDialogRPC: %s (line %d)\n", #value, __LINE__); return; } } while (0)
+
+void WriteByteString(RakNet::BitStream& payload, const std::string& text) {
+    payload.Write(static_cast<unsigned char>(text.size()));
+    if (!text.empty()) payload.Write(text.data(), static_cast<int>(text.size()));
+}
+
+void WriteDialog(RakNet::BitStream& payload, unsigned char style, const std::string& caption,
+                 const std::string& body, unsigned short id = 104) {
+    payload.Write(id);
+    payload.Write(style);
+    WriteByteString(payload, caption);
+    WriteByteString(payload, "Schliessen");
+    WriteByteString(payload, "");
+    StringCompressor::Instance()->EncodeString(body.c_str(), 0, &payload);
+}
+
+void TestAllReadOnlyDialogStylesDeliverFullCompressedTextAndPreserveOffset() {
+    keybinder::StatsDialogRPCAdapter adapter;
+    std::vector<keybinder::StatsDialogEvent> events;
+    adapter.SetDialogCallback([&](const auto& event) { events.push_back(event); });
+    CHECK(adapter.Initialize());
+    const std::string body = "Wert\tStand\nKills\t123\nTode\t45\nBargeld\t1.234$\nKontostand\t5.678$\n" + std::string(6000, 'a');
+    for (unsigned char style : {0, 2, 4, 5}) {
+        RakNet::BitStream payload;
+        payload.Write(true); payload.Write(false); payload.Write(true);
+        const int start = payload.GetNumberOfBitsUsed();
+        WriteDialog(payload, style, "{FFFFFF}Statistik von Fixture_Player", body);
+        payload.SetReadOffset(start);
+        CHECK(adapter.ProcessRpcForTesting(61, &payload));
+        CHECK(payload.GetReadOffset() == start);
+        CHECK(events.back().id == 104 && events.back().style == style);
+        CHECK(events.back().caption == "{FFFFFF}Statistik von Fixture_Player");
+        CHECK(events.back().text == body);
+    }
+    CHECK(events.size() == 4);
+    adapter.Shutdown();
+}
+
+void TestMalformedTruncatedAndInputPayloadsDoNotDeliverOrConsume() {
+    keybinder::StatsDialogRPCAdapter adapter;
+    int delivered = 0;
+    adapter.SetDialogCallback([&](const auto&) { ++delivered; });
+    CHECK(adapter.Initialize());
+    CHECK(!adapter.ProcessRpcForTesting(61, nullptr));
+    RakNet::BitStream complete;
+    WriteDialog(complete, 4, "Statistik", "Kills\t12\nTode\t4");
+    const int completeBits = complete.GetNumberOfBitsUsed();
+    for (int bits = 0; bits < completeBits; ++bits) {
+        RakNet::BitStream truncated(complete.GetData(), complete.GetNumberOfBytesUsed(), true);
+        truncated.SetWriteOffset(bits);
+        CHECK(!adapter.ProcessRpcForTesting(61, &truncated));
+        CHECK(truncated.GetReadOffset() == 0);
+    }
+    for (unsigned char style : {1, 3, 6, 255}) {
+        RakNet::BitStream payload;
+        WriteDialog(payload, style, "Statistik", "Kills: [12]");
+        CHECK(!adapter.ProcessRpcForTesting(61, &payload));
+        CHECK(payload.GetReadOffset() == 0);
+    }
+    CHECK(!adapter.ProcessRpcForTesting(93, &complete));
+    CHECK(complete.GetReadOffset() == 0 && delivered == 0);
+    RakNet::BitStream closeDialog;
+    WriteDialog(closeDialog, 0, "", "", 0xFFFF);
+    CHECK(!adapter.ProcessRpcForTesting(61, &closeDialog));
+    CHECK(closeDialog.GetReadOffset() == 0);
+    RakNet::BitStream embeddedNull;
+    WriteDialog(embeddedNull, 0, std::string("Stats\0foreign", 13), "Kills: [12]");
+    CHECK(!adapter.ProcessRpcForTesting(61, &embeddedNull));
+    CHECK(delivered == 0);
+}
+
+void TestLifecycleNeverDeliversAfterShutdownAndSupportsReinitialize() {
+    keybinder::StatsDialogRPCAdapter adapter;
+    int delivered = 0;
+    adapter.SetDialogCallback([&](const auto&) { ++delivered; });
+    RakNet::BitStream noPayload;
+    CHECK(!adapter.ProcessRpcForTesting(61, &noPayload));
+    CHECK(adapter.Initialize());
+    CHECK(adapter.Initialize());
+    RakNet::BitStream payload;
+    WriteDialog(payload, 0, "Stats", "Kills: [12]");
+    CHECK(adapter.ProcessRpcForTesting(61, &payload));
+    CHECK(delivered == 1);
+    adapter.Shutdown();
+    CHECK(!adapter.ProcessRpcForTesting(61, &payload));
+    CHECK(delivered == 1 && payload.GetReadOffset() == 0);
+    adapter.Shutdown();
+    adapter.SetDialogCallback([&](const auto&) { delivered += 10; });
+    CHECK(adapter.Initialize());
+    CHECK(adapter.ProcessRpcForTesting(61, &payload));
+    CHECK(delivered == 11);
+    adapter.Shutdown();
+}
+} // namespace
+
+int RunStatsDialogRPCAdapterTests() {
+    checks = failures = 0;
+    TestAllReadOnlyDialogStylesDeliverFullCompressedTextAndPreserveOffset();
+    TestMalformedTruncatedAndInputPayloadsDoNotDeliverOrConsume();
+    TestLifecycleNeverDeliversAfterShutdownAndSupportsReinitialize();
+    std::printf("StatsDialogRPCAdapterTests: %d checks, %d failures\n", checks, failures);
+    return failures;
+}
diff --git a/tools/package_revision5.ps1 b/tools/package_revision5.ps1
new file mode 100644
index 0000000..80f7e4c
--- /dev/null
+++ b/tools/package_revision5.ps1
@@ -0,0 +1,96 @@
+$ErrorActionPreference = 'Stop'
+$projectRoot = Split-Path -Parent $PSScriptRoot
+$binary = Join-Path $projectRoot 'build\Release\Keybinder.asi'
+$reportPath = Join-Path $projectRoot 'build\revision5-artifact.json'
+$report = Get-Content -LiteralPath $reportPath -Raw | ConvertFrom-Json
+$binaryHash = (Get-FileHash -LiteralPath $binary -Algorithm SHA256).Hash.ToLowerInvariant()
+if ($report.revision -ne 'v0.1.1-r5' -or $binaryHash -ne $report.sha256 -or -not $report.embedded_helper_matches) {
+    throw 'Die ASI stimmt nicht mit dem finalen r5-Prüfbericht überein.'
+}
+$helperPath = Join-Path $projectRoot 'build\ReconnectHelper.exe'
+$helperHash = (Get-FileHash -LiteralPath $helperPath -Algorithm SHA256).Hash.ToLowerInvariant()
+if ($helperHash -ne $report.helper_sha256) { throw 'Der Reconnect-Helfer hat sich seit der Artefaktprüfung geändert.' }
+$workerPath = Join-Path $projectRoot 'build\reconnect-worker-tests\result.json'
+$workerResult = Get-Content -LiteralPath $workerPath -Raw | ConvertFrom-Json
+if ($workerResult.failures -ne 0 -or $workerResult.checks -lt 18) { throw 'Reconnect-Helfertest fehlgeschlagen oder unvollständig.' }
+if ((Get-Item -LiteralPath $workerPath).LastWriteTimeUtc -lt (Get-Item -LiteralPath $helperPath).LastWriteTimeUtc) {
+    throw 'Den nativen Helfertest nach dem letzten Helfer-Build erneut ausführen.'
+}
+$testLog = Get-Content -LiteralPath (Join-Path $projectRoot 'build\revision5-tests.log') -Raw
+if ($testLog -notmatch '(?m)^Test exit code: 0\s*$' -or $testLog -match '\[FAIL\]') { throw 'Gesamttests nicht erfolgreich.' }
+$buildLog = Get-Content -LiteralPath (Join-Path $projectRoot 'build\revision5-build.log') -Raw
+if ($buildLog -notmatch '(?m)^RELEASE_BUILD_EXIT_CODE=0\s*$' -or $buildLog -notmatch 'Keybinder\.vcxproj -> .*Keybinder\.asi' -or $buildLog -match ': (fatal )?error [A-Z]+\d+:') {
+    throw 'Erfolgreicher finaler Release-Build nicht bestätigt.'
+}
+
+$packageDirectory = Join-Path $projectRoot 'dist\NLBinder-0.1.1-r5'
+$archive = Join-Path $projectRoot 'dist\NLBinder-v0.1.1-KOBiRO-r5.zip'
+if ((Test-Path -LiteralPath $packageDirectory) -or (Test-Path -LiteralPath $archive)) {
+    throw 'r5-Paket existiert bereits; nicht automatisch überschreiben.'
+}
+New-Item -ItemType Directory -Path $packageDirectory | Out-Null
+Copy-Item -LiteralPath $binary -Destination (Join-Path $packageDirectory 'Keybinder.asi')
+Copy-Item -LiteralPath (Join-Path $projectRoot 'docs\NLBinder-0.1.1-r5-DE.md') -Destination (Join-Path $packageDirectory 'LIESMICH.md')
+Copy-Item -LiteralPath (Join-Path $projectRoot 'docs\jobs-support.md') -Destination (Join-Path $packageDirectory 'JOB-HINWEISE.md')
+Copy-Item -LiteralPath $reportPath -Destination (Join-Path $packageDirectory 'PRUEFBERICHT.json')
+Copy-Item -LiteralPath $workerPath -Destination (Join-Path $packageDirectory 'RECONNECT-TEST.json')
+
+$buildInfo = @"
+NLBinder v.0.1.1 by KOBiRO – Überarbeitung 5
+Erstellt: $([System.TimeZoneInfo]::ConvertTimeBySystemTimeZoneId([DateTime]::UtcNow, 'W. Europe Standard Time').ToString('dd.MM.yyyy HH:mm:ss')) (Europe/Berlin)
+Datei: Keybinder.asi
+Format: Win32 Release, PE32/x86 DLL
+Größe: $($report.bytes) Bytes
+SHA256: $binaryHash
+Eingebetteter Reconnect-Helfer: Ressource 300, $($report.embedded_helper_bytes) Bytes
+Helfer-SHA256: $($report.helper_sha256)
+
+Verifikation:
+- Vollständige automatisierte Tests: Exitcode 0
+- Release-Build: Exitcode 0
+- ASI-Format, Windows-Imports und eingebetteter Helfer geprüft
+- Eingebetteter Reconnect-Helfer stimmt mit dem geprüften Helfer überein
+- Nativer Reconnect-Helfer: $($workerResult.checks) Prüfungen, 0 Fehler
+- Dafür ausschließlich harmlose Testprozesse verwendet
+- Kein echtes Spiel und kein installierter Launcher gestartet oder beendet
+- Kein Ingame-Test durchgeführt
+
+Neue Änderungen:
+- Genau ein Motor-Tastendruck pro Fahrer-Einstieg, ohne Wiederholungen
+- Bereits laufende oder später manuell gestoppte Motoren bleiben unbeeinflusst
+- Statistikantwort direkt als vollständiger RPC-61-Text erfasst
+- Statistik-Messagebox, Listen und Tabellen werden ausgelesen
+- Kills und Tode genügen für die Übernahme; weitere gelieferte Werte optional
+- Eigene Startstatistik wird nach Übernahme im selben Update geschlossen
+- Nach einem Timeout kann ein eigener manueller /stats-Aufruf nachsynchronisieren
+- Spätere manuelle Statistiken bleiben für den Spieler geöffnet
+
+Die früheren Job-, Skilltree-, Fraktions-, Radar-, Tacho- und Reconnect-
+Anpassungen sind enthalten. Die ursprüngliche Oberfläche bleibt Grundlage.
+Der Reconnect-Helfer ist in der ASI enthalten.
+
+Grenzen: Die Synchronisation wartet auf eine echte Serverantwort. Mehrere
+Schadensereignisse zwischen Messungen erscheinen als gemessener Gesamtverlust.
+Ein Live-Test mit dem konkreten Server und Launcher steht weiterhin aus.
+Installation und weitere Hinweise stehen in LIESMICH.md.
+"@
+$buildInfo | Set-Content -LiteralPath (Join-Path $packageDirectory 'BUILD-INFO.txt') -Encoding utf8
+"$binaryHash  Keybinder.asi" | Set-Content -LiteralPath (Join-Path $packageDirectory 'SHA256SUMS.txt') -Encoding ascii
+Compress-Archive -LiteralPath $packageDirectory -DestinationPath $archive -CompressionLevel Optimal
+
+Add-Type -AssemblyName System.IO.Compression.FileSystem
+$zip = [System.IO.Compression.ZipFile]::OpenRead($archive)
+try {
+    $entry = $zip.Entries | Where-Object { $_.FullName -match '/Keybinder\.asi$' }
+    if (@($entry).Count -ne 1) { throw 'ASI fehlt im Archiv oder ist mehrfach enthalten.' }
+    $stream = $entry.Open()
+    $digest = [System.Security.Cryptography.SHA256]::Create()
+    try {
+        $zippedHash = [BitConverter]::ToString($digest.ComputeHash($stream)).Replace('-', '').ToLowerInvariant()
+        if ($zippedHash -ne $binaryHash) { throw 'ASI-Prüfsumme im Archiv stimmt nicht.' }
+    } finally { $stream.Dispose(); $digest.Dispose() }
+} finally { $zip.Dispose() }
+$stagedHash = (Get-FileHash -LiteralPath (Join-Path $packageDirectory 'Keybinder.asi') -Algorithm SHA256).Hash.ToLowerInvariant()
+if ($stagedHash -ne $binaryHash) { throw 'Kopierte ASI stimmt nicht überein.' }
+Get-Item -LiteralPath (Join-Path $packageDirectory 'Keybinder.asi'), $archive | Select-Object FullName,Length
+Write-Output "SHA256: $binaryHash"
